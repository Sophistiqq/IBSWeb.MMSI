{
  "manifest_version": 3,
  "name": "Guided Hands (Local Automation)",
  "version": "1.0.0",
  "description": "Zero-prompt local browser worker for Guided Hands + Ollama form automation on localhost.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guided Hands Local Worker"
  }
}
