      "waitAfterMs": 2500,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "target": "Done",
      "scope": ".swal2-popup",
      "optional": true,
      "waitForPopupMs": 1500,
      "waitAfterMs": 500
