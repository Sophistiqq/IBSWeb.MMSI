{
  "name": "cos/cancel-service",
  "description": "OPERATIONS cancels an unrecorded expected service entry on COS {cosId} with a reason.",
  "url": "/MSAP/COS/Details/{cosId}",
  "vars": {
    "opsAccount": "OPERATIONS",
    "cancelReason": "Service no longer required ({today}-{rand})."
  },
  "steps": [
    { "action": "login", "account": "{opsAccount}" },
    { "action": "navigate", "url": "/MSAP/COS/Details/{cosId}" },
    { "action": "click", "selector": "tr.ui-attention .dropdown-trigger", "waitAfterMs": 350 },
    { "action": "click", "selector": "tr.ui-attention button[data-cancel-service]", "waitAfterMs": 800 },
    {
      "action": "fill_form",
      "scope": ".swal2-popup",
      "onlyEmpty": true,
      "overrides": {
        "swal2-input": "{cancelReason}"
      },
      "scenario": "Enter a concise reason for cancelling this expected service."
    },
    { "action": "click", "target": "Cancel service", "scope": ".swal2-popup", "waitForPopupMs": 3000, "waitAfterMs": 2200, "waitForNavigation": true },
    { "action": "click", "target": "Done", "scope": ".swal2-popup", "optional": true, "waitForPopupMs": 1500, "waitAfterMs": 500 },
    { "action": "assert", "urlIncludes": "/MSAP/COS/Details/{cosId}", "text": "Cancelled" }
  ]
}
