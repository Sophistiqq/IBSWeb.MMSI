{
  "name": "msap-full-to-billing",
  "description": "End-to-end MSAP workflow: Create Schedule -> Capture {scheduleId} -> Approve Missing Rates -> Approve Schedule -> Capture {cosId} -> Record Docking & Watering Tickets -> Open Prepare Billing.",
  "url": "/MSAP/VesselSchedule/Create?date={today}",
  "notes": [
    "Uses {today} so planned date, actual service date, and weekly BAF cycle all align cleanly.",
    "Captures {scheduleId} and {cosId} dynamically from redirect URLs—no hardcoded record IDs.",
    "Deterministic date/time guard keeps actual ticket times completed in the past (UTC+8)."
  ],
  "steps": [
    {
      "action": "fill_form",
      "onlyEmpty": true,
      "overrides": {
        "PortId": "BATANGAS",
        "VoyageNumber": "VOY-{today}-{rand}"
      },
      "scenario": "Valid Philippine maritime vessel schedule booking.",
      "knownFields": {
        "CustomerId": {
          "label": "Customer *",
          "type": "select",
          "value": "10"
        },
        "VesselId": {
          "label": "Vessel *",
          "type": "select",
          "value": "346"
        },
        "PortId": {
          "label": "Port *",
          "type": "select",
          "value": "BATANGAS"
        },
        "VoyageNumber": {
          "label": "Voyage number *",
          "type": "text",
          "value": "VOY-{today}-{rand}"
        },
        "Notes": {
          "label": "Planning notes",
          "type": "textarea",
          "value": "End-to-end automated verification schedule."
        }
      }
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "click",
      "target": "Add tugboat"
    },
    {
      "action": "click",
      "target": "Add service"
    },
    {
      "action": "fill_form",
      "onlyEmpty": true,
      "overrides": [
        {
          "match": "Service",
          "index": 0,
          "value": "Docking"
        },
        {
          "match": "Service",
          "index": 1,
          "value": "Watering"
        }
      ],
      "scenario": "Pick an active Batangas terminal and an available tugboat.",
      "knownFields": {
        "TerminalId": {
          "label": "Terminal *",
          "type": "select",
          "value": "69"
        },
        "SelectedTugboatIds": {
          "label": "Select tugboat",
          "type": "select",
          "value": "145"
        }
      }
    },
    {
      "action": "click",
      "target": "Save for reviewing",
      "waitAfterMs": 2200,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "target": "OK",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 400
    },
    {
      "action": "click",
      "target": "Continue",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 800
    },
    {
      "action": "click",
      "target": "Acknowledge and save",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 2200,
      "waitForNavigation": true
    },
    {
      "action": "capture_url",
      "pattern": "/VesselSchedule/Details/(\\d+)",
      "var": "scheduleId"
    },
    {
      "action": "click",
      "selector": "a.schedule-rate-editor-cta--attention",
      "optional": true,
      "waitAfterMs": 1200,
      "waitForNavigation": true
    },
    {
      "action": "fill_form",
      "scope": "#rateEditorRows",
      "onlyEmpty": true,
      "optional": true,
      "scenario": "Enter positive Philippine Peso maritime tugboat rates as plain numbers ONLY (e.g. 18500 for Basic and 2500 for BAF)."
    },
    {
      "action": "click",
      "selector": "#rateApprove",
      "optional": true,
      "waitAfterMs": 1000
    },
    {
      "action": "click",
      "target": "Save & approve",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 2500,
      "waitForNavigation": true
    },
    {
      "action": "navigate",
      "url": "/MSAP/VesselSchedule/Details/{scheduleId}"
    },
    {
      "action": "click",
      "selector": "#confirmSchedule button[type='submit']",
      "waitAfterMs": 800
    },
    {
      "action": "click",
      "target": "Approve schedule",
      "scope": ".swal2-popup",
      "waitAfterMs": 2500,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "target": "Continue",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 800
    },
    {
      "action": "click",
      "target": "Acknowledge and approve",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 2500,
      "waitForNavigation": true
    },
    {
      "action": "capture_url",
      "pattern": "/COS/Details/(\\d+)",
      "var": "cosId"
    },
    {
      "action": "click",
      "selector": "tr.ui-attention .dropdown-trigger",
      "waitAfterMs": 350
    },
    {
      "action": "click",
      "selector": "tr.ui-attention a[href*='expectedServiceEntryId']",
      "waitAfterMs": 1000,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "selector": "button[data-skip-photo]",
      "optional": true,
      "waitAfterMs": 450
    },
    {
      "action": "fill_and_submit",
      "scope": "#actualTicketEntry form",
      "submitSelector": "button.cos-ticket-save-btn",
      "maxRetries": 2,
      "waitAfterMs": 1800,
      "waitForNavigation": true,
      "overrides": {
        "DispatchNumber": "DT-{rand}-1",
        "Date": "{today}",
        "DateLeft": "{today}",
        "TimeLeft": "08:00",
        "DateArrived": "{today}",
        "TimeArrived": "10:00"
      },
      "knownFields": {
        "TugMasterId": {
          "label": "Captain / tug master *",
          "type": "select",
          "value": "16"
        },
        "Remarks": {
          "label": "Remarks",
          "type": "textarea",
          "value": "Docking completed cleanly."
        }
      },
      "scenario": "Actual Docking dispatch ticket."
    },
    {
      "action": "click",
      "selector": "tr.ui-attention .dropdown-trigger",
      "waitAfterMs": 350
    },
    {
      "action": "click",
      "selector": "tr.ui-attention a[href*='expectedServiceEntryId']",
      "waitAfterMs": 1000,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "selector": "button[data-skip-photo]",
      "optional": true,
      "waitAfterMs": 450
    },
    {
      "action": "fill_and_submit",
      "scope": "#actualTicketEntry form",
      "submitSelector": "button.cos-ticket-save-btn",
      "maxRetries": 2,
      "waitAfterMs": 1800,
      "waitForNavigation": true,
      "overrides": {
        "DispatchNumber": "DT-{rand}-2",
        "Date": "{today}",
        "DateLeft": "{today}",
        "TimeLeft": "10:00",
        "DateArrived": "{today}",
        "TimeArrived": "11:30",
        "Tons": "15",
        "DispatchRate": "500"
      },
      "knownFields": {
        "TugMasterId": {
          "label": "Captain / tug master *",
          "type": "select",
          "value": "17"
        },
        "Remarks": {
          "label": "Remarks",
          "type": "textarea",
          "value": "Watering delivered as requested."
        }
      },
      "scenario": "Actual Watering dispatch ticket."
    },
    {
      "action": "wait",
      "selector": ".job-progress-next a[href*='/Billing/Create']",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": ".job-progress-next a[href*='/Billing/Create']",
      "waitAfterMs": 2000,
      "waitForNavigation": true
    },
    {
      "action": "assert",
      "urlIncludes": "/MSAP/Billing/Create",
      "text": "Prepare billing"
    }
  ]
}
