{
  "name": "billing/adjust",
  "description": "ENCODER adjusts rejected/reopened Billing {billingId} (modifying ticket Basic/BAF rates with authorization PDF) and resubmits for review.",
  "url": "/MSAP/Billing/Review/{billingId}",
  "vars": {
    "encoderAccount": "ENCODER",
    "adjustBasicRate": "21500",
    "adjustBafRate": "3200",
    "adjustReason": "Adjusted billing rates per authorization ({today}-{rand})."
  },
  "steps": [
    {
      "action": "login",
      "account": "{encoderAccount}"
    },
    {
      "action": "navigate",
      "url": "/MSAP/Billing/Review/{billingId}"
    },
    {
      "action": "click",
      "target": "Adjust billing",
      "waitAfterMs": 1500,
      "waitForNavigation": true
    },
    {
      "action": "fill_form",
      "scope": "#adjustTicketsTable tbody tr:first-child",
      "onlyEmpty": false,
      "overrides": {
        "Tickets[0].DispatchRate": "{adjustBasicRate}",
        "Tickets[0].BAFRate": "{adjustBafRate}"
      }
    },
    {
      "action": "upload",
      "selector": "#adjustAuthFile",
      "fixture": "pdf"
    },
    {
      "action": "fill_form",
      "scope": "section[aria-labelledby='adjustAuthHeading']",
      "onlyEmpty": false,
      "overrides": {
        "adjustReason": "{adjustReason}"
      }
    },
    {
      "action": "click",
      "target": "Save adjustment & resubmit",
      "waitAfterMs": 1200
    },
    {
      "action": "click",
      "target": "Save & resubmit",
      "scope": ".swal2-popup",
      "optional": true,
      "waitForPopupMs": 2000,
      "waitAfterMs": 2200,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "target": "Save adjustment",
      "scope": ".swal2-popup",
      "optional": true,
      "waitForPopupMs": 1000,
      "waitAfterMs": 2200,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "target": "Done",
      "scope": ".swal2-popup",
      "optional": true,
      "waitForPopupMs": 2000,
      "waitAfterMs": 500
    },
    {
      "action": "assert",
      "urlIncludes": "/MSAP/Billing/Review/",
      "text": "Revised from"
    }
  ]
}
