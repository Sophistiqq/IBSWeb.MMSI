{
  "name": "admin/grant-user-access",
  "description": "Toggle a UserAccess permission checkbox for a given user (--var userName=\"...\" --var permissionId=\"...\").",
  "url": "/MSAP/UserAccess/Index",
  "vars": {
    "userName": "KIMBERLY MAE HERNANDEZ",
    "permissionId": "CanRevertCollectionBanking"
  },
  "steps": [
    { "action": "wait" },
    { "action": "type", "selector": ".dt-search input", "value": "{userName}" },
    { "action": "wait", "ms": 500 },
    { "action": "click", "target": "ACTIONS", "selector": "#userAccessTable tbody tr:first-child button" },
    { "action": "click", "target": "edit Edit Access" },
    { "action": "click", "selector": "#{permissionId}" },
    { "action": "click", "target": "Save permissions" }
  ]
}
