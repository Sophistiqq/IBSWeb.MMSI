{
  "name": "schedule/create",
  "description": "OPERATIONS creates a vessel schedule booking and captures {scheduleId}.",
  "url": "/MSAP/VesselSchedule/Create?date={today}",
  "vars": {
    "opsAccount": "OPERATIONS",
    "customer": "9",
    "vessel": "346",
    "port": "BATANGAS",
    "terminal": "69",
    "tugboat": "145",
    "service1": "Docking",
    "service2": "Watering"
  },
  "notes": [],
  "lastPassedAt": "2026-11-24T08:39:39.356Z",
  "steps": [
    {
      "action": "login",
      "account": "{opsAccount}"
    },
    {
      "action": "navigate",
      "url": "/MSAP/VesselSchedule/Create?date={today}"
    },
    {
      "action": "fill_form",
      "onlyEmpty": true,
      "overrides": {
        "CustomerId": "{customer}",
        "VesselId": "{vessel}",
        "PortId": "{port}",
        "VoyageNumber": "VOY-{today}-{rand}"
      },
      "knownFields": {
        "CustomerId": {
          "label": "Customer *",
          "type": "select",
          "value": "{customer}"
        },
        "VesselId": {
          "label": "Vessel *",
          "type": "select",
          "value": "{vessel}"
        },
        "PortId": {
          "label": "Port *",
          "type": "select",
          "value": "{port}"
        },
        "VoyageNumber": {
          "label": "Voyage number *",
          "type": "text",
          "value": "VOY-{today}-{rand}"
        },
        "Notes": {
          "label": "Add coordination notes or service instructions...",
          "type": "textarea",
          "value": "Automated modular schedule booking."
        }
      }
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "click",
      "target": "Add tugboat"
    },
    {
      "action": "click",
      "target": "Add service"
    },
    {
      "action": "fill_form",
      "onlyEmpty": true,
      "overrides": [
        {
          "match": "Service",
          "index": 0,
          "value": "{service1}"
        },
        {
          "match": "Service",
          "index": 1,
          "value": "{service2}"
        }
      ],
      "knownFields": {
        "TerminalId": {
          "label": "Terminal *",
          "type": "select",
          "value": "{terminal}"
        },
        "SelectedTugboatIds": {
          "label": "Select tugboat",
          "type": "select",
          "value": "{tugboat}"
        }
      }
    },
    {
      "action": "click",
      "target": "Save for reviewing",
      "waitAfterMs": 2200,
      "waitForNavigation": true
    },
    {
      "action": "click",
      "target": "Done",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 400
    },
    {
      "action": "click",
      "target": "Continue",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 800
    },
    {
      "action": "click",
      "target": "Acknowledge and save",
      "scope": ".swal2-popup",
      "optional": true,
      "waitAfterMs": 2200,
      "waitForNavigation": true
    },
    {
      "action": "capture_url",
      "pattern": "/VesselSchedule/Details/(\\d+)",
      "var": "scheduleId"
    }
  ]
}
