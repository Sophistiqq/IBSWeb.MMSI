@model IEnumerable<IBS.Models.MSAP.MasterFile.MsapPostedPeriod>

@{
    ViewData["Title"] = "Posting Periods";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">ADMIN</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Posting Periods</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
                <p class="modern-body-md" style="color: var(--on-surface-variant)">Close completed accounting months to stamp operational records as Final. Subsequent adjustments require authorized reversal and audit reasons.</p>
            </div>
            <div class="flex gap-2">
                <form class="flex items-center gap-2 @(IBS.Utility.MSAP.Constants.MsapConstants.EnforceClosedPeriods ? "" : "msap-initially-hidden")" asp-action="Close" method="post" onsubmit="return confirmPostPeriod(event)">
                    @Html.AntiForgeryToken()
                    <div class="posted-period-month-select">
                        <select name="month" class="js-modern-select" data-placeholder="Select month" data-searchable="true" required>
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == DateTime.Now.Month ? true : null)">@(new DateOnly(2000, m, 1).ToString("MMMM"))</option>
                            }
                        </select>
                    </div>
                    <div class="posted-period-year-select">
                        <select name="year" class="js-modern-select" data-placeholder="Select year" data-searchable="true" required>
                            @for (var y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 1; y++)
                            {
                                <option value="@y" selected="@(y == DateTime.Now.Year ? true : null)">@y</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined msap-icon-md">lock</span> POST PERIOD
                    </button>
                </form>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">calendar_month</span>
                    <h2 class="modern-headline-md">Period Registry</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <div class="modern-table-container">
                    <table class="modern-table ui-table" id="periodsTable">
                        <thead>
                            <tr>
                                <th>Year</th>
                                <th>Month</th>
                                <th class="text-center">Status</th>
                                <th>Closed By</th>
                                <th>Closed Date</th>
                                <th>Opened By</th>
                                <th>Opened Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var period in Model.OrderByDescending(p => p.Year).ThenByDescending(p => p.Month))
                            {
                                <tr>
                                    <td>@period.Year</td>
                                    <td>@(new DateOnly(period.Year, period.Month, 1).ToString("MMMM"))</td>
                                    <td class="text-center">
                                        @if (period.IsClosed)
                                        {
                                            <span class="modern-badge-sm status-closed">CLOSED</span>
                                        }
                                        else
                                        {
                                            <span class="modern-badge-sm status-open">OPEN</span>
                                        }
                                    </td>
                                    <td>@period.ClosedBy</td>
                                    <td>@(period.ClosedDate?.ToString("MMM dd, yyyy h:mm tt") ?? "-")</td>
                                    <td>@period.OpenedBy</td>
                                    <td>@(period.OpenedDate?.ToString("MMM dd, yyyy h:mm tt") ?? "-")</td>
                                    <td class="text-center">
                                        @if (period.IsClosed)
                                        {
                                            <form asp-action="Open" method="post" style="display:inline" onsubmit="return confirmOpen(event, '@(new DateOnly(period.Year, period.Month, 1).ToString("MMMM yyyy"))')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="year" value="@period.Year" />
                                                <input type="hidden" name="month" value="@period.Month" />
                                                <button type="submit" class="modern-btn-secondary" style="padding: 4px 12px; font-size: 11px; color: var(--success); border-color: var(--success);">
                                                    <span class="material-symbols-outlined" style="font-size: 16px;">lock_open</span> OPEN
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Close" method="post" style="@(IBS.Utility.MSAP.Constants.MsapConstants.EnforceClosedPeriods ? "display:inline" : "display:none")" onsubmit="return confirmClose(event, '@(new DateOnly(period.Year, period.Month, 1).ToString("MMMM yyyy"))')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="year" value="@period.Year" />
                                                <input type="hidden" name="month" value="@period.Month" />
                                                <button type="submit" class="modern-btn-secondary" style="padding: 4px 12px; font-size: 11px; color: var(--error); border-color: var(--error);">
                                                    <span class="material-symbols-outlined" style="font-size: 16px;">lock</span> CLOSE
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center" style="padding: 40px; color: var(--on-surface-variant);">
                                        <span class="material-symbols-outlined" style="font-size: 40px; display: block; margin-bottom: 8px;">calendar_month</span>
                                        No posting periods recorded yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        async function fetchPeriodSummaryText(year, month, label) {
            try {
                const res = await fetch(`@Url.Action("GetPeriodSummary", "PostedPeriod", new { area = "MSAPAdmin" })?year=${encodeURIComponent(year)}&month=${encodeURIComponent(month)}`);
                if (res.ok) {
                    const data = await res.json();
                    const draftNote = data.draftBillings > 0
                        ? ` (${data.draftBillings} unapproved draft billing(s) remain For Posting)`
                        : '';
                    return `Closing ${label} will finalize ${data.tickets} dispatch ticket(s), ${data.billings} approved billing(s)${draftNote}, and ${data.collections} collection(s). Subsequent changes will require authorized adjustment reasons. Continue?`;
                }
            } catch {
                // fallback below
            }
            return `Closing ${label} will lock all transactions and stamp records as Final. Continue?`;
        }

        async function confirmPostPeriod(event) {
            event.preventDefault();
            const form = event.target;
            const month = form.querySelector('select[name="month"]').value;
            const monthName = form.querySelector('select[name="month"] option:checked').text;
            const year = form.querySelector('select[name="year"]').value;
            const summaryText = await fetchPeriodSummaryText(year, month, `${monthName} ${year}`);
            const result = await ModernAlert.confirm({
                title: 'Post Period?',
                text: summaryText,
                icon: 'warning',
                confirmText: 'Yes, post it!',
                confirmButtonColor: '#d33'
            });
            if (result.isConfirmed) {
                ModernAlert.showLoading(`Posting ${monthName} ${year}...`);
                form.submit();
            }
        }

        async function confirmClose(event, monthLabel) {
            event.preventDefault();
            const form = event.target;
            const year = form.querySelector('input[name="year"]').value;
            const month = form.querySelector('input[name="month"]').value;
            const summaryText = await fetchPeriodSummaryText(year, month, monthLabel);
            const result = await ModernAlert.confirm({
                title: 'Close Period?',
                text: summaryText,
                icon: 'warning',
                confirmText: 'Yes, close it!',
                confirmButtonColor: '#d33'
            });
            if (result.isConfirmed) {
                ModernAlert.showLoading(`Closing ${monthLabel}...`);
                form.submit();
            }
        }

        function confirmOpen(event, month) {
            event.preventDefault();
            const form = event.target;
            ModernAlert.confirm({
                title: 'Open Period?',
                text: `Opening ${month} will allow modifications again. Continue?`,
                icon: 'question',
                confirmText: 'Yes, open it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    ModernAlert.showLoading(`Opening ${month}...`);
                    form.submit();
                }
            });
        }
    </script>
}
