@using IBS.Utility.MSAP.Constants
@{
    var isMsapOnlyUser = User.Identity?.IsAuthenticated == true
        && User.IsInRole(MsapRoles.IdentityUserRole)
        && !User.IsInRole(MsapRoles.Admin);

    Layout = isMsapOnlyUser
        ? "/Areas/MSAP/Views/Shared/_Layout.cshtml"
        : "/Views/Shared/_Layout.cshtml";
}
