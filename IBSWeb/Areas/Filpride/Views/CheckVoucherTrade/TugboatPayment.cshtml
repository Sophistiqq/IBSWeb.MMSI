@using IBS.Models.Enums
@using IBS.Models.Filpride.AccountsPayable
@using IBS.Services
@using IBS.Utility.Constants
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@model FilprideCheckVoucherHeader
@{
    ViewData["Title"] = "AP Other Tugs payment";
    var payment = Model.TugboatPayment!;
    var lines = (List<TugboatPaymentLine>)ViewData["PaymentLines"]!;
    bool active = payment.ReleasedAt == null && Model.CanceledBy == null && Model.VoidedBy == null;
    bool posted = Model.PostedBy != null;
}
<style>@@media print { .payment-actions, nav, #modern-navbar, .tugboat-workspace { display: none !important; } }</style>
<main class="container-fluid py-3">
    <h1>AP Other Tugs · @Model.CheckVoucherHeaderNo</h1>
    <p>@Model.Status · @(active ? posted ? "Provider bill paid" : "Provider bill reserved" : "Reservation released")</p>
    <section class="card card-body mb-3" aria-label="Saved payment details">
        <h2 class="h5">@Model.Payee</h2><p>@Model.Address · TIN @Model.Tin</p>
        <p>@Model.VatType · @Model.TaxType · Withholding @Model.TaxPercent.ToString("P2")</p>
        <p>Voucher date @Model.Date.ToString("dd MMM yyyy") · @Model.Type · Provider reference @payment.ProviderReference</p>
        <p>Bank @Model.BankAccountName · @Model.BankAccountNumber · Check @Model.CheckNo · @Model.CheckDate?.ToString("dd MMM yyyy")</p>
        <p>@Model.Particulars</p>
        <dl class="row"><dt class="col-sm-3">Gross AP settled</dt><dd class="col-sm-9">@payment.GrossAmount.ToString("N2")</dd><dt class="col-sm-3">Withholding</dt><dd class="col-sm-9">@payment.WithholdingAmount.ToString("N2")</dd><dt class="col-sm-3">Check amount</dt><dd class="col-sm-9">@Model.CheckAmount.ToString("N2")</dd></dl>
        <a asp-controller="JournalVoucher" asp-action="Print" asp-route-id="@payment.LiabilityJournalVoucherId">View linked AP liability journal</a>
        <p>Payee, tax and allocation details were saved with this voucher.</p>
    </section>
    <section class="card card-body mb-3"><h2 class="h5">Saved service allocations</h2>
        <div class="table-responsive"><table class="table"><thead><tr><th>COS</th><th>Ticket</th><th>Tugboat</th><th>Provider charge</th></tr></thead><tbody>
        @foreach (var line in lines)
        {
            <tr><td>@line.CosNumber</td><td>@line.TicketNumber</td><td>@line.TugboatName</td><td>@line.Amount.ToString("N2")</td></tr>
        }
        </tbody></table></div>
    </section>
    <section class="card card-body mb-3"><h2 class="h5">Posting entries</h2><table class="table"><thead><tr><th>Account</th><th>Debit</th><th>Credit</th></tr></thead><tbody>
        @foreach (var entry in Model.Details!)
        {
            <tr><td>@entry.AccountNo · @entry.AccountName</td><td>@entry.Debit.ToString("N2")</td><td>@entry.Credit.ToString("N2")</td></tr>
        }
    </tbody></table></section>
    <div class="payment-actions d-flex flex-wrap gap-3">
        <a asp-action="Index" class="btn btn-secondary">Back</a>
        @if (active && !posted && (await Authorization.AuthorizeAsync(User, nameof(CheckVoucherTrade.CheckVoucherTradePost))).Succeeded)
        {
            <form asp-action="PostTugboatPayment" method="post"><input name="id" value="@Model.CheckVoucherHeaderId" type="hidden" /><button class="btn btn-primary">Post payment</button></form>
        }
        @if (active && posted)
        {
            <form asp-action="PrintTugboatPayment" method="post" target="_blank"><input name="id" value="@Model.CheckVoucherHeaderId" type="hidden" /><button class="btn btn-primary">Print voucher</button></form>
            @if ((await Authorization.AuthorizeAsync(User, nameof(CheckVoucherTrade.CheckVoucherTradeUnpost))).Succeeded)
            {
                <form asp-action="UnpostTugboatPayment" method="post"><input name="id" value="@Model.CheckVoucherHeaderId" type="hidden" /><button class="btn btn-secondary">Unpost · keep reservation</button></form>
            }
        }
        @if (active && ((!posted && (await Authorization.AuthorizeAsync(User, nameof(CheckVoucherTrade.CheckVoucherTradeCancel))).Succeeded) || (posted && User.IsInRole("Admin"))))
        {
            <form asp-action="@(posted ? "VoidTugboatPayment" : "CancelTugboatPayment")" method="post"><input name="id" value="@Model.CheckVoucherHeaderId" type="hidden" /><label for="paymentCorrectionReason">Correction reason</label><input name="reason" id="paymentCorrectionReason" required maxlength="255" class="form-control" /><button class="btn btn-danger">@(posted ? "Void payment" : "Cancel draft") · release bill</button></form>
        }
    </div>
</main>
@if (ViewData["PrintPayment"] is true)
{
    <script>window.addEventListener('load', function () { window.print(); });</script>
}
