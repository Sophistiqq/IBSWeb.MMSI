@model IBS.Models.MSAP.ViewModels.TugboatOwnerViewModel

@{
    ViewData["Title"] = "Create Tugboat Owner";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <form asp-action="Create" method="post" id="mainForm">
        <main class="modern-container ui-page">
            <!-- Header Section -->
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Tugboat Owners</a></li><li aria-current="page">New Owner / Company</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2 ui-actions">
                    <button type="submit" class="modern-btn-primary ui-page-action">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary ui-page-action">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">apartment</span>
                            <h2 class="modern-headline-md ui-section-title">Owner Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="flex flex-column gap-4">
                                <div>
                                    <label asp-for="TugboatOwnerNumber" class="modern-label ui-label">Owner Number <span class="text-error">*</span></label>
                                    <input asp-for="TugboatOwnerNumber" class="form-control ui-input" placeholder="Enter 3-digit code" maxlength="3" />
                                    <span asp-validation-for="TugboatOwnerNumber" class="text-error ui-caption"></span>
                                </div>

                                <div>
                                    <label asp-for="TugboatOwnerName" class="modern-label ui-label">Owner / Company Name <span class="text-error">*</span></label>
                                    <input asp-for="TugboatOwnerName" class="form-control ui-input" placeholder="Enter company name" />
                                    <span asp-validation-for="TugboatOwnerName" class="text-error ui-caption"></span>
                                </div>
                                <partial name="_PaymentProfile" model="Model" />
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
