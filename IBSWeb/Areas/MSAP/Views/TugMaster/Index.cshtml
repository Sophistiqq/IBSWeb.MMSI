@{
    ViewData["Title"] = "Tugboat Masters";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <!-- Header Section -->
        <div class="flex-stack ui-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li aria-current="page">Tug Masters</li></ol></nav>
                <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2 ui-actions">
                <a asp-action="Create" class="modern-btn-primary ui-page-action">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card ui-card">
            <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">person_check</span>
                    <h2 class="modern-headline-md ui-section-title">Master List</h2>
                </div>
            </div>
            <div class="modern-card-body ui-card-body">
                <table class="modern-table ui-table" id="tugMastersTable">
                    <thead>
                        <tr>
                            <th>Master #</th>
                            <th>Master Name</th>
                            <th class="text-center">Active?</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

<form id="deleteForm" method="post" asp-antiforgery="false" hidden>@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "TugMaster", new { area = "MSAP" })';
            const deleteUrl = '@Url.Action("Delete", "TugMaster", new { area = "MSAP" })';

            let table = $('#tugMastersTable').DataTable(ModernTable.config({
                serverSide: false,
                ajax: ModernTable.ajax("@Url.Action("GetTugMasterList", "TugMaster", new { area = "MSAP" })"),
                columns: [
                    { data: "tugMasterNumber" },
                    {
                        data: "tugMasterName",
                        render: (data, type) => type === 'display' ? `<span class="font-bold uppercase">${ModernTable.render.text(data)}</span>` : data
                    },
                    {
                        data: "isActive",
                        className: "text-center",
                        render: (data) => data ? ModernTable.render.badge('YES', 'ui-status ui-complete') : ModernTable.render.badge('NO', 'ui-status')
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Master', icon: 'edit', url: `${editUrl}?id=${row.tugMasterId}` },
                            {
                                label: 'Delete Master',
                                icon: 'delete',
                                isError: true,
                                onclick: `confirmDelete('${deleteUrl}?id=${row.tugMasterId}')`
                            }
                        ])
                    }
                ]
            }));
        });

        function confirmDelete(url) {
            ModernAlert.confirm({
                title: 'Delete Tug Master?',
                text: "Are you sure you want to delete this tug master entry?",
                icon: 'warning',
                confirmText: 'Yes, Delete',
                cancelText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('deleteForm');
                    form.action = url;
                    form.submit();
                }
            });
        }
    </script>
}
