@model string
@{
    var steps = new List<(string Status, string Description, string Icon)>
    {
        (MsapConstants.VesselScheduleStatus.Tentative, "Plan and assign tugs", "edit_calendar"),
        (MsapConstants.VesselScheduleStatus.Confirmed, "Booking confirmed", "assignment")
    };
    if (Model == MsapConstants.VesselScheduleStatus.InProgress)
    {
        steps.Add((MsapConstants.VesselScheduleStatus.InProgress, "Operation underway", "directions_boat"));
    }
    steps.Add((MsapConstants.VesselScheduleStatus.Completed, "All services finished; billing and collection continue", "check_circle"));
    var currentStep = steps.FindIndex(step => step.Status == Model);
}
@if (Model == MsapConstants.VesselScheduleStatus.Cancelled)
{
    <div class="schedule-progress-stopped">
        <span class="material-symbols-outlined" aria-hidden="true">event_busy</span>
        <div><strong>Booking cancelled</strong><p class="schedule-muted">This schedule is read-only. Linked COS, Dispatch Tickets and billing records are retained.</p></div>
    </div>
}
else
{
    <ol class="schedule-progress" aria-label="Schedule stages">
        @for (var index = 0; index < steps.Count; index++)
        {
            var step = steps[index];
            var state = index == currentStep ? "current" : index < currentStep ? "done" : "upcoming";
            <li class="schedule-progress-step" data-state="@state" aria-current="@(index == currentStep ? "step" : null)">
                <span class="schedule-progress-node material-symbols-outlined" aria-hidden="true">@(index < currentStep ? "check" : step.Icon)</span>
                <strong>@MsapConstants.VesselScheduleStatus.GetDisplayName(step.Status)</strong>
                <span class="visually-hidden">@step.Description</span>
                <span class="visually-hidden">@(state == "current" ? "Current stage" : state == "done" ? "Passed" : "Next stage")</span>
            </li>
        }
    </ol>
}
