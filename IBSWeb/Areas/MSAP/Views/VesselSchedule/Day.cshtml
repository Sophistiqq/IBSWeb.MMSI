@using System.Text.Json
@model VesselScheduleBoardViewModel
@{
    ViewData["Title"] = "Daily Vessel Schedules";
    ViewData["IsFullWidth"] = true;
    var day = Model.Date;
    var conflictingIds = Model.ConflictsByDay.GetValueOrDefault(day) ?? new HashSet<int>();
    var active = Model.Schedules.Where(s => s.Status != MsapConstants.VesselScheduleStatus.Cancelled).ToList();
    var assignments = Model.Schedules.ToDictionary(s => s.VesselScheduleId,
        s => string.IsNullOrEmpty(s.AssignedTugboatIds) ? new List<int>() : JsonSerializer.Deserialize<List<int>>(s.AssignedTugboatIds) ?? []);
    var names = Model.Tugboats.ToDictionary(t => t.TugboatId, t => t.TugboatName);
    var bookedTugIds = active.SelectMany(s => assignments[s.VesselScheduleId]).ToHashSet();
}
<link rel="stylesheet" href="~/msap/css/vessel-schedule.css" asp-append-version="true" />
<div class="modern-layout">
    <main class="modern-container schedule-workspace">
        <div class="flex-stack">
            <div>
                <span class="modern-label">Vessel Schedule · Daily planning</span>
                <h1 class="modern-headline-lg" data-page-header>@day.ToString("dddd, MMMM d, yyyy")</h1>
                <p class="schedule-muted">Schedules overlapping this day. All times are Philippine time.</p>
            </div>
            <div class="schedule-actions">
                <a asp-action="Index" asp-route-month="@day.ToString("yyyy-MM")" class="modern-btn-secondary"><span class="material-symbols-outlined">calendar_month</span> Calendar</a>
                <a asp-action="Create" asp-route-date="@day.ToString("yyyy-MM-dd")" class="modern-btn-primary"><span class="material-symbols-outlined">add</span> New schedule</a>
            </div>
        </div>
        <div class="modern-card">
            <div class="schedule-navigation">
                <div class="schedule-period"><span class="material-symbols-outlined">event</span><strong>@day.ToString("ddd, MMM d")</strong></div>
                <div class="schedule-navigation-controls">
                    <nav class="schedule-stepper" aria-label="Day navigation">
                        <a asp-action="Day" asp-route-date="@day.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Previous day"><span class="material-symbols-outlined">chevron_left</span></a>
                        <a asp-action="Day">Today</a>
                        <a asp-action="Day" asp-route-date="@day.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Next day"><span class="material-symbols-outlined">chevron_right</span></a>
                    </nav>
                    <form method="get" class="schedule-date-jump">
                        <label for="date">Date</label>
                        <input type="date" id="date" name="date" min="1900-01-01" max="9998-12-31" value="@day.ToString("yyyy-MM-dd")" onchange="this.form.submit()" required />
                        <noscript><button type="submit">Go</button></noscript>
                    </form>
                </div>
            </div>
        </div>
        <div class="schedule-day-summary" aria-label="Daily schedule summary">
            <span><strong>@Model.Schedules.Count</strong> schedules</span>
            @if (conflictingIds.Count > 0) { <span class="schedule-conflict-legend"><span class="material-symbols-outlined">warning</span><strong>@conflictingIds.Count</strong> overlapping plans</span> }
            <span data-status="Confirmed"><strong>@active.Count(s => s.Status == MsapConstants.VesselScheduleStatus.Confirmed)</strong> confirmed</span>
            <span data-status="In Progress"><strong>@active.Count(s => s.Status == MsapConstants.VesselScheduleStatus.InProgress)</strong> in progress</span>
        </div>
        <div class="schedule-daily-layout">
        <section class="schedule-agenda" aria-labelledby="agendaHeading">
        <div class="schedule-toolbar">
            <h2 id="agendaHeading" class="modern-headline-md">Day agenda <small id="visibleCount" aria-live="polite">(@Model.Schedules.Count)</small></h2>
            <div class="schedule-actions">
                <label for="scheduleSearch" class="modern-label">Search</label>
                <input type="search" id="scheduleSearch" class="modern-input" placeholder="Vessel, location, voyage or tug" />
                <label for="scheduleStatus" class="modern-label">Status</label>
                <select id="scheduleStatus" class="modern-input">
                    <option value="">All statuses</option>
                    @foreach (var status in new[] { MsapConstants.VesselScheduleStatus.Tentative, MsapConstants.VesselScheduleStatus.Confirmed, MsapConstants.VesselScheduleStatus.InProgress, MsapConstants.VesselScheduleStatus.Completed, MsapConstants.VesselScheduleStatus.Cancelled })
                    { <option value="@status">@MsapConstants.VesselScheduleStatus.GetDisplayName(status)</option> }
                </select>
            </div>
        </div>
        <div class="schedule-agenda-list">
            @foreach (var schedule in Model.Schedules)
            {
                var ids = assignments[schedule.VesselScheduleId];
                var closed = schedule.Status is MsapConstants.VesselScheduleStatus.Completed or MsapConstants.VesselScheduleStatus.Cancelled;
                <article class="modern-card schedule-agenda-row @(conflictingIds.Contains(schedule.VesselScheduleId) ? "schedule-agenda-conflict" : "")" data-schedule data-status="@schedule.Status">
                    <div class="schedule-agenda-heading">
                        <div>
                            <a asp-action="Details" asp-route-id="@schedule.VesselScheduleId" class="schedule-vessel-link">@schedule.Vessel.VesselName</a>
                            <p class="schedule-muted">#@schedule.VesselScheduleId · Voyage @(schedule.VoyageNumber ?? "—")
                                @if (schedule.PlannedStart.Date < day) { <span class="schedule-continuation">↳ Continuing</span> }
                            </p>
                        </div>
                        <div class="schedule-actions">
                            @if (conflictingIds.Contains(schedule.VesselScheduleId)) { <span class="schedule-conflict-legend"><span class="material-symbols-outlined">warning</span>Overlap</span> }
                            <span class="schedule-status" data-status="@schedule.Status">@MsapConstants.VesselScheduleStatus.GetDisplayName(schedule.Status)</span>
                            @if (!closed && schedule.JobOrderId == null && ViewBag.CanConfirm == true)
                            {
                                <a asp-action="Confirm" asp-route-id="@schedule.VesselScheduleId" class="modern-btn-primary">Confirm Schedule</a>
                            }
                            @if (schedule.JobOrderId.HasValue)
                            {
                                <a asp-controller="JobOrder" asp-action="Details" asp-route-id="@schedule.JobOrderId" class="modern-btn-secondary">@schedule.JobOrder?.JobOrderNumber</a>
                            }
                            @if (!closed && ViewBag.CanEdit == true)
                            {
                                <a asp-action="Edit" asp-route-id="@schedule.VesselScheduleId" class="modern-btn-secondary" aria-label="Edit @schedule.Vessel.VesselName schedule"><span class="material-symbols-outlined">edit</span> Edit</a>
                            }
                        </div>
                    </div>
                    <div class="schedule-agenda-metrics">
                        <div><span class="schedule-metric-label"><span class="material-symbols-outlined">location_on</span> Location</span><strong>@schedule.Port.PortName</strong><span>@schedule.Terminal.TerminalName</span></div>
                        <div><span class="schedule-metric-label"><span class="material-symbols-outlined">schedule</span> Planned window</span><strong>@schedule.PlannedStart.ToString("MMM d, HH:mm") <span aria-hidden="true">→</span> @schedule.PlannedEnd.ToString("MMM d, HH:mm")</strong></div>
                        <div><span class="schedule-metric-label"><span class="material-symbols-outlined">directions_boat</span> Tugboats</span><strong>@ids.Count assigned</strong>
                        </div>
                    </div>
                    @if (ids.Count > 0 || !string.IsNullOrWhiteSpace(schedule.Notes))
                    {
                        <details class="schedule-assignment-details">
                            <summary>Assigned tugboats (@ids.Count) &amp; notes <span class="material-symbols-outlined">expand_more</span></summary>
                            <div class="schedule-assignment-content">
                                <div class="schedule-tug-chips">
                                    @foreach (var id in ids) { <span>@names.GetValueOrDefault(id, $"Unknown tug #{id}")</span> }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(schedule.Notes)) { <p class="schedule-note">@schedule.Notes</p> }
                            </div>
                        </details>
                    }
                    else { <p class="schedule-muted">Tugboats not assigned yet.</p> }
                </article>
            }
        </div>
        <div id="noSchedules" class="modern-card schedule-empty" hidden="@(Model.Schedules.Count > 0)">
            <p>No schedules to display. Add a schedule or adjust the filters.</p>
        </div>
        </section>
        <details class="modern-card schedule-fleet schedule-daily-fleet" open>
            <summary><span class="material-symbols-outlined">directions_boat</span><strong>Tugboat bookings</strong><span class="material-symbols-outlined schedule-expand">expand_more</span></summary>
            <div class="modern-card-body">
                <div class="schedule-toolbar">
                    <p class="schedule-muted">@bookedTugIds.Count booked · @(Model.Tugboats.Count(t => !bookedTugIds.Contains(t.TugboatId))) unbooked</p>
                    <div class="schedule-actions">
                        <label for="tugSearch" class="visually-hidden">Search tugboats</label>
                        <input type="search" id="tugSearch" class="modern-input" placeholder="Find a tugboat…" />
                        <label for="tugScope" class="visually-hidden">Tugboat booking filter</label>
                        <select id="tugScope" class="modern-input"><option value="booked">Booked tugs</option><option value="all">All tugs</option><option value="unbooked">Unbooked tugs</option></select>
                    </div>
                </div>
                <div class="schedule-fleet-list">
                    @foreach (var tug in Model.Tugboats.OrderByDescending(t => bookedTugIds.Contains(t.TugboatId)))
                    {
                        var bookings = active.Where(s => assignments[s.VesselScheduleId].Contains(tug.TugboatId)).ToList();
                        <div class="schedule-fleet-row" data-tug data-booked="@(bookings.Count > 0 ? "true" : "false")" data-name="@tug.TugboatName" hidden="@(bookings.Count == 0)">
                            <div class="schedule-fleet-name"><span class="material-symbols-outlined">sailing</span><strong>@tug.TugboatName</strong><small>@(bookings.Count == 0 ? "Unbooked" : $"{bookings.Count} booking(s)")</small></div>
                            @foreach (var booking in bookings)
                            {
                                <a class="schedule-fleet-booking" asp-action="Details" asp-route-id="@booking.VesselScheduleId">
                                    <span>@booking.PlannedStart.ToString("MMM d HH:mm") – @booking.PlannedEnd.ToString("MMM d HH:mm")</span>
                                    <strong>@booking.Vessel.VesselName</strong><span class="schedule-status" data-status="@booking.Status">@MsapConstants.VesselScheduleStatus.GetDisplayName(booking.Status)</span>
                                </a>
                            }
                        </div>
                    }
                </div>
                <p id="noTugBookings" class="schedule-muted" hidden="@(bookedTugIds.Count > 0)">No tugboats match this view.</p>
                <small class="schedule-muted">Unbooked means no schedule here; check operational availability before assigning.</small>
            </div>
        </details>
        </div>
    </main>
</div>
@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '.flex-stack > .schedule-actions', title: 'Calendar and new booking', text: 'Return to the monthly calendar or create a schedule for this day.', interactive: false },
            { selector: '.schedule-navigation', title: 'Choose a day', text: 'Step through dates or jump directly to a date. Overnight bookings appear on every day they overlap.', interactive: false },
            { selector: '.schedule-day-summary', title: 'Daily summary', text: 'See the schedule count, active stages, and any overlapping plans that need attention.', interactive: false },
            { selector: '.schedule-toolbar', title: 'Find a schedule', text: 'Search by vessel, location, voyage, or tugboat and filter the agenda by status.', interactive: false },
            { selector: '#agendaHeading', title: 'Day agenda', text: 'Open a vessel below to review its booking and next action. Each row shows the planned window, location, assigned tugboat count, and available actions.', interactive: false },
            { selector: '.schedule-daily-fleet', title: 'Tugboat bookings', text: 'Review which tugboats are booked for this day. Search or switch the filter to see unbooked tugs; confirm operational availability before assigning one.', interactive: false }
        ];
    </script>
    <script>
        const cards = [...document.querySelectorAll('[data-schedule]')];
        function filterSchedules() {
            const search = document.getElementById('scheduleSearch').value.trim().toLowerCase();
            const status = document.getElementById('scheduleStatus').value;
            cards.forEach(card => card.hidden = (status && card.dataset.status !== status) || !card.textContent.toLowerCase().includes(search));
            const count = cards.filter(card => !card.hidden).length;
            document.getElementById('visibleCount').textContent = '(' + count + ')';
            document.getElementById('noSchedules').hidden = count > 0;
        }
        document.getElementById('scheduleSearch').addEventListener('input', filterSchedules);
        document.getElementById('scheduleStatus').addEventListener('change', filterSchedules);
        const tugRows = [...document.querySelectorAll('[data-tug]')];
        function filterTugs() {
            const search = document.getElementById('tugSearch').value.trim().toLowerCase();
            const scope = document.getElementById('tugScope').value;
            tugRows.forEach(row => {
                const booked = row.dataset.booked === 'true';
                row.hidden = !row.dataset.name.toLowerCase().includes(search) || (scope === 'booked' && !booked) || (scope === 'unbooked' && booked);
            });
            document.getElementById('noTugBookings').hidden = tugRows.some(row => !row.hidden);
        }
        document.getElementById('tugSearch').addEventListener('input', filterTugs);
        document.getElementById('tugScope').addEventListener('change', filterTugs);
    </script>
}
