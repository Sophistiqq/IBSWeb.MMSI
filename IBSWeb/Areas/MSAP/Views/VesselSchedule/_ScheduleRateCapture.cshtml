@model ScheduleRateCaptureViewModel
@if (Model != null && (Model.PublishedUpdateId.HasValue || Model.IsPendingRate))
{
    <div class="schedule-rate-capture-wrapper">
    @if (Model.PublishedUpdateId.HasValue)
    {
        <small class="ui-caption">Saved for reuse · <a asp-controller="RateUpload" asp-action="Details"
                                                          asp-route-id="@Model.PublishedUpdateId">View rate evidence</a></small>
    }
    else if (Model.IsPendingRate)
    {
        <small class="ui-caption schedule-review-attention">Rate pending</small>
    }
    </div>
}
else
{
    <div class="schedule-rate-capture-wrapper"></div>
}
