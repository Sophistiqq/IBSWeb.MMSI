@using System.Security.Claims
@using IBS.Services.MSAP.AccessControl
@inject IAccessControlService AccessControl
@using System.Text.Json
@model VesselScheduleBoardViewModel
@{
    var accessUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    bool canCreateSchedule = accessUserId != null && await AccessControl.HasAccessAsync(accessUserId, ProcedureEnum.CreateCustomerOrderSlip);
    ViewData["Title"] = "Vessel schedules";
    ViewData["IsFullWidth"] = true;
    var month = Model.Date;
    var today = DateTimeHelper.GetCurrentPhilippineTime().Date;
    var assignments = Model.Schedules.ToDictionary(s => s.VesselScheduleId,
        s => (JsonSerializer.Deserialize<List<int>>(s.AssignedTugboatIds ?? "[]") ?? new List<int>()).Distinct().ToList());
    var tugboats = Model.Tugboats.ToDictionary(t => t.TugboatId);
    var isListView = string.Equals(Model.ViewMode, "list", StringComparison.OrdinalIgnoreCase);
    var isTugView = string.Equals(Model.ViewMode, "tugboats", StringComparison.OrdinalIgnoreCase);

    var rangeStart = (Model.SelectedDate ?? today).Date;
    var rangeEnd = (Model.SelectedEndDate ?? rangeStart).Date;
    var hasRange = rangeEnd > rangeStart;
    var rangeDays = (rangeEnd - rangeStart).Days + 1;

    var filters = new Dictionary<string, string>
    {
        ["portId"] = Model.PortId?.ToString() ?? "",
        ["terminalId"] = Model.TerminalId?.ToString() ?? "",
        ["search"] = Model.Search ?? "",
        ["status"] = Model.Status ?? "",
        ["view"] = Model.ViewMode,
        ["triage"] = Model.Triage ?? ""
    };
    var statuses = new[]
    {
        MsapConstants.VesselScheduleStatus.Tentative,
        MsapConstants.VesselScheduleStatus.Confirmed,
        MsapConstants.VesselScheduleStatus.InProgress,
        MsapConstants.VesselScheduleStatus.Completed,
        MsapConstants.VesselScheduleStatus.Cancelled
    };
    var rangeSchedules = Model.Schedules
        .Where(s => s.PlannedStart < rangeEnd.AddDays(1) && s.PlannedEnd > rangeStart)
        .ToList();
    var rangeBookings = Model.TugBookings
        .Where(s => s.PlannedStart < rangeEnd.AddDays(1) && s.PlannedEnd > rangeStart)
        .ToList();
    var bookingTugAssignments = rangeBookings.ToDictionary(s => s.VesselScheduleId,
        s => (JsonSerializer.Deserialize<List<int>>(s.AssignedTugboatIds ?? "[]") ?? new List<int>()).Distinct().ToList());
    var bookedTugCount = Model.Tugboats.Count(t => rangeBookings.Any(b => bookingTugAssignments[b.VesselScheduleId].Contains(t.TugboatId)));

    var otherWindowMatches = !isListView && !string.IsNullOrWhiteSpace(Model.Search)
        ? Model.AllMatchingSchedules.Where(s => s.PlannedStart >= rangeEnd.AddDays(1) || s.PlannedEnd <= rangeStart).ToList()
        : new List<VesselSchedule>();

    var activeFilterCount = (Model.PortId.HasValue ? 1 : 0)
        + (Model.TerminalId.HasValue ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(Model.Status) ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(Model.Search) ? 1 : 0);
    var hasAnyFilter = activeFilterCount > 0;

    string rangeHeading;
    if (!hasRange)
    {
        rangeHeading = rangeStart.ToString("ddd, d MMM yyyy");
    }
    else if (rangeStart.Year == rangeEnd.Year && rangeStart.Month == rangeEnd.Month)
    {
        rangeHeading = $"{rangeStart:d} – {rangeEnd:d MMM yyyy}";
    }
    else
    {
        rangeHeading = $"{rangeStart:d MMM} – {rangeEnd:d MMM yyyy}";
    }

    var prevStart = rangeStart.AddDays(-rangeDays);
    var prevEnd = rangeEnd.AddDays(-rangeDays);
    var nextStart = rangeStart.AddDays(rangeDays);
    var nextEnd = rangeEnd.AddDays(rangeDays);

    var currentBoardUrl = Url.Action("Index", "VesselSchedule", new
    {
        area = "MSAP",
        month = month.ToString("yyyy-MM"),
        date = rangeStart.ToString("yyyy-MM-dd"),
        endDate = hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null,
        portId = Model.PortId,
        terminalId = Model.TerminalId,
        search = Model.Search,
        status = Model.Status,
        view = Model.ViewMode,
        triage = Model.Triage
    });
}
<link rel="stylesheet" href="~/msap/css/vessel-schedule.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/vessel-calendar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<div class="modern-layout schedule-calendar-layout app-ui">
    <main class="modern-container schedule-workspace schedule-calendar-workspace ui-page">
        <header class="schedule-board-header">
            <div class="schedule-board-title-block">
                <nav aria-label="Breadcrumb">
                    <ol class="ui-breadcrumb">
                        <li><a asp-controller="Home" asp-action="Index">MSAP</a></li>
                        <li aria-current="page">Vessel schedules</li>
                    </ol>
                </nav>
                <div class="schedule-title-left">
                    <h1 class="modern-headline-lg ui-page-title" data-page-header>Vessel schedules</h1>
                    <span class="schedule-location-chip">@Model.LocationHeading</span>
                </div>
            </div>
            <div class="schedule-board-actions">
                @if (isListView)
                {
                    <div class="schedule-view-switch" role="group" aria-label="Workspace view">
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "calendar" })" asp-route-month="@month.ToString("yyyy-MM")" asp-route-date="@rangeStart.ToString("yyyy-MM-dd")" asp-route-endDate="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null)" class="schedule-seg-btn">
                            <span>Schedules</span>
                        </a>
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "tugboats" })" asp-route-month="@month.ToString("yyyy-MM")" asp-route-date="@rangeStart.ToString("yyyy-MM-dd")" asp-route-endDate="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null)" class="schedule-seg-btn">
                            <span>Tugboats</span>
                        </a>
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list" })" asp-route-month="@month.ToString("yyyy-MM")" class="schedule-seg-btn active" aria-current="page">
                            <span>All List</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="schedule-view-switch" role="tablist" aria-label="Workspace view">
                        <button type="button" id="agendaTab" role="tab" aria-controls="@(Model.SelectedDate.HasValue ? "dayAgenda" : "scheduleAgendaFallback")" aria-selected="@(!isTugView ? "true" : "false")" tabindex="@(!isTugView ? "0" : "-1")" data-panel-tab data-view-name="calendar" class="schedule-seg-btn @(!isTugView ? "active" : "")">
                            <span>Schedules</span>
                            <span class="schedule-tab-count">@rangeSchedules.Count</span>
                        </button>
                        <button type="button" id="tugTab" role="tab" aria-controls="dayTugs" aria-selected="@(isTugView ? "true" : "false")" tabindex="@(isTugView ? "0" : "-1")" data-panel-tab data-view-name="tugboats" class="schedule-seg-btn @(isTugView ? "active" : "")">
                            <span>Tugboats</span>
                            <span class="schedule-tab-count">@bookedTugCount/@Model.Tugboats.Count</span>
                        </button>
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list" })" asp-route-month="@month.ToString("yyyy-MM")" asp-route-date="@rangeStart.ToString("yyyy-MM-dd")" asp-route-endDate="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null)" class="schedule-seg-btn" title="All matching schedules across all dates">
                            <span>All List</span>
                        </a>
                    </div>
                }
            </div>
            @if (canCreateSchedule)
            {
                <a asp-action="Create"
                   asp-route-date="@rangeStart.ToString("yyyy-MM-dd")"
                   asp-route-portId="@Model.PortId"
                   asp-route-terminalId="@Model.TerminalId"
                   asp-route-prefill="1"
                   asp-route-returnUrl="@currentBoardUrl"
                   class="modern-btn-primary schedule-new-btn"
                   data-hotkey="c">
                    <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                    CREATE SCHEDULE
                </a>
            }
        </header>

        <section class="schedule-control-bar" aria-label="Schedule controls">
            <div class="schedule-control-top-row">
                @if (!isListView)
                {
                    <div class="schedule-range-controls">
                        <div class="schedule-range-pill-group">
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters))"
                               asp-route-month="@prevStart.ToString("yyyy-MM")"
                               asp-route-date="@prevStart.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@(hasRange ? prevEnd.ToString("yyyy-MM-dd") : null)"
                               class="schedule-cal-step"
                               aria-label="Previous @rangeDays day@(rangeDays == 1 ? "" : "s")"
                               title="Previous @rangeDays day@(rangeDays == 1 ? "" : "s")">
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                            </a>
                            <button type="button" id="openCalendarModalBtn" class="schedule-range-trigger" aria-haspopup="dialog" aria-controls="scheduleCalendarModal">
                                <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                                <span class="schedule-range-trigger-label">@rangeHeading</span>
                                <span class="schedule-range-days-badge">@(rangeDays)d</span>
                                <span class="material-symbols-outlined schedule-range-caret" aria-hidden="true">expand_more</span>
                            </button>
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters))"
                               asp-route-month="@nextStart.ToString("yyyy-MM")"
                               asp-route-date="@nextStart.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@(hasRange ? nextEnd.ToString("yyyy-MM-dd") : null)"
                               class="schedule-cal-step"
                               aria-label="Next @rangeDays day@(rangeDays == 1 ? "" : "s")"
                               title="Next @rangeDays day@(rangeDays == 1 ? "" : "s")">
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                            </a>
                        </div>
                        <a asp-action="Index"
                           asp-all-route-data="@(new Dictionary<string, string>(filters))"
                           asp-route-month="@today.ToString("yyyy-MM")"
                           asp-route-date="@today.ToString("yyyy-MM-dd")"
                           class="schedule-today-btn @(!hasRange && rangeStart == today ? "is-current" : "")">Today</a>
                    </div>
                }

                <button type="button"
                        id="scheduleFiltersToggle"
                        class="modern-btn-secondary schedule-filter-fold-btn @(activeFilterCount > 0 ? "active" : "")"
                        aria-expanded="@(hasAnyFilter ? "true" : "false")"
                        aria-controls="calendarFilters">
                    <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    <span>Search &amp; Filters</span>
                    @if (activeFilterCount > 0)
                    {
                        <span class="schedule-filter-badge">@activeFilterCount</span>
                    }
                </button>
            </div>

            <form method="get" class="schedule-inline-filters @(isListView || hasAnyFilter ? "is-open" : "")" id="calendarFilters" aria-label="Schedule filters">
                <input type="hidden" name="view" id="filterViewInput" value="@Model.ViewMode" />
                <input type="hidden" name="triage" id="filterTriageInput" value="@Model.Triage" />
                <input type="hidden" name="month" value="@month.ToString("yyyy-MM")" />
                <input type="hidden" name="date" value="@rangeStart.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="endDate" value="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : "")" />
                <div class="schedule-toolbar-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input name="search"
                           id="calendarSearch"
                           type="search"
                           value="@Model.Search"
                           maxlength="120"
                           class="modern-input"
                           placeholder="Search vessel, VS-#, COS-#, tug..."
                           aria-label="Find schedule" />
                </div>
                <div class="schedule-filter-field">
                    <select asp-for="PortId" asp-items="Model.Ports" id="calendarPort" class="js-modern-select" data-placeholder="All ports" aria-label="Filter by port">
                        <option value="">All ports</option>
                    </select>
                </div>
                <div class="schedule-filter-field">
                    <select asp-for="TerminalId" asp-items="Model.Terminals" id="calendarTerminal" class="js-modern-select" data-placeholder="All terminals" aria-label="Filter by terminal">
                        <option value="">All terminals</option>
                    </select>
                </div>
                @if (!isListView)
                {
                    <div class="schedule-filter-field">
                        <select asp-for="Status" id="calendarStatus" class="js-modern-select" data-placeholder="All statuses" data-searchable="false" aria-label="Filter by status">
                            <option value="">All statuses</option>
                            @foreach (var status in statuses)
                            {
                                <option value="@status">@MsapConstants.VesselScheduleStatus.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="status" value="@Model.Status" />
                }
                @if (hasAnyFilter)
                {
                    <a asp-action="Index"
                       asp-route-month="@month.ToString("yyyy-MM")"
                       asp-route-date="@rangeStart.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null)"
                       asp-route-view="@Model.ViewMode"
                       class="modern-btn-secondary schedule-reset-btn"
                       title="Reset all filters">
                        <span>Reset</span>
                    </a>
                }
            </form>
        </section>

        @if (!isListView && otherWindowMatches.Count > 0)
        {
            <section class="modern-card ui-card schedule-cross-matches" aria-label="Cross-date search matches">
                <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">manage_search</span>
                        <h2 class="modern-headline-md ui-section-title">
                            Found @Model.AllMatchingTotalCount matching schedule@(Model.AllMatchingTotalCount == 1 ? "" : "s") across all dates (@rangeSchedules.Count in selected range)
                        </h2>
                    </div>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list" })" class="modern-btn-secondary">
                        View all in List →
                    </a>
                </div>
                <div class="modern-card-body ui-card-body">
                    <div class="flex flex-wrap gap-2">
                        @foreach (var match in otherWindowMatches.Take(6))
                        {
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "calendar" })"
                               asp-route-month="@match.PlannedStart.ToString("yyyy-MM")"
                               asp-route-date="@match.PlannedStart.ToString("yyyy-MM-dd")"
                               class="modern-btn-secondary" style="font-size: 0.8rem; padding: 0.35rem 0.65rem;">
                                <strong>@match.PlannedStart.ToString("dd MMM yyyy")</strong> · @match.Vessel.VesselName@(match.CustomerOrderSlip != null ? $" ({match.CustomerOrderSlip.CustomerOrderSlipNumber})" : "")
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        @if (isListView)
        {
            <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by status">
                <a asp-action="Index"
                   asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list", ["status"] = "" })"
                   asp-route-month="@month.ToString("yyyy-MM")"
                   class="modern-btn-secondary @(string.IsNullOrWhiteSpace(Model.Status) ? "active" : "")">ALL</a>
                @foreach (var status in statuses)
                {
                    var isActiveStatus = string.Equals(Model.Status, status, StringComparison.OrdinalIgnoreCase);
                    <a asp-action="Index"
                       asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list", ["status"] = status })"
                       asp-route-month="@month.ToString("yyyy-MM")"
                       class="modern-btn-secondary @(isActiveStatus ? "active" : "")">@MsapConstants.VesselScheduleStatus.GetDisplayName(status).ToUpperInvariant()</a>
                }
            </div>

            <section class="modern-card ui-card" aria-label="All matching schedules">
                <div class="modern-card-header-action flex flex-wrap justify-between items-center gap-2 w-full ui-card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">view_list</span>
                        <h2 class="modern-headline-md ui-section-title">All Vessel Schedules</h2>
                        <span class="ui-caption ui-muted">
                            (@(Model.AllMatchingTotalCount > Model.AllMatchingSchedules.Count
                                ? $"latest {Model.AllMatchingSchedules.Count} of {Model.AllMatchingTotalCount}"
                                : $"{Model.AllMatchingTotalCount}"))
                        </span>
                    </div>
                </div>
                <div class="modern-card-body ui-card-body">
                    <table class="modern-table ui-table" id="vesselSchedulesTable">
                        <thead>
                            <tr>
                                <th>Planned Window</th>
                                <th>Schedule / COS #</th>
                                <th>Vessel / Voyage</th>
                                <th>Customer</th>
                                <th>Port - Terminal</th>
                                <th>Tugs &amp; Planned Services</th>
                                <th class="text-center">Stage</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AllMatchingSchedules)
                            {
                                var itemTugs = (JsonSerializer.Deserialize<List<int>>(item.AssignedTugboatIds ?? "[]") ?? new List<int>()).Distinct().ToList();
                                var customerName = item.Customer?.CustomerName ?? "Not recorded";
                                var portTerminal = $"{item.Port.PortName} • {item.Terminal.TerminalName}";
                                var meta = Model.OpsMetaBySchedule.GetValueOrDefault(item.VesselScheduleId);
                                var serviceSummary = (item.ServiceEntries ?? []).Where(e => !e.CancelledAt.HasValue)
                                    .Select(e => $"{e.Tugboat?.TugboatName ?? $"Tug #{e.TugboatId}"}: {e.Service?.ServiceName ?? "Service"}")
                                    .ToList();
                                <tr class="@(item.Status == MsapConstants.VesselScheduleStatus.Cancelled ? "schedule-cancelled" : "")">
                                    <td data-order="@item.PlannedStart.ToString("O")">
                                        <strong>@item.PlannedStart.ToString("dd MMM yyyy, HH:mm")</strong>
                                        <div class="text-xs ui-muted">to @(item.PlannedEnd.Date == item.PlannedStart.Date ? item.PlannedEnd.ToString("HH:mm") : item.PlannedEnd.ToString("dd MMM yyyy, HH:mm"))</div>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.VesselScheduleId" asp-route-returnUrl="@currentBoardUrl" class="font-bold" style="text-decoration:none; color: var(--primary)">VS-@item.VesselScheduleId</a>
                                        @if (item.CustomerOrderSlip != null)
                                        {
                                            <div class="text-xs">
                                                <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@item.CustomerOrderSlipId" style="text-decoration:none; color: var(--primary)">@item.CustomerOrderSlip.CustomerOrderSlipNumber</a>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong class="uppercase">@item.Vessel.VesselName</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.VoyageNumber))
                                        {
                                            <div class="text-xs ui-muted">Voy. @item.VoyageNumber</div>
                                        }
                                    </td>
                                    <td>
                                        <div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@customerName">@customerName</div>
                                    </td>
                                    <td>
                                        <div style="max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@portTerminal">@portTerminal</div>
                                    </td>
                                    <td>
                                        <div class="text-xs">
                                            <strong>@itemTugs.Count/@item.RequiredTugCount tugs</strong>
                                            @if (serviceSummary.Count > 0)
                                            {
                                                <div class="ui-muted" style="max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@string.Join(" · ", serviceSummary)">@string.Join(" · ", serviceSummary)</div>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (meta != null)
                                        {
                                            <span class="modern-badge-sm @meta.StageBadgeClass">@meta.StageLabel</span>
                                        }
                                        else
                                        {
                                            <span class="schedule-status" data-status="@item.Status">@MsapConstants.VesselScheduleStatus.GetDisplayName(item.Status)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="flex justify-center gap-2">
                                            <a asp-action="Details" asp-route-id="@item.VesselScheduleId" asp-route-returnUrl="@currentBoardUrl" class="modern-btn-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.55rem;">Open</a>
                                            <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "calendar" })" asp-route-month="@item.PlannedStart.ToString("yyyy-MM")" asp-route-date="@item.PlannedStart.ToString("yyyy-MM-dd")" class="modern-btn-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.55rem;" title="Jump to date on board">
                                                <span class="material-symbols-outlined" style="font-size: 16px;" aria-hidden="true">calendar_month</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
            <partial name="_CalendarDayPanel" model="Model" />
            <partial name="_CalendarRangeModal" model="Model" />
            <script type="application/json" id="initialCalendarSummaries">@Html.Raw(JsonSerializer.Serialize(Model.InitialDaySummaries))</script>

            @foreach (var entry in Model.Schedules)
            {
                var ids = assignments[entry.VesselScheduleId];
                var meta = Model.OpsMetaBySchedule.GetValueOrDefault(entry.VesselScheduleId);
                var reasons = Model.ConflictReasonsBySchedule.GetValueOrDefault(entry.VesselScheduleId) ?? [];
                var activeEntries = (entry.ServiceEntries ?? []).Where(e => !e.CancelledAt.HasValue).ToList();
                <div id="schedule-preview-@entry.VesselScheduleId" class="schedule-preview-source" hidden>
                    <div class="schedule-peek-header">
                        <div>
                            <span class="schedule-peek-ref">VS-@entry.VesselScheduleId</span>
                            <h3 class="schedule-peek-title">@entry.Vessel.VesselName</h3>
                            @if (!string.IsNullOrWhiteSpace(entry.VoyageNumber))
                            {
                                <span class="schedule-muted">Voyage @entry.VoyageNumber</span>
                            }
                        </div>
                        @if (meta != null)
                        {
                            <span class="modern-badge-sm @meta.StageBadgeClass">@meta.StageLabel</span>
                        }
                        else
                        {
                            <span class="schedule-status" data-status="@entry.Status">@MsapConstants.VesselScheduleStatus.GetDisplayName(entry.Status)</span>
                        }
                    </div>

                    @if (reasons.Count > 0)
                    {
                        <div class="schedule-peek-alert" role="status">
                            <span class="material-symbols-outlined" aria-hidden="true">warning</span>
                            <div>
                                <strong>Schedule Overlap</strong>
                                <ul>
                                    @foreach (var reason in reasons)
                                    {
                                        <li>@reason</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <dl class="schedule-peek-dl">
                        <dt>Customer</dt>
                        <dd>@(entry.Customer?.CustomerName ?? "Not recorded")</dd>
                        <dt>Planned window · Philippine time</dt>
                        <dd>
                            @if (entry.PlannedStart.Date == entry.PlannedEnd.Date)
                            {
                                @entry.PlannedStart.ToString("ddd, d MMM yyyy · HH:mm")<text> – </text>@entry.PlannedEnd.ToString("HH:mm")
                            }
                            else
                            {
                                @entry.PlannedStart.ToString("d MMM yyyy, HH:mm")<text> – </text>@entry.PlannedEnd.ToString("d MMM yyyy, HH:mm")
                            }
                        </dd>
                        <dt>Location</dt>
                        <dd>@entry.Port.PortName • @entry.Terminal.TerminalName</dd>
                        <dt>Customer Order Slip (COS)</dt>
                        <dd>
                            @if (entry.CustomerOrderSlip != null)
                            {
                                <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@entry.CustomerOrderSlipId" class="schedule-peek-link">@entry.CustomerOrderSlip.CustomerOrderSlipNumber</a>
                                @if (meta != null && meta.ActiveServiceCount > 0)
                                {
                                    <span class="schedule-muted"> · @meta.LoggedTicketCount/@meta.ActiveServiceCount Dispatch Tickets</span>
                                }
                            }
                            else
                            {
                                <span class="schedule-muted">No COS yet</span>
                            }
                        </dd>
                    </dl>

                    <div class="schedule-peek-section">
                        <h4>Assigned Tugboats &amp; Planned Services (@ids.Count/@entry.RequiredTugCount)</h4>
                        @if (ids.Count == 0)
                        {
                            <p class="schedule-muted">No tugboats assigned yet.</p>
                        }
                        else
                        {
                            <ul class="schedule-peek-tug-list">
                                @foreach (var id in ids)
                                {
                                    var tug = tugboats.GetValueOrDefault(id);
                                    var tugEntries = activeEntries.Where(e => e.TugboatId == id).ToList();
                                    var tugServices = tugEntries.Select(e => e.Service?.ServiceName ?? $"Service #{e.ServiceId}").ToList();
                                    <li>
                                        <div class="schedule-peek-tug-row">
                                            <strong>@(tug?.TugboatName ?? $"Unknown tug #{id}")</strong>
                                            @if (tug != null)
                                            {
                                                <span class="schedule-pill-badge">@(tug.IsCompanyOwned ? "Company" : "Subcon")</span>
                                            }
                                        </div>
                                        <div class="schedule-muted">
                                            @(tugServices.Count > 0 ? string.Join(", ", tugServices) : "No planned tug services")
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(entry.Notes))
                    {
                        <div class="schedule-peek-section">
                            <h4>Planning notes</h4>
                            <p class="schedule-note">@entry.Notes</p>
                        </div>
                    }

                    <div class="schedule-peek-actions">
                        <a asp-action="Details" asp-route-id="@entry.VesselScheduleId" asp-route-returnUrl="@currentBoardUrl" class="modern-btn-primary">
                            <span>Open Schedule</span>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                        </a>
                        @if (entry.CustomerOrderSlipId.HasValue)
                        {
                            <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@entry.CustomerOrderSlipId" class="modern-btn-secondary">Open COS</a>
                        }
                    </div>
                </div>
            }
        }
    </main>
</div>
@section Scripts {
    <script src="~/msap/js/vessel-schedule-calendar.js" asp-append-version="true"></script>
}
