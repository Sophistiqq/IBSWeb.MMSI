@using System.Security.Claims
@using IBS.Services.MSAP.AccessControl
@inject IAccessControlService AccessControl
@using System.Text.Json
@model VesselScheduleBoardViewModel
@{
    var accessUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    bool canCreateSchedule = accessUserId != null && await AccessControl.HasAccessAsync(accessUserId, ProcedureEnum.CreateCustomerOrderSlip);
    ViewData["Title"] = "Vessel schedules";
    ViewData["IsFullWidth"] = true;
    var month = Model.Date;
    var today = DateTimeHelper.GetCurrentPhilippineTime().Date;
    var gridStart = month.AddDays(-(int)month.DayOfWeek);
    var cellCount = ((int)month.DayOfWeek + DateTime.DaysInMonth(month.Year, month.Month) + 6) / 7 * 7;
    var monthSchedules = Model.Schedules.Where(s => s.PlannedStart < month.AddMonths(1) && s.PlannedEnd > month).ToList();
    var tugboats = Model.Tugboats.ToDictionary(t => t.TugboatId);
    var assignments = Model.Schedules.ToDictionary(s => s.VesselScheduleId,
        s => (JsonSerializer.Deserialize<List<int>>(s.AssignedTugboatIds ?? "[]") ?? new List<int>()).Distinct().ToList());
    var isListView = string.Equals(Model.ViewMode, "list", StringComparison.OrdinalIgnoreCase);
    var filters = new Dictionary<string, string>
    {
        ["portId"] = Model.PortId?.ToString() ?? "",
        ["terminalId"] = Model.TerminalId?.ToString() ?? "",
        ["search"] = Model.Search ?? "",
        ["status"] = Model.Status ?? "",
        ["view"] = Model.ViewMode
    };
    var statuses = new[] { MsapConstants.VesselScheduleStatus.Tentative, MsapConstants.VesselScheduleStatus.Confirmed,
        MsapConstants.VesselScheduleStatus.Completed, MsapConstants.VesselScheduleStatus.Cancelled };
    var otherMonthMatches = !isListView && !string.IsNullOrWhiteSpace(Model.Search)
        ? Model.AllMatchingSchedules.Where(s => s.PlannedStart >= month.AddMonths(1) || s.PlannedEnd <= month).ToList()
        : new List<VesselSchedule>();
    var activeFilterCount = (Model.PortId.HasValue ? 1 : 0)
        + (Model.TerminalId.HasValue ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(Model.Status) ? 1 : 0);
    var hasAnyFilter = activeFilterCount > 0 || !string.IsNullOrWhiteSpace(Model.Search);
    var rangeStart = (Model.SelectedDate ?? today).Date;
    var rangeEnd = (Model.SelectedEndDate ?? rangeStart).Date;
    var hasRange = rangeEnd > rangeStart;
    var rangeDays = (rangeEnd - rangeStart).Days + 1;
}
<link rel="stylesheet" href="~/msap/css/vessel-schedule.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/vessel-calendar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<div class="modern-layout schedule-calendar-layout app-ui">
    <main class="modern-container schedule-workspace schedule-calendar-workspace ui-page">
        <div class="flex-stack ui-page-toolbar schedule-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb">
                    <ol class="ui-breadcrumb">
                        <li><a asp-controller="Home" asp-action="Index">MSAP</a></li>
                        <li aria-current="page">Vessel schedules</li>
                    </ol>
                </nav>
                <h1 class="modern-headline-lg ui-page-title" data-page-header>Vessel schedules</h1>
            </div>
            <div class="flex flex-wrap items-center gap-2 ui-actions">
                <div class="schedule-view-switch" role="group" aria-label="View mode">
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "calendar" })" asp-route-month="@month.ToString("yyyy-MM")" asp-route-date="@rangeStart.ToString("yyyy-MM-dd")" asp-route-endDate="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null)" class="modern-btn-secondary @(!isListView ? "active" : "")" aria-current="@(!isListView ? "page" : null)" aria-label="Calendar view" title="Calendar view">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span><span class="schedule-view-label">Calendar</span>
                    </a>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list" })" asp-route-month="@month.ToString("yyyy-MM")" class="modern-btn-secondary @(isListView ? "active" : "")" aria-current="@(isListView ? "page" : null)" aria-label="List view" title="List view">
                        <span class="material-symbols-outlined" aria-hidden="true">view_list</span><span class="schedule-view-label">List</span>
                    </a>
                </div>
                @if (canCreateSchedule)
                {
                    <a asp-action="Create" asp-route-date="@rangeStart.ToString("yyyy-MM-dd")" class="modern-btn-primary ui-page-action" data-hotkey="c">
                        <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                        New schedule
                    </a>
                }
            </div>
        </div>

        @if (!isListView && otherMonthMatches.Count > 0)
        {
            <section class="modern-card ui-card" aria-label="Cross-month search matches">
                <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">manage_search</span>
                        <h2 class="modern-headline-md ui-section-title">
                            Found @Model.AllMatchingTotalCount matching schedule@(Model.AllMatchingTotalCount == 1 ? "" : "s") across all months (@monthSchedules.Count in @month.ToString("MMMM yyyy"))
                        </h2>
                    </div>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list" })" class="modern-btn-secondary">
                        View all in List →
                    </a>
                </div>
                <div class="modern-card-body ui-card-body">
                    <div class="flex flex-wrap gap-2">
                        @foreach (var match in otherMonthMatches.Take(6))
                        {
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "calendar" })"
                               asp-route-month="@match.PlannedStart.ToString("yyyy-MM")"
                               asp-route-date="@match.PlannedStart.ToString("yyyy-MM-dd")"
                               class="modern-btn-secondary" style="font-size: 0.8rem; padding: 0.35rem 0.65rem;">
                                <strong>@match.PlannedStart.ToString("dd MMM yyyy")</strong> · @match.Vessel.VesselName@(match.CustomerOrderSlip != null ? $" ({match.CustomerOrderSlip.CustomerOrderSlipNumber})" : "")
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        @if (isListView)
        {
            <!-- Status Filter Tabs (matches MSAP index pages) -->
            <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by status">
                <a asp-action="Index"
                   asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list", ["status"] = "" })"
                   asp-route-month="@month.ToString("yyyy-MM")"
                   class="modern-btn-secondary @(string.IsNullOrWhiteSpace(Model.Status) ? "active" : "")">ALL</a>
                @foreach (var status in statuses)
                {
                    var isActiveStatus = string.Equals(Model.Status, status, StringComparison.OrdinalIgnoreCase);
                    <a asp-action="Index"
                       asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "list", ["status"] = status })"
                       asp-route-month="@month.ToString("yyyy-MM")"
                       class="modern-btn-secondary @(isActiveStatus ? "active" : "")">@MsapConstants.VesselScheduleStatus.GetDisplayName(status).ToUpperInvariant()</a>
                }
            </div>

            <section class="modern-card ui-card" aria-label="All matching schedules">
                <div class="modern-card-header-action flex flex-wrap justify-between items-center gap-2 w-full ui-card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">view_list</span>
                        <h2 class="modern-headline-md ui-section-title">All Schedules</h2>
                        <span class="ui-caption ui-muted">
                            (@(Model.AllMatchingTotalCount > Model.AllMatchingSchedules.Count
                                ? $"latest {Model.AllMatchingSchedules.Count} of {Model.AllMatchingTotalCount}"
                                : $"{Model.AllMatchingTotalCount}"))
                        </span>
                    </div>
                    <form method="get" id="calendarFilters" class="flex flex-wrap items-center gap-2 schedule-list-filters">
                        <input type="hidden" name="view" value="list" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <div class="schedule-list-filter-field">
                            <select asp-for="PortId" asp-items="Model.Ports" id="calendarPort" class="js-modern-select" data-placeholder="All ports" aria-label="Filter by port">
                                <option value="">-- All ports --</option>
                            </select>
                        </div>
                        <div class="schedule-list-filter-field">
                            <select asp-for="TerminalId" asp-items="Model.Terminals" id="calendarTerminal" class="js-modern-select" data-placeholder="All terminals" aria-label="Filter by terminal">
                                <option value="">-- All terminals --</option>
                            </select>
                        </div>
                        @if (hasAnyFilter)
                        {
                            <a asp-action="Index" asp-route-month="@month.ToString("yyyy-MM")" asp-route-view="list" class="modern-btn-secondary" title="Reset all filters">
                                <span class="material-symbols-outlined" style="font-size: 16px;" aria-hidden="true">filter_alt_off</span>
                                Reset
                            </a>
                        }
                    </form>
                </div>
                <div class="modern-card-body ui-card-body">
                    <table class="modern-table ui-table" id="vesselSchedulesTable">
                        <thead>
                            <tr>
                                <th>Planned Window</th>
                                <th>Booking / COS #</th>
                                <th>Vessel / Voyage</th>
                                <th>Customer</th>
                                <th>Port - Terminal</th>
                                <th class="text-center">Tugs</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AllMatchingSchedules)
                            {
                                var itemTugs = (JsonSerializer.Deserialize<List<int>>(item.AssignedTugboatIds ?? "[]") ?? new List<int>()).Distinct().ToList();
                                var customerName = item.Customer?.CustomerName ?? "Not recorded";
                                var portTerminal = $"{item.Port.PortName} - {item.Terminal.TerminalName}";
                                <tr class="@(item.Status == MsapConstants.VesselScheduleStatus.Cancelled ? "schedule-cancelled" : "")">
                                    <td data-order="@item.PlannedStart.ToString("O")">
                                        <strong>@item.PlannedStart.ToString("dd MMM yyyy, HH:mm")</strong>
                                        <div class="text-xs ui-muted">to @(item.PlannedEnd.Date == item.PlannedStart.Date ? item.PlannedEnd.ToString("HH:mm") : item.PlannedEnd.ToString("dd MMM yyyy, HH:mm"))</div>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.VesselScheduleId" class="font-bold" style="text-decoration:none; color: var(--primary)">Booking #@item.VesselScheduleId</a>
                                        @if (item.CustomerOrderSlip != null)
                                        {
                                            <div class="text-xs">
                                                <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@item.CustomerOrderSlipId" style="text-decoration:none; color: var(--primary)">@item.CustomerOrderSlip.CustomerOrderSlipNumber</a>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong class="uppercase">@item.Vessel.VesselName</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.VoyageNumber))
                                        {
                                            <div class="text-xs ui-muted">Voyage: @item.VoyageNumber</div>
                                        }
                                    </td>
                                    <td>
                                        <div style="max-width: 210px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@customerName">@customerName</div>
                                    </td>
                                    <td>
                                        <div style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@portTerminal">@portTerminal</div>
                                    </td>
                                    <td class="text-center">@itemTugs.Count / @item.RequiredTugCount</td>
                                    <td class="text-center"><span class="schedule-status" data-status="@item.Status">@MsapConstants.VesselScheduleStatus.GetDisplayName(item.Status)</span></td>
                                    <td class="text-center">
                                        <div class="flex justify-center gap-2">
                                            <a asp-action="Details" asp-route-id="@item.VesselScheduleId" class="modern-btn-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.55rem;">Open</a>
                                            <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters) { ["view"] = "calendar" })" asp-route-month="@item.PlannedStart.ToString("yyyy-MM")" asp-route-date="@item.PlannedStart.ToString("yyyy-MM-dd")" class="modern-btn-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.55rem;" title="Jump to calendar date">
                                                <span class="material-symbols-outlined" style="font-size: 16px;" aria-hidden="true">calendar_month</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
        <div class="schedule-calendar-split">
            <div class="schedule-sidebar">
                <div class="schedule-sidebar-search">
                    <div class="schedule-toolbar-search">
                        <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        <input name="search"
                               id="calendarSearch"
                               form="calendarFilters"
                               type="search"
                               value="@Model.Search"
                               maxlength="120"
                               class="modern-input"
                               placeholder="Search vessel, COS #, tug..."
                               aria-label="Find schedule" />
                    </div>
                    <button type="button"
                            id="scheduleFiltersToggle"
                            class="modern-btn-secondary schedule-mobile-filter-btn @(activeFilterCount > 0 ? "active" : "")"
                            aria-expanded="false"
                            aria-controls="calendarFilters">
                        <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                        <span>Filters</span>
                        @if (activeFilterCount > 0)
                        {
                            <span class="schedule-filter-badge">@activeFilterCount</span>
                        }
                    </button>
                </div>

                <section class="modern-card schedule-month" aria-label="Monthly calendar" data-selected-start="@rangeStart.ToString("yyyy-MM-dd")" data-selected-end="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : "")" data-range-active="@(hasRange ? "true" : "false")">
                    <div class="schedule-cal-header">
                        <div class="schedule-cal-nav">
                            @if (month.Year > 1900 || month.Month > 1)
                            {
                                <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters))" asp-route-month="@month.AddMonths(-1).ToString("yyyy-MM")" asp-route-date="@month.AddMonths(-1).ToString("yyyy-MM-dd")" class="schedule-cal-step" aria-label="Previous month">
                                    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                                </a>
                            }
                            <div class="schedule-month-picker-wrap">
                                <button type="button" class="schedule-month-btn" id="calendarMonthBtn" aria-label="Choose month and year">
                                    <span>@month.ToString("MMMM yyyy")</span>
                                    <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                                </button>
                                <input type="month"
                                       id="calendarMonth"
                                       name="month"
                                       form="calendarFilters"
                                       class="schedule-month-native"
                                       aria-label="Jump to month"
                                       min="1900-01"
                                       max="9998-12"
                                       value="@month.ToString("yyyy-MM")" />
                            </div>
                            @if (month.Year < 9998 || month.Month < 12)
                            {
                                <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(filters))" asp-route-month="@month.AddMonths(1).ToString("yyyy-MM")" asp-route-date="@month.AddMonths(1).ToString("yyyy-MM-dd")" class="schedule-cal-step" aria-label="Next month">
                                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                                </a>
                            }
                        </div>
                        <a asp-action="Index"
                           asp-all-route-data="@(new Dictionary<string, string>(filters))"
                           asp-route-month="@today.ToString("yyyy-MM")"
                           asp-route-date="@today.ToString("yyyy-MM-dd")"
                           class="schedule-today-btn @(!hasRange && rangeStart == today ? "is-current" : "")">Today</a>
                    </div>

                    <div class="schedule-range-bar" aria-label="Selection mode">
                        <div class="schedule-mode-pills" role="group" aria-label="Day or range selection">
                            <button type="button" id="rangeModeDay" class="schedule-mode-pill @(!hasRange ? "active" : "")" data-range-mode="day" aria-pressed="@(!hasRange ? "true" : "false")">Day</button>
                            <button type="button" id="rangeModeRange" class="schedule-mode-pill @(hasRange ? "active" : "")" data-range-mode="range" aria-pressed="@(hasRange ? "true" : "false")">Range</button>
                        </div>
                        <div class="schedule-range-presets">
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters))"
                               asp-route-month="@month.ToString("yyyy-MM")"
                               asp-route-date="@rangeStart.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@rangeStart.AddDays(2).ToString("yyyy-MM-dd")"
                               class="schedule-preset-pill @(hasRange && rangeDays == 3 ? "active" : "")"
                               title="View 3 days from selected date">3d</a>
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters))"
                               asp-route-month="@month.ToString("yyyy-MM")"
                               asp-route-date="@rangeStart.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@rangeStart.AddDays(6).ToString("yyyy-MM-dd")"
                               class="schedule-preset-pill @(hasRange && rangeDays == 7 ? "active" : "")"
                               title="View 7 days from selected date">7d</a>
                        </div>
                        <div class="schedule-range-status" id="rangePickerStatus" hidden>
                            <span class="schedule-range-hint" id="rangePickerHint">Pick start date…</span>
                            <button type="button" class="schedule-range-cancel" id="rangeCancelBtn" hidden>Cancel</button>
                        </div>
                    </div>

                    <div class="schedule-calendar" aria-label="@month.ToString("MMMM yyyy") vessel schedules">
                        @foreach (var name in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <div class="schedule-weekday">@name</div> }
                        @for (var i = 0; i < cellCount; i++)
                        {
                            var day = gridStart.AddDays(i);
                            var entries = Model.Schedules.Where(s => s.PlannedStart < day.AddDays(1) && s.PlannedEnd > day).ToList();
                            var conflicts = Model.ConflictsByDay.GetValueOrDefault(day) ?? new HashSet<int>();
                            var hasConflict = entries.Any(s => conflicts.Contains(s.VesselScheduleId));
                            var isSelectedSingle = !hasRange && day == rangeStart;
                            var isRangeStart = hasRange && day == rangeStart;
                            var isRangeEnd = hasRange && day == rangeEnd;
                            var isInRange = hasRange && day > rangeStart && day < rangeEnd;
                            var tileClasses = string.Join(" ", new[]
                            {
                                "schedule-day",
                                day.Month != month.Month ? "schedule-outside" : "",
                                day == today ? "schedule-today" : "",
                                isSelectedSingle ? "schedule-selected-day" : "",
                                isRangeStart ? "schedule-range-start" : "",
                                isRangeEnd ? "schedule-range-end" : "",
                                isInRange ? "schedule-in-range" : "",
                                entries.Count > 0 ? "has-entries" : ""
                            }.Where(c => !string.IsNullOrEmpty(c)));
                            <a asp-action="Index"
                               asp-all-route-data="@(new Dictionary<string, string>(filters))"
                               asp-route-month="@day.ToString("yyyy-MM")"
                               asp-route-date="@day.ToString("yyyy-MM-dd")"
                               class="@tileClasses"
                               data-calendar-day="@day.ToString("yyyy-MM-dd")"
                               aria-label="@day.ToString("MMMM d, yyyy"), @entries.Count schedule@(entries.Count == 1 ? "" : "s")@(hasConflict ? ", overlap" : "")"
                               aria-current="@(isSelectedSingle || isRangeStart ? "date" : null)">
                                <span class="schedule-day-top">
                                    <span class="schedule-day-number">@day.Day</span>
                                    @if (hasConflict)
                                    {
                                        <span class="schedule-day-conflict" title="Overlap needs review">⚠</span>
                                    }
                                </span>
                                <span class="schedule-day-indicators" aria-hidden="true">
                                    @if (entries.Count > 0)
                                    {
                                        @foreach (var entry in entries.Take(3))
                                        {
                                            <span class="schedule-dot" data-status="@entry.Status"></span>
                                        }
                                        @if (entries.Count > 3)
                                        {
                                            <span class="schedule-day-count">+@(entries.Count - 3)</span>
                                        }
                                    }
                                </span>
                            </a>
                        }
                    </div>
                    <footer class="schedule-calendar-footer">
                        <span>@monthSchedules.Count schedule@(monthSchedules.Count == 1 ? "" : "s") in @month.ToString("MMM yyyy")</span>
                    </footer>
                </section>

                <form method="get" class="modern-card schedule-sidebar-filters" id="calendarFilters" aria-label="Calendar filters">
                    <input type="hidden" name="view" value="calendar" />
                    <input type="hidden" name="date" value="@rangeStart.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="endDate" value="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : "")" />
                    <div class="schedule-sidebar-filters-header">
                        <span class="schedule-sidebar-filters-title">
                            <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                            Filters
                        </span>
                        @if (hasAnyFilter)
                        {
                            <a asp-action="Index" asp-route-month="@month.ToString("yyyy-MM")" asp-route-date="@rangeStart.ToString("yyyy-MM-dd")" asp-route-endDate="@(hasRange ? rangeEnd.ToString("yyyy-MM-dd") : null)" asp-route-view="calendar" class="schedule-active-clear">Reset</a>
                        }
                    </div>
                    <div class="schedule-sidebar-filters-body">
                        <label for="calendarPort">Port<select asp-for="PortId" asp-items="Model.Ports" id="calendarPort" class="js-modern-select" data-placeholder="All ports"><option value="">-- All ports --</option></select></label>
                        <label for="calendarTerminal">Terminal<select asp-for="TerminalId" asp-items="Model.Terminals" id="calendarTerminal" class="js-modern-select" data-placeholder="All terminals"><option value="">-- All terminals --</option></select></label>
                        <label for="calendarStatus">Status<select asp-for="Status" id="calendarStatus" class="js-modern-select" data-placeholder="All statuses" data-searchable="false"><option value="">-- All statuses --</option>@foreach (var status in statuses) { <option value="@status">@MsapConstants.VesselScheduleStatus.GetDisplayName(status)</option> }</select></label>
                    </div>
                </form>
            </div>
            <partial name="_CalendarDayPanel" model="Model" />
        </div>
        @foreach (var entry in Model.Schedules)
        {
            var ids = assignments[entry.VesselScheduleId];
            <div id="schedule-preview-@entry.VesselScheduleId" class="schedule-vessel-preview" popover="auto" role="dialog" aria-label="@entry.Vessel.VesselName booking preview">
                <div class="schedule-panel-heading">
                    <h2>@entry.Vessel.VesselName</h2>
                    <button type="button" class="schedule-icon-button" popovertarget="schedule-preview-@entry.VesselScheduleId" popovertargetaction="hide" aria-label="Close preview">×</button>
                </div>
                <div class="schedule-preview-state">
                    <span>@MsapConstants.VesselScheduleStatus.GetDisplayName(entry.Status)</span>
                    @if (entry.CustomerOrderSlip != null)
                    {
                        <small><a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@entry.CustomerOrderSlipId" style="color: var(--primary); font-weight: 600;">@entry.CustomerOrderSlip.CustomerOrderSlipNumber</a></small>
                    }
                    else
                    {
                        <small>No COS yet</small>
                    }
                </div>
                <dl>
                    <dt>Customer</dt>
                    <dd>@(entry.Customer?.CustomerName ?? "Not recorded")</dd>
                    <dt>Planned window · Philippine time</dt>
                    <dd>
                        @if (entry.PlannedStart.Date == entry.PlannedEnd.Date)
                        {
                            @entry.PlannedStart.ToString("d MMM yyyy, HH:mm")<text> – </text>@entry.PlannedEnd.ToString("HH:mm")
                        }
                        else
                        {
                            @entry.PlannedStart.ToString("d MMM yyyy, HH:mm")<text> – </text>@entry.PlannedEnd.ToString("d MMM yyyy, HH:mm")
                        }
                    </dd>
                    <dt>Location</dt>
                    <dd>@entry.Port.PortName / @entry.Terminal.TerminalName</dd>
                </dl>
                <section class="schedule-preview-tugs" aria-label="Assigned tugboats">
                    <h3>Assigned tugboats · @ids.Count of @entry.RequiredTugCount</h3>
                    <ul>
                        @foreach (int id in ids)
                        {
                            var tug = tugboats.GetValueOrDefault(id);
                            <li><strong>@(tug?.TugboatName ?? $"Unknown tug #{id}")</strong>@if (tug != null) { <text> · @(tug.IsCompanyOwned ? "Company-owned" : "Subcontractor")</text> }</li>
                        }
                    </ul>
                    @if (ids.Count == 0) { <p class="schedule-muted">No tugboats assigned.</p> }
                </section>
                @if (!string.IsNullOrWhiteSpace(entry.Notes)) { <p class="schedule-note">@entry.Notes</p> }
                <a asp-action="Details" asp-route-id="@entry.VesselScheduleId" class="schedule-preview-open">Open booking / COS →</a>
            </div>
        }
        }
    </main>
</div>
@section Scripts {
    <script src="~/msap/js/vessel-schedule-calendar.js" asp-append-version="true"></script>
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '.schedule-page-toolbar', title: 'Vessel schedules', text: 'Switch between Calendar and List view or create a new schedule.', interactive: false },
            { selector: '.schedule-cal-header', title: 'Browse months', text: 'Step between months, click the month name to jump, or return to Today.', interactive: false },
            { selector: '.schedule-range-bar', title: 'Single day or date range', text: 'Switch between Day and Range mode, or use 3d / 7d presets to inspect schedules and tugboat availability across multiple days.', interactive: false },
            { selector: '.schedule-day-panel', title: 'Schedules & tug bookings', text: 'Review detailed booking cards and tugboat availability for the selected date or range. Hover a vessel on desktop for a quick preview.', interactive: false }
        ];
    </script>
}
