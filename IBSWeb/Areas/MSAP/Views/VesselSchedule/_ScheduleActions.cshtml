@model VesselSchedule
@{
    var closed = Model.Status is MsapConstants.VesselScheduleStatus.Completed or MsapConstants.VesselScheduleStatus.Cancelled;
}
@if (!closed && ViewBag.CanEdit == true && ViewBag.CanComplete == true)
{
    <div class="schedule-action-item wf-stack">
        <h3 class="wf-label">Finish vessel service</h3>
        <p class="wf-body wf-muted">All recorded services have actual end times. Complete service when no more Dispatch Tickets are expected. Billing and collection continue separately.</p>
        <form asp-action="Complete" method="post" data-schedule-action="Complete">
            <input type="hidden" name="id" value="@Model.VesselScheduleId" />
            <button type="submit" class="modern-btn-secondary"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span> Complete Service</button>
        </form>
    </div>
}
<details class="wf-stack">
    <summary>Show other actions</summary>
    @if (!closed && ViewBag.CanEdit == true)
    {
        @if (ViewBag.CanRevise == true)
        {
            <div class="schedule-action-item wf-stack">
                <h3 class="wf-label">Adjust the booking</h3><p class="wf-body wf-muted">Editing the schedule returns it to Tentative for review and reapproval while preserving the COS. Bookings with actual tickets or billing cannot be revised.</p>
                <a asp-action="Edit" asp-route-id="@Model.VesselScheduleId" class="modern-btn-secondary"><span class="material-symbols-outlined" aria-hidden="true">edit_calendar</span> Revise Schedule</a>
            </div>
        }
        <div class="schedule-action-item schedule-action-cancel">
            @if (ViewBag.CanCancel != true)
            {
                <h3 class="wf-label">Cancellation unavailable</h3><p class="wf-body wf-muted">Resolve active Dispatch Tickets and billing before cancelling this schedule.</p>
            }
            else
            {
                <h3 class="wf-label">Cancel this booking</h3><p class="wf-body wf-muted">@(Model.CustomerOrderSlipId.HasValue ? "Cancels the schedule and its COS together. Records are retained." : "Release the tug bookings and keep this plan on record.")</p>
                <form asp-action="Cancel" method="post" data-schedule-action="Cancel">
                    <input type="hidden" name="id" value="@Model.VesselScheduleId" />
                    <button type="submit" class="modern-btn-error"><span class="material-symbols-outlined" aria-hidden="true">event_busy</span> Cancel Booking</button>
                </form>
            }
        </div>
    }
    @if (closed)
    {
        <p class="wf-body wf-muted">@(Model.Status == MsapConstants.VesselScheduleStatus.Completed ? "Service is completed. Tariff, approval, billing, posting and collection can continue." : "This booking is cancelled. Schedule changes are no longer available.")</p>
    }
    @if (ViewBag.CanEdit == true && Model.Status == MsapConstants.VesselScheduleStatus.Tentative && Model.CustomerOrderSlipId == null)
    {
        <details class="schedule-delete-option">
            <summary>Created by mistake?</summary>
            <p class="wf-body wf-muted">Delete this tentative plan permanently, or cancel it to keep the record.</p>
            <form asp-action="Delete" method="post" id="deleteSchedule">
                <input type="hidden" name="id" value="@Model.VesselScheduleId" />
                <button type="button" id="deleteScheduleButton" class="modern-btn-error"><span class="material-symbols-outlined" aria-hidden="true">delete</span> Delete tentative schedule</button>
            </form>
        </details>
    }
</details>
