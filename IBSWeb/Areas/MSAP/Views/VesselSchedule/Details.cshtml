@model VesselSchedule
@{
    var closed = Model.Status is MsapConstants.VesselScheduleStatus.Completed or MsapConstants.VesselScheduleStatus.Cancelled;
    var pending = !closed && (!Model.CustomerOrderSlipId.HasValue || Model.ApprovedRevision != Model.Revision || Model.Status == MsapConstants.VesselScheduleStatus.Tentative);
    var canApprove = pending && ViewBag.CanConfirm == true;
    bool canViewRates = ViewBag.CanConfirm == true || ViewBag.CanManageRates == true;
    var rateSetup = (object?)ViewBag.RateSetup as ScheduleRateSetupViewModel;
    var reapproval = Model.ApprovedRevision.HasValue;
    ViewData["Title"] = pending ? "Review schedule" : "Schedule details";
    ViewData["IsFullWidth"] = true;
    ViewData["BookingProgressReview"] = pending;
    var tugs = ViewBag.AssignedTugboatModels as List<Tugboat> ?? new List<Tugboat>();
    var isIoc = Model.IsIoc ?? Model.Terminal.IsIoc;
    var iocOverride = isIoc != Model.Terminal.IsIoc;
    var defaultDiscount = Model.Customer?.DefaultCosDiscountPercent ?? 0;
    var appliedDiscount = Model.SkipCosDiscount ? 0 : Model.CosDiscountPercent.GetValueOrDefault();
    var discountOverride = appliedDiscount != defaultDiscount;
    var subicPort = Model.Port.PortName.Trim().Equals("Subic", StringComparison.OrdinalIgnoreCase)
        || Model.Port.PortName.Trim().StartsWith("Subic ", StringComparison.OrdinalIgnoreCase);
    var sbmaOverride = Model.SbmaEnabled != subicPort;
    var manualEntries = Model.ServiceEntries.Where(entry => entry.ManualTariffRate.HasValue || entry.ManualBafRate.HasValue).ToList();
    var captures = ViewBag.RateCaptures as List<ScheduleRateCaptureViewModel> ?? new List<ScheduleRateCaptureViewModel>();
    var revisionChanges = (ViewBag.RevisionChanges as List<MsapFieldChange> ?? new List<MsapFieldChange>())
        .GroupBy(c => c.Field, StringComparer.Ordinal)
        .ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);
    var addedTugboatIds = ViewBag.AddedTugboatIds as HashSet<int> ?? new HashSet<int>();
    var addedEntryIds = ViewBag.AddedServiceEntryIds as HashSet<int> ?? new HashSet<int>();
    var hasRevisionChanges = pending && reapproval && revisionChanges.Count > 0;
}
<link rel="stylesheet" href="~/msap/css/vessel-schedule.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<div class="modern-layout schedule-screen-layout app-ui">
    <partial name="_WorkflowProgress" model="(JobProgressViewModel)ViewBag.JobProgress" />
    <main class="modern-container ui-page schedule-main-workspace schedule-review-workspace" id="scheduleReview"
          data-schedule-id="@Model.VesselScheduleId"
          data-adopt-url="@(ViewBag.CanAdoptTableRate == true ? Url.Action("AdoptTableRate") : "")"
          data-rate-url="@(canViewRates ? Url.Action("GetTariffRate") : "")" data-customer-id="@Model.CustomerId"
          data-terminal-id="@Model.TerminalId" data-planned-start="@Model.PlannedStart.ToString("yyyy-MM-ddTHH:mm")">
        <header class="schedule-header-stack ui-page-header">
            <nav aria-label="Breadcrumb">
                <ol class="ui-breadcrumb">
                    <li><a asp-action="Index">Vessel schedules</a></li>
                    <li aria-current="page">Booking #@Model.VesselScheduleId</li>
                </ol>
            </nav>
            <h1 class="ui-page-title" data-page-header>@(pending ? reapproval ? "Review schedule changes" : "Review schedule" : "Schedule details")</h1>
            <div class="schedule-details-header-actions">
                @if (Model.CustomerOrderSlipId.HasValue)
                {
                    <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" class="modern-btn-secondary ui-page-action">Open COS</a>
                }
                @if (pending && !Model.CustomerOrderSlipId.HasValue && Model.ServiceEntries.Count > 0 && ViewBag.CanRecordTicket == true)
                {
                    <form asp-action="UrgentEntry" asp-route-id="@Model.VesselScheduleId" method="post">
                        <button type="submit" class="modern-btn-secondary ui-page-action">Record urgent service</button>
                    </form>
                }
                @if (Model.Revision > 1 || hasRevisionChanges)
                {
                    <a asp-action="Revisions" asp-route-id="@Model.VesselScheduleId" class="modern-btn-secondary ui-page-action">Revision history</a>
                }
                <a asp-action="Index" asp-route-status="@(pending ? MsapConstants.VesselScheduleStatus.Tentative : null)" asp-route-date="@Model.PlannedStart.ToString("yyyy-MM-dd")" class="modern-btn-secondary ui-page-action" data-ui-back>Back</a>
            </div>
            <p class="ui-body ui-muted ui-page-description">@(canViewRates ? (pending ? "Review the booking, service rates and commercial terms before approval." : "Booking details, service requirements and commercial terms.") : "Booking details, assigned tugboats and expected services.")</p>
            <div class="schedule-status-banner ui-page-description">
                <span class="schedule-status-pill ui-status @(pending ? "ui-attention" : "")">@(pending ? reapproval ? "Pending reapproval" : "Pending review" : MsapConstants.VesselScheduleStatus.GetDisplayName(Model.Status))</span>
                <span class="ui-body ui-muted">Booking #@Model.VesselScheduleId@if (Model.Revision > 1) {<text> · Revision @Model.Revision</text>}</span>
            </div>
        </header>
        <div class="schedule-review-content ui-stack">
            <section class="ui-panel ui-panel--compact ui-stack" aria-labelledby="reviewBookingTitle">
                <h2 class="ui-section-title" id="reviewBookingTitle">Booking details</h2>
                @if (hasRevisionChanges)
                {
                    <p class="ui-panel ui-body ui-attention">
                        <strong>Revised for reapproval:</strong>
                        @string.Join(" · ", revisionChanges.Values.Select(c => string.IsNullOrWhiteSpace(c.Before) ? $"{c.Label}: {c.After}" : $"{c.Label}: {c.Before} → {c.After}"))
                        <a asp-action="Revisions" asp-route-id="@Model.VesselScheduleId" class="ms-2 font-semibold underline">View full revision comparison →</a>
                    </p>
                }
                <dl class="schedule-review-fields schedule-review-booking-fields">
                    @{
                        revisionChanges.TryGetValue(nameof(VesselSchedule.CustomerId), out var customerChange);
                        revisionChanges.TryGetValue(nameof(VesselSchedule.VesselId), out var vesselChange);
                        revisionChanges.TryGetValue(nameof(VesselSchedule.PortId), out var portChange);
                        revisionChanges.TryGetValue(nameof(VesselSchedule.TerminalId), out var terminalChange);
                        revisionChanges.TryGetValue(nameof(VesselSchedule.VoyageNumber), out var voyageChange);
                        revisionChanges.TryGetValue(nameof(VesselSchedule.PlannedStart), out var plannedStartChange);
                        revisionChanges.TryGetValue(nameof(VesselSchedule.PlannedEnd), out var plannedEndChange);
                        string? RevisionUrl(MsapFieldChange? change) => hasRevisionChanges && change != null
                            ? Url.Action("Revisions", new { id = Model.VesselScheduleId, field = change.Field })
                            : null;
                    }
                    @foreach (var field in new[]
                    {
                        (Label: "Customer", Value: Model.Customer?.CustomerName ?? "Not selected", Change: customerChange),
                        (Label: "Vessel", Value: Model.Vessel.VesselName, Change: vesselChange),
                        (Label: "Port", Value: Model.Port.PortName, Change: portChange),
                        (Label: "Terminal", Value: Model.Terminal.TerminalName, Change: terminalChange),
                        (Label: "Voyage number", Value: Model.VoyageNumber ?? "—", Change: voyageChange),
                        (Label: "Planned start · Philippine time", Value: Model.PlannedStart.ToString("dd MMM yyyy, HH:mm"), Change: plannedStartChange),
                        (Label: "Planned end · Philippine time", Value: Model.PlannedEnd.ToString("dd MMM yyyy, HH:mm"), Change: plannedEndChange)
                    })
                    {
                        var url = RevisionUrl(field.Change);
                        if (url != null)
                        {
                            <a href="@url" class="schedule-review-attention schedule-revision-link" title="View revision history for @field.Label">
                                <dt class="ui-caption ui-muted">@field.Label</dt>
                                <dd class="ui-value">@field.Value</dd>
                                <small class="ui-caption">Revised from @field.Change!.Before · Compare →</small>
                            </a>
                        }
                        else
                        {
                            <div>
                                <dt class="ui-caption ui-muted">@field.Label</dt>
                                <dd class="ui-value">@field.Value</dd>
                            </div>
                        }
                    }
                </dl>
            </section>
            <section class="ui-panel ui-panel--compact ui-stack" aria-labelledby="reviewCommercialTitle">
                <h2 class="ui-section-title" id="reviewCommercialTitle">@(canViewRates ? "Commercial settings" : "Operational classification")</h2>
                <dl class="schedule-review-fields schedule-review-commercial-fields">
                    @if (canViewRates)
                    {
                        <div class="@(discountOverride ? "schedule-review-attention" : "")">
                            <dt class="ui-caption ui-muted">Customer discount</dt>
                            <dd class="ui-value">@appliedDiscount.ToString("0.####")%</dd>
                            <small class="ui-caption">@(discountOverride ? appliedDiscount == 0 ? $"Skipped customer default of {defaultDiscount:0.####}%." : $"Overrides customer default of {defaultDiscount:0.####}%." : "Customer default.")</small>
                        </div>
                    }
                    <div class="@(iocOverride ? "schedule-review-attention" : "")">
                        <dt class="ui-caption ui-muted">IOC / Non-IOC</dt>
                        <dd class="ui-value">@(isIoc ? "IOC · Insular Oil Corporation" : "Non-IOC")</dd>
                        <small class="ui-caption">@(iocOverride ? $"Overrides terminal default ({(Model.Terminal.IsIoc ? "IOC" : "Non-IOC")})." : "Terminal default.")</small>
                    </div>
                    <div class="@(sbmaOverride ? "schedule-review-attention" : "")">
                        <dt class="ui-caption ui-muted">SBMA share · Subic Bay Metropolitan Authority</dt>
                        <dd class="ui-value">@(Model.SbmaEnabled ? "Enabled for all tugs" : "Disabled")</dd>
                        <small class="ui-caption">@(sbmaOverride ? $"Overrides port default ({(subicPort ? "enabled for Subic" : "disabled outside Subic")})." : subicPort ? "Subic port default." : "Port default.")</small>
                    </div>
                </dl>
            </section>
            <section class="ui-stack" aria-labelledby="reviewServicesTitle">
                <div class="schedule-section-header">
                    <div class="ui-field">
                        <h2 class="ui-section-title" id="reviewServicesTitle">Tugboats &amp; services</h2>
                        <p class="ui-caption ui-muted">@(canViewRates ? "Table rates use the planned date. Final rates use actual service start; actual ticket details are recorded after service." : "Assigned tugboats and expected services for this booking. Actual ticket details are recorded after service.")</p>
                    </div>
                    @if (canViewRates && ViewBag.CanManageRates == true && !closed)
                    {
                        int pendingRateCount = rateSetup?.PendingCount ?? 0;
                        int awaitingRateCount = rateSetup?.AwaitingApprovalCount ?? 0;
                        bool hasRateAttention = pendingRateCount > 0 || awaitingRateCount > 0;
                        <a asp-controller="RateUpload" asp-action="Editor" asp-route-scheduleId="@Model.VesselScheduleId" asp-route-mode="combined"
                           class="@(hasRateAttention ? "modern-btn-primary schedule-rate-editor-cta schedule-rate-editor-cta--attention" : "modern-btn-secondary")">
                            <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
                            <span>Open rate editor</span>
                            @if (pendingRateCount > 0)
                            {
                                <span class="schedule-rate-cta-badge">@pendingRateCount missing</span>
                            }
                            else if (awaitingRateCount > 0)
                            {
                                <span class="schedule-rate-cta-badge">@awaitingRateCount awaiting approval</span>
                            }
                        </a>
                    }
                </div>
                @if (tugs.Count == 0)
                {
                    <p class="ui-panel ui-body">No tugboats assigned. Complete the booking before approval.</p>
                }
                @foreach (var tug in tugs)
                {
                    var entries = Model.ServiceEntries.Where(entry => entry.TugboatId == tug.TugboatId).ToList();
                    var isAddedTug = hasRevisionChanges && addedTugboatIds.Contains(tug.TugboatId);
                    <section class="ui-panel ui-stack @(isAddedTug ? "schedule-review-attention" : "")" aria-label="@tug.TugboatName services">
                        <div class="schedule-review-tug-heading">
                            <h3 class="ui-section-title">@tug.TugboatName</h3>
                            <span class="schedule-pill-badge">@(tug.IsCompanyOwned ? "Company-owned" : "Subcontractor")</span>
                            @if (isAddedTug)
                            {
                                <span class="ui-status ui-attention">Added in revision</span>
                            }
                            <span class="ui-caption ui-muted">@entries.Count expected services</span>
                        </div>
                        @if (entries.Count == 0)
                        {
                            <p class="ui-body ui-muted">No expected services recorded for this tugboat.</p>
                        }
                        else if (canViewRates)
                        {
                            <div class="schedule-services-table" role="region" aria-label="@tug.TugboatName service rates" tabindex="0">
                                <table class="modern-table ui-table schedule-review-table">
                                    <thead><tr><th>Service</th><th>Tariff rate (₱)</th><th>BAF rate (₱)</th></tr></thead>
                                    <tbody>
                                        @foreach (var entry in entries)
                                        {
                                            var isRevisedEntry = hasRevisionChanges && (addedEntryIds.Contains(entry.VesselScheduleServiceEntryId) || addedTugboatIds.Contains(entry.TugboatId));
                                            <tr class="@(isRevisedEntry ? "ui-attention" : "")" data-review-service="@entry.ServiceId" data-entry-id="@entry.VesselScheduleServiceEntryId">
                                                <td>@(entry.Service?.ServiceName ?? $"Service #{entry.ServiceId}")@if (isRevisedEntry) { <small class="ui-caption">Revised / added</small> }@if (entry.CancelledAt.HasValue) { <small class="ui-caption ui-muted">Cancelled · @entry.CancellationReason</small> }</td>
                                                <td class="schedule-review-rate-cell">
                                                    <span class="@(entry.ManualTariffRate.HasValue ? "schedule-review-manual" : "")" data-review-rate="tariff" data-manual="@entry.ManualTariffRate.HasValue.ToString().ToLowerInvariant()">@(entry.ManualTariffRate.HasValue ? entry.ManualTariffRate.Value.ToString("N2") : "Checking table…")</span>
                                                    <small class="ui-caption ui-muted" data-rate-source>@(entry.ManualTariffRate.HasValue ? (entry.ManualTariffRate.Value == 0 ? "Zero tariff" : "Saved manual rate") : "")</small>
                                                    <partial name="_ScheduleRateCapture" model="captures.SingleOrDefault(item => item.EntryId == entry.VesselScheduleServiceEntryId && item.Kind == RateTableKind.Tariff)" />
                                                </td>
                                                <td class="schedule-review-rate-cell">
                                                    <span class="@(entry.ManualBafRate.HasValue ? "schedule-review-manual" : "")" data-review-rate="baf" data-manual="@entry.ManualBafRate.HasValue.ToString().ToLowerInvariant()">@(entry.ManualBafRate.HasValue ? entry.ManualBafRate.Value.ToString("N2") : "Checking table…")</span>
                                                    <small class="ui-caption ui-muted" data-rate-source>@(entry.ManualBafRate.HasValue ? (entry.ManualBafRate.Value == 0 ? "Zero BAF" : "Saved manual rate") : "")</small>
                                                    <partial name="_ScheduleRateCapture" model="captures.SingleOrDefault(item => item.EntryId == entry.VesselScheduleServiceEntryId && item.Kind == RateTableKind.BAF)" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="schedule-services-table" role="region" aria-label="@tug.TugboatName assigned services" tabindex="0">
                                <table class="modern-table ui-table schedule-review-table">
                                    <thead><tr><th>Service</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @foreach (var entry in entries)
                                        {
                                            var isRevisedEntry = hasRevisionChanges && (addedEntryIds.Contains(entry.VesselScheduleServiceEntryId) || addedTugboatIds.Contains(entry.TugboatId));
                                            <tr class="@(isRevisedEntry ? "ui-attention" : "")">
                                                <td>@(entry.Service?.ServiceName ?? $"Service #{entry.ServiceId}")@if (isRevisedEntry) { <small class="ui-caption">Revised / added</small> }</td>
                                                <td>
                                                    @if (entry.CancelledAt.HasValue)
                                                    {
                                                        <span class="ui-status ui-critical">Cancelled</span>
                                                        if (!string.IsNullOrWhiteSpace(entry.CancellationReason))
                                                        {
                                                            <small class="ui-caption ui-muted">@entry.CancellationReason</small>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="ui-status">Scheduled</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
            </section>
            <section class="ui-panel ui-stack" aria-labelledby="reviewNotesTitle">
                <h2 class="ui-section-title" id="reviewNotesTitle">Planning notes</h2>
                <p class="ui-body schedule-note">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No planning notes." : Model.Notes)</p>
            </section>
        </div>
        <aside class="schedule-summary-sidebar" aria-label="Review summary">
            <section class="schedule-summary-card ui-panel ui-stack">
                <h2 class="ui-section-title">@(pending ? "Review summary" : "Booking summary")</h2>
                <div class="ui-field"><span class="ui-caption ui-muted">Booking reference</span><span class="ui-value">Booking #@Model.VesselScheduleId</span></div>
                <div class="schedule-metrics-list">
                    <div class="schedule-metric-row"><span>Tugboats</span><strong>@tugs.Count</strong></div>
                    <div class="schedule-metric-row"><span>Expected services</span><strong>@Model.ServiceEntries.Count</strong></div>
                    @if (canViewRates)
                    {
                        <div class="schedule-metric-row"><span>Manual tariff rates</span><strong>@Model.ServiceEntries.Count(entry => entry.ManualTariffRate.HasValue)</strong></div>
                        <div class="schedule-metric-row"><span>Manual BAF rates</span><strong>@Model.ServiceEntries.Count(entry => entry.ManualBafRate.HasValue)</strong></div>
                    }
                </div>
            </section>
            @if (canViewRates && manualEntries.Count > 0)
            {
                <section class="ui-panel ui-stack schedule-review-attention">
                    <h2 class="ui-section-title">@(pending ? "Manual rates to review" : "Saved manual rates")</h2>
                    @foreach (var entry in manualEntries)
                    {
                        <div class="schedule-manual-rate-item">
                            <div class="ui-field">
                                <strong class="ui-label">@(entry.Tugboat?.TugboatName ?? $"Tug #{entry.TugboatId}")</strong>
                                <span class="ui-caption ui-muted">@(entry.Service?.ServiceName ?? $"Service #{entry.ServiceId}")</span>
                            </div>
                            <dl class="schedule-manual-rate-values">
                                @if (entry.ManualTariffRate.HasValue)
                                {
                                    <div><dt>Tariff</dt><dd>@entry.ManualTariffRate.Value.ToString("N2")</dd></div>
                                }
                                @if (entry.ManualBafRate.HasValue)
                                {
                                    <div><dt>BAF</dt><dd>@entry.ManualBafRate.Value.ToString("N2")</dd></div>
                                }
                            </dl>
                        </div>
                    }
                    <p class="ui-caption ui-muted">@(pending ? "Review manual amounts before approval." : "Saved manual amounts.")</p>
                </section>
            }
            <section class="ui-panel ui-stack">
                <h2 class="ui-section-title">Customer details</h2>
                <div class="ui-field"><span class="ui-caption ui-muted">TIN</span><span class="ui-body">@(Model.Customer?.CustomerTin ?? "Not recorded")</span></div>
                <div class="ui-field"><span class="ui-caption ui-muted">Terms</span><span class="ui-body">@(Model.Customer?.CustomerTerms ?? "Not recorded")</span></div>
                <p class="ui-caption ui-muted">@(Model.Customer?.CustomerAddress ?? "Address not recorded")</p>
            </section>
            @if (pending)
            {
                <section class="ui-panel ui-stack">
                    <h2 class="ui-section-title">After approval</h2>
                    <p class="ui-body ui-muted">@(reapproval ? "The existing COS is retained and this schedule revision is approved." : "The linked COS is created or retained for this booking. Any urgent tickets are retained and their charges calculated from approved terms.")</p>
                    @if (!canApprove)
                    {
                        <p class="ui-caption ui-muted">Waiting for an authorized reviewer to approve this schedule.</p>
                    }
                </section>
            }
            @if (closed || ViewBag.CanEdit == true)
            {
                <section class="ui-panel ui-stack schedule-review-actions" aria-labelledby="bookingActionsTitle">
                    <h2 class="ui-section-title" id="bookingActionsTitle">Booking actions</h2>
                    @if (!closed && ViewBag.CanEdit == true && ViewBag.CanComplete == true)
                    {
                        <div class="schedule-action-item ui-stack">
                            <h3 class="ui-label">Finish vessel service</h3>
                            <p class="ui-body ui-muted">All recorded services have actual end times. Complete service when no more Dispatch Tickets are expected. Billing and collection continue separately.</p>
                            <form asp-action="Complete" method="post" data-schedule-action="Complete">
                                <input type="hidden" name="id" value="@Model.VesselScheduleId" />
                                <button type="submit" class="modern-btn-complete"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span> Complete Service</button>
                            </form>
                        </div>
                    }
                    @if (!closed && ViewBag.CanEdit == true)
                    {
                        @if (ViewBag.CanRevise == true)
                        {
                            <div class="schedule-action-item ui-stack">
                                <h3 class="ui-label">Adjust the booking</h3><p class="ui-body ui-muted">Editing the schedule returns it to Tentative for review and reapproval while preserving the COS. Bookings with actual tickets or billing cannot be revised.</p>
                                <a asp-action="Edit" asp-route-id="@Model.VesselScheduleId" class="modern-btn-secondary"><span class="material-symbols-outlined" aria-hidden="true">edit_calendar</span> Revise Schedule</a>
                            </div>
                        }
                        <div class="schedule-action-item schedule-action-cancel">
                            @if (ViewBag.CanCancel != true)
                            {
                                <h3 class="ui-label">Cancellation unavailable</h3><p class="ui-body ui-muted">Resolve active Dispatch Tickets and billing before cancelling this schedule.</p>
                            }
                            else
                            {
                                <h3 class="ui-label">Cancel this booking</h3><p class="ui-body ui-muted">@(Model.CustomerOrderSlipId.HasValue ? "Cancels the schedule and its COS together. Records are retained." : "Release the tug bookings and keep this plan on record.")</p>
                                <form asp-action="Cancel" method="post" data-schedule-action="Cancel">
                                    <input type="hidden" name="id" value="@Model.VesselScheduleId" />
                                    <button type="submit" class="modern-btn-error"><span class="material-symbols-outlined" aria-hidden="true">event_busy</span> Cancel Booking</button>
                                </form>
                            }
                        </div>
                    }
                    @if (closed)
                    {
                        <p class="ui-body ui-muted">@(Model.Status == MsapConstants.VesselScheduleStatus.Completed ? "Service is completed. Charge calculation, billing approval and collection can continue." : "This booking is cancelled. Schedule changes are no longer available.")</p>
                    }
                </section>
            }
        </aside>

        @if (canApprove)
        {
            <form asp-action="Confirm" method="post" id="confirmSchedule" class="schedule-bottom-bar schedule-review-footer"
                  data-reapproval="@reapproval.ToString().ToLowerInvariant()">
                <input type="hidden" name="id" value="@Model.VesselScheduleId" />
                <input type="hidden" name="reviewedAt" value="@((Model.EditedDate ?? Model.CreatedDate).ToString("O"))" />
                <input type="hidden" name="allowConflicts" value="false" />
                <span class="ui-caption ui-muted">@(Model.Revision > 1 ? $"Approval applies to Revision {Model.Revision} of this booking." : "Approval applies to this booking.")</span>
                <div class="schedule-action-buttons">
                    <a asp-action="Index" asp-route-status="@(pending ? MsapConstants.VesselScheduleStatus.Tentative : null)" asp-route-date="@Model.PlannedStart.ToString("yyyy-MM-dd")" class="modern-btn-secondary" data-ui-back>Back</a>
                    <button type="submit" class="modern-btn-primary"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> @(reapproval ? "Reapprove schedule" : "Approve schedule")</button>
                </div>
            </form>
        }
    </main>
</div>
@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '.schedule-review-workspace .ui-page-header', title: 'Schedule status', text: 'Check the booking status and revision. Open COS continues ticket entry when a COS is available. Urgent service entry, when available, allows actual tickets before approval; charges and billing wait for approval.', interactive: false },
            { selector: '[aria-labelledby="reviewBookingTitle"]', title: 'Booking details', text: 'Review the customer, vessel, port, terminal, voyage and planned service window in Philippine time.', interactive: false },
            { selector: '[aria-labelledby="reviewCommercialTitle"]', title: 'Commercial defaults', text: 'Review the saved customer discount, terminal IOC / Non-IOC and port SBMA settings. Any differences from current defaults are highlighted. Discount and SBMA can be customized during billing preparation.', interactive: false },
            { selector: '[aria-labelledby="reviewServicesTitle"]', title: 'Tugboats, services and rates', text: 'Review the services for each tugboat and their rate sources. Table rates use the planned date; final rates use actual service start. Check any manual rates before approval.', interactive: false },
            { selector: '.schedule-review-actions', title: 'Available booking actions', text: 'Use the actions available for this booking and your access. Read any conditions before changing or stopping the booking.', interactive: false },
            { selector: '#confirmSchedule', title: 'Approve this schedule revision', text: 'Approve only after checking the booking, services, rates and any conflicts. Approval creates or retains the linked COS. Reapproval retains the COS and approves the revised schedule.', interactive: false }
        ].filter(function (step) {
            return document.querySelector(step.selector);
        });
    </script>
    <script src="~/msap/js/schedule-confirmation.js" asp-append-version="true"></script>
    <script src="~/msap/js/schedule-actions.js" asp-append-version="true"></script>
}
