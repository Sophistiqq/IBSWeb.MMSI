@using IBS.Models.MSAP.Enums
@model SpotQuotationViewModel

<div class="spot-quotation-dialog ui-panel ui-stack" style="max-width: 600px; width: 95%; margin: 2rem auto; background: var(--bg-surface, #fff); border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.25); padding: 1.5rem; position: relative; z-index: 1050;">
    <div class="ui-panel-header flex justify-between items-center pb-2 border-b" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color, #e5e7eb); padding-bottom: 0.5rem;">
        <h3 class="modern-headline-sm flex items-center gap-2" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span class="material-symbols-outlined text-primary" aria-hidden="true">request_quote</span>
            24-Hour Spot Quotation Form
        </h3>
        <button type="button" class="btn-close" data-close-spot-modal aria-label="Close" style="background: none; border: none; cursor: pointer; font-size: 1.25rem; line-height: 1; padding: 0.25rem;">✕</button>
    </div>

    <form id="spotQuotationForm" asp-area="MSAP" asp-controller="VesselSchedule" asp-action="SaveSpotQuotation" method="post" enctype="multipart/form-data" class="ui-stack gap-3 pt-3" style="display: flex; flex-direction: column; gap: 0.875rem; padding-top: 0.75rem;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VesselScheduleId" />
        <input type="hidden" asp-for="VesselScheduleServiceEntryId" />

        <div class="schedule-review-fields" style="background: var(--bg-subtle, #f8f9fa); padding: 0.75rem; border-radius: 6px; font-size: 0.875rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <div><strong>Vessel:</strong> @Model.VesselName</div>
            <div><strong>Customer:</strong> @Model.CustomerName</div>
            <div><strong>Tugboat:</strong> @Model.TugboatName</div>
            <div><strong>Service:</strong> @Model.ServiceName</div>
        </div>

        <div>
            <label asp-for="QuotationReference" class="ui-label font-bold text-sm">Quotation Reference # <span class="text-danger">*</span></label>
            <input asp-for="QuotationReference" class="form-control" placeholder="e.g. SQ-202611-001 or Client Email Ref" required />
            <span asp-validation-for="QuotationReference" class="text-danger text-xs"></span>
        </div>

        <div class="grid grid-cols-2 gap-3" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <div>
                <label asp-for="TariffRate" class="ui-label font-bold text-sm">Basic Tariff Rate (₱) <span class="text-danger">*</span></label>
                <input asp-for="TariffRate" type="number" step="0.01" min="0.01" class="form-control" required />
                <span asp-validation-for="TariffRate" class="text-danger text-xs"></span>
            </div>
            <div>
                <label asp-for="TariffBasis" class="ui-label font-bold text-sm">Tariff Basis <span class="text-danger">*</span></label>
                <select asp-for="TariffBasis" class="form-select" asp-items="Html.GetEnumSelectList<TariffChargeBasis>()"></select>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <div>
                <label asp-for="BafRate" class="ui-label font-bold text-sm">BAF Rate (₱) <span class="text-danger">*</span></label>
                <input asp-for="BafRate" type="number" step="0.01" min="0" class="form-control" required />
                <span asp-validation-for="BafRate" class="text-danger text-xs"></span>
            </div>
            <div>
                <label asp-for="BafMethod" class="ui-label font-bold text-sm">BAF Method <span class="text-danger">*</span></label>
                <select asp-for="BafMethod" class="form-select" asp-items="Html.GetEnumSelectList<BafCalculationMethod>()"></select>
            </div>
        </div>

        <div>
            <label asp-for="Remarks" class="ui-label font-bold text-sm">Special Terms / Quotation Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Agreed ad-hoc spot terms (e.g. Approved via email)"></textarea>
        </div>

        <div>
            <label asp-for="QuotationFile" class="ui-label font-bold text-sm">Quotation Document (PDF / Image)</label>
            <input asp-for="QuotationFile" type="file" accept=".pdf,.png,.jpg,.jpeg" class="form-control" />
            <small class="ui-caption text-muted" style="display: block; margin-top: 0.25rem;">Upload approved spot quotation or formal email confirmation (optional).</small>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t" style="display: flex; justify-content: flex-end; gap: 0.5rem; border-top: 1px solid var(--border-color, #e5e7eb); padding-top: 0.75rem;">
            <button type="button" class="modern-btn-secondary" data-close-spot-modal>Cancel</button>
            <button type="submit" class="modern-btn-primary">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                Apply Spot Quotation
            </button>
        </div>
    </form>
</div>
