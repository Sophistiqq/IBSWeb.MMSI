@model Customer

@{
    ViewData["Title"] = "Activate Customer";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <form method="post">
        <main class="modern-container ui-page">
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Customers</a></li><li aria-current="page">Activate Customer</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2 ui-actions">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">check_circle</span> Activate
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">person_check</span>
                            <h2 class="modern-headline-md ui-section-title">Customer Information</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            <input asp-for="CustomerId" hidden />

                            <div class="flex flex-column gap-3">
                                <div>
                                    <label asp-for="CustomerName" class="modern-label ui-label">Customer Name</label>
                                    <input asp-for="CustomerName" class="form-control ui-input" disabled />
                                </div>
                                <div>
                                    <label asp-for="CustomerAddress" class="modern-label ui-label">Address</label>
                                    <input asp-for="CustomerAddress" class="form-control ui-input" disabled />
                                </div>
                                <div>
                                    <label asp-for="CustomerTin" class="modern-label ui-label">TIN</label>
                                    <input asp-for="CustomerTin" class="form-control ui-input" disabled />
                                </div>
                                <div>
                                    <label asp-for="BusinessStyle" class="modern-label ui-label">Business Style</label>
                                    <input asp-for="BusinessStyle" class="form-control ui-input" disabled />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
