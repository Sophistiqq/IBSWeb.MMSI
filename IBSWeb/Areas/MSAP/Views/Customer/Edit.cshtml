@using Enum = System.Enum
@model IBS.Models.MSAP.MasterFile.CustomerViewModel

@{
    ViewData["Title"] = "Edit Customer";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <form asp-action="Edit" method="post" id="mainForm">
        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="CustomerCode" />
        <main class="modern-container ui-page">
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Customers</a></li><li aria-current="page">Edit Customer</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2 ui-actions">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-8">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">edit</span>
                            <h2 class="modern-headline-md ui-section-title">Customer Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="modern-grid">
                                <div class="modern-col-6">
                                    <label asp-for="CustomerName" class="modern-label ui-label">Customer Name <span class="text-error">*</span></label>
                                    <input asp-for="CustomerName" class="form-control ui-input" placeholder="Enter customer name" />
                                    <span asp-validation-for="CustomerName" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label asp-for="CustomerAddress" class="modern-label ui-label">Customer Address <span class="text-error">*</span></label>
                                    <input asp-for="CustomerAddress" class="form-control ui-input" placeholder="Enter customer address" />
                                    <span asp-validation-for="CustomerAddress" class="text-error text-xs"></span>
                                </div>
                            </div>

                            <div class="modern-grid mt-3">
                                <div class="modern-col-4">
                                    <label asp-for="ZipCode" class="modern-label ui-label">Zip Code <span class="text-error">*</span></label>
                                    <input asp-for="ZipCode" class="form-control ui-input" placeholder="Enter zip code" maxlength="4" />
                                    <span asp-validation-for="ZipCode" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="CustomerTin" class="modern-label ui-label">Customer Tin <span class="text-error">*</span></label>
                                    <input asp-for="CustomerTin" class="form-control formattedTinNumberInput ui-input" placeholder="Enter TIN" maxlength="17" />
                                    <span asp-validation-for="CustomerTin" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="BusinessStyle" class="modern-label ui-label">Business Style</label>
                                    <input asp-for="BusinessStyle" class="form-control ui-input" placeholder="Enter business style" />
                                    <span asp-validation-for="BusinessStyle" class="text-error text-xs"></span>
                                </div>
                            </div>

                            <div class="modern-grid mt-3">
                                <div class="modern-col-6">
                                    <input asp-for="CustomerType" hidden />
                                    <label asp-for="CustomerType" class="modern-label ui-label">Customer Type</label>
                                    <select asp-for="CustomerType" class="js-modern-select" data-placeholder="Select customer type" disabled>
                                        <option value="" selected disabled></option>
                                        @foreach (CustomerType customerType in Enum.GetValues<CustomerType>())
                                        {
                                            <option value="@customerType">@customerType.ToString()</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="modern-grid mt-3">
                                <div class="modern-col-4">
                                    <label asp-for="DefaultCosDiscountPercent" class="modern-label ui-label"></label>
                                    <input asp-for="DefaultCosDiscountPercent" type="number" min="0" max="100" step="0.0001" class="modern-input ui-input" aria-describedby="cosDiscountHelp" />
                                    <span asp-validation-for="DefaultCosDiscountPercent" class="text-error text-xs"></span>
                                    <small id="cosDiscountHelp">Customer default for the COS discount. Enter 10 for 10%.</small>
                                </div>
                            </div>

                            <div class="modern-grid mt-3">
                                <div class="modern-col-6">
                                    <label asp-for="CustomerTerms" class="modern-label ui-label">Customer Terms <span class="text-error">*</span></label>
                                    <select asp-for="CustomerTerms" asp-items="@Model.PaymentTerms" class="js-modern-select" data-placeholder="-- Select Terms --">
                                    </select>
                                    <span asp-validation-for="CustomerTerms" class="text-error text-xs"></span>
                                </div>
                            </div>

                            <div class="modern-grid mt-3">
                                <div class="modern-col-6">
                                    <label asp-for="VatType" class="modern-label ui-label">Vat Type</label>
                                    <select asp-for="VatType" class="js-modern-select" data-placeholder="Select vat type">
                                        <option value="" selected disabled></option>
                                        <option value="@MsapConstants.VatType_Vatable">@MsapConstants.VatType_Vatable</option>
                                        <option value="@MsapConstants.VatType_ZeroRated">@MsapConstants.VatType_ZeroRated</option>
                                        <option value="@MsapConstants.VatType_Exempt">@MsapConstants.VatType_Exempt</option>
                                    </select>
                                    <span asp-validation-for="VatType" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6 d-flex align-items-end pb-2">
                                    <div class="flex flex-column gap-1 w-100">
                                        <label class="modern-label ui-label">Options</label>
                                        <div class="flex gap-3">
                                            <label class="flex items-center gap-1">
                                                <input class="form-check-input" asp-for="WithHoldingVat" /> <span class="text-sm">Withholding VAT</span>
                                            </label>
                                            <label class="flex items-center gap-1">
                                                <input class="form-check-input" asp-for="WithHoldingTax" /> <span class="text-sm">Withholding Tax</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
