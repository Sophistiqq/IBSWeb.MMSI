@model Billing
@{
    bool isEditingDraft = Model.MsapBillingId > 0;
    ViewData["Title"] = isEditingDraft ? "Edit billing" : "Prepare billing";
    ViewData["IsFullWidth"] = true;
}

<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/billing-preparation.css" asp-append-version="true" />

<div class="modern-layout app-ui billing-preparation">
    <form id="billingPreparationForm" method="post" asp-action="Create" novalidate data-download
          data-customer-url="@Url.Action("GetCustomerDetail")"
          data-cos-list-url="@Url.Action("GetBillableCustomerOrderSlips")"
          data-tickets-url="@Url.Action("GetDispatchTicketsByCustomerOrderSlip")"
          data-principals-url="@Url.Action("GetPrincipalsByCustomer")"
          data-reps-url="@Url.Action("GetRepresentativesByCustomer")"
          data-progress-url="@Url.Action("Progress", "CustomerOrderSlip")"
          data-index-url="@Url.Action("Index")"
          data-details-url="@Url.Action("Details", "CustomerOrderSlip")"
          data-initial-cos="@Model.CustomerOrderSlipId"
          data-editing-draft="@isEditingDraft.ToString().ToLowerInvariant()"
          data-initial-billed-to="@Model.BilledTo"
          data-initial-principal="@Model.PrincipalId"
          data-initial-terms="@Model.Terms"
          data-initial-agency-inc="@Model.AgencyIncentiveRepresentativeId"
          data-initial-agent-com="@Model.AgentCommissionRepresentativeId"
          data-suggested-bir-number="@ViewData["SuggestedBirNumber"]"
          data-suggested-bir-baf-number="@ViewData["SuggestedBirBafNumber"]">
        @Html.AntiForgeryToken()
        <main class="billing-workspace">
            <aside class="ui-panel schedule-details-progress billing-progress" aria-label="Job Progress">
                <div id="financialJobProgress" data-progress-url="@Url.Action("Progress", "CustomerOrderSlip")" data-action-stage="5">
                    <h2 class="ui-section-title">Job Progress</h2>
                    <p class="ui-caption ui-muted">Select a COS to see its progress.</p>
                </div>
            </aside>
            <div class="ui-stack billing-content">
                <header class="ui-page-header">
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li><a asp-action="Index">Billing</a></li><li aria-current="page">Prepare billing</li></ol></nav>
                    <h1 class="ui-page-title" data-page-header>Prepare billing</h1>
                    <div class="billing-review-header-actions">
                        <a class="modern-btn-secondary ui-page-action" asp-action="Index" data-ui-back>Back</a>
                        <a id="cosDetailsLink" class="modern-btn-secondary ui-page-action" asp-action="Index" hidden>COS details</a>
                    </div>
                    <p class="ui-page-description ui-caption ui-muted" id="billingReadiness" role="status">Select a customer and COS to load completed services.</p>
                </header>

                <section class="ui-panel ui-stack" aria-label="Booking details">
                    <div class="billing-fields">
                        <div class="ui-field">
                            <label asp-for="CustomerId" class="ui-label">Service customer *</label>
                            <select asp-for="CustomerId" asp-items="Model.Customers" class="js-modern-select" data-placeholder="Select customer" required>
                                <option value="">Select customer</option>
                            </select>
                        </div>
                        <div class="ui-field">
                            <label for="CustomerOrderSlipSelect" class="ui-label">COS *</label>
                            <select asp-for="CustomerOrderSlipId" class="js-modern-select" id="CustomerOrderSlipSelect" data-placeholder="Select COS" disabled required>
                                <option value="">Select COS</option>
                            </select>
                        </div>
                        <div class="ui-field"><span class="ui-caption ui-muted">Vessel</span><p id="bookingVessel" class="ui-body">—</p></div>
                        <div class="ui-field">
                            <span class="ui-caption ui-muted">Service location</span>
                            <p id="bookingLocation" class="ui-body">—</p>
                            <small id="bookingIoc" class="ui-caption ui-muted">—</small>
                        </div>
                    </div>
                    <div class="billing-booking-facts">
                        <div><span class="ui-caption ui-muted">Voyage</span><p id="bookingVoyage" class="ui-body">—</p></div>
                        <div><span class="ui-caption ui-muted">Service dates</span><p id="bookingDates" class="ui-body">—</p></div>
                        <div><span class="ui-caption ui-muted">Terms</span><p id="bookingTerms" class="ui-body">—</p></div>
                    </div>
                    <div class="billing-vat-settings" aria-label="Tax settings">
                        <label class="billing-setting-card">
                            <input type="checkbox" id="customerVat" disabled />
                            <span class="material-symbols-outlined billing-setting-check" aria-hidden="true">check</span>
                            <span class="ui-label">VAT</span>
                        </label>
                        <label class="billing-setting-card">
                            <input type="checkbox" id="customerVatInclusive" checked disabled />
                            <span class="material-symbols-outlined billing-setting-check" aria-hidden="true">check</span>
                            <span class="ui-label">VAT inclusive</span>
                        </label>
                        <label class="billing-setting-card">
                            <input type="checkbox" id="customerWithholding" disabled />
                            <span class="material-symbols-outlined billing-setting-check" aria-hidden="true">check</span>
                            <span class="ui-label">Print withholding</span>
                        </label>
                        <label class="billing-setting-card">
                            <input type="checkbox" id="customerPrintDiscount" disabled />
                            <span class="material-symbols-outlined billing-setting-check" aria-hidden="true">check</span>
                            <span class="ui-label">Print discount</span>
                        </label>
                    </div>
                </section>

                <section class="ui-panel ui-stack" aria-labelledby="billingHeading">
                    <div class="billing-section-heading billing-details-heading">
                        <h2 id="billingHeading" class="ui-section-title">Billing details</h2>
                        <div class="billing-options">
                            <label class="billing-option"><input asp-for="PrintDiscount" id="billingPrintDiscount" /> Print discount</label>
                            <label class="billing-option"><input asp-for="IsUndocumented" /> Undocumented</label>
                            <label class="billing-option" title="@(isEditingDraft ? "Discard draft first to change Basic and BAF split." : null)"><input asp-for="SeparateBaf" disabled="@isEditingDraft" /> Separate Basic and BAF</label>
                            <label class="billing-option" id="sbmaCard" hidden title="Subic Bay Metropolitan Authority share."><input type="checkbox" name="SbmaEnabled" id="SbmaEnabled" value="true" disabled /> Apply SBMA share</label>
                            <input type="hidden" name="SbmaEnabled" id="sbmaFalse" value="false" disabled />
                            @if (isEditingDraft)
                            {
                                <input type="hidden" name="SeparateBaf" value="@Model.SeparateBaf.ToString().ToLowerInvariant()" />
                            }
                        </div>
                    </div>
                    <div class="billing-number-fields">
                        <div class="ui-field">
                            <label for="MsapBillingNumber" id="basicNumberLabel" class="ui-label">Billing number *</label>
                            <input asp-for="MsapBillingNumber" class="modern-input" placeholder="B000000" maxlength="10" required />
                            <small id="seriesOverrideHint" class="ui-caption schedule-review-attention" hidden></small>
                        </div>
                        <div class="ui-field" id="bafNumberField" hidden>
                            <label asp-for="BafBillingNumber" class="ui-label">BAF billing number *</label>
                            <input asp-for="BafBillingNumber" class="modern-input" maxlength="10" disabled />
                            <small id="bafSeriesOverrideHint" class="ui-caption schedule-review-attention" hidden></small>
                        </div>
                        <div class="ui-field">
                            <label asp-for="Date" class="ui-label">Billing date *</label>
                            <input asp-for="Date" type="date" class="modern-input" required value="@(Model.Date != default ? Model.Date.ToString("yyyy-MM-dd") : DateTimeHelper.GetCurrentPhilippineTime().ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="billing-recipient-fields">
                        <div class="ui-field">
                            <label asp-for="BilledTo" class="ui-label">Bill to *</label>
                            <select asp-for="BilledTo" class="js-modern-select">
                                <option value="LOCAL">Customer</option>
                            </select>
                        </div>
                        <div id="principalField" class="ui-field" hidden>
                            <label for="PrincipalSelect" class="ui-label">Principal *</label>
                            <select asp-for="PrincipalId" class="js-modern-select" id="PrincipalSelect" disabled>
                                <option value="">Select principal</option>
                            </select>
                        </div>
                    </div>
                    <div class="billing-commercial-options" aria-label="Commercial settings">
                        <div class="billing-setting-card" id="discountCard" hidden>
                            <input asp-for="SkipCosDiscount" type="checkbox" hidden disabled />
                            <button type="button" id="discountToggle" class="billing-setting-toggle" aria-pressed="false" aria-controls="CosDiscountPercent" disabled>
                                <span class="ui-label">Customer discount</span>
                                <span class="material-symbols-outlined billing-setting-check" aria-hidden="true">check</span>
                            </button>
                            <div class="billing-discount-control">
                                <input asp-for="CosDiscountPercent" type="number" step="0.0001" min="0" max="100" class="modern-input" aria-label="Customer discount percentage" aria-describedby="discountHelp" readonly disabled required />
                                <span aria-hidden="true">%</span>
                            </div>
                            <div class="d-flex flex-wrap gap-3 mt-2" aria-label="Discount scope">
                                <label class="d-inline-flex align-items-center gap-1 ui-caption mb-0">
                                    <input asp-for="DiscountOnTariff" type="checkbox" disabled />
                                    <span>Basic (Tariff)</span>
                                </label>
                                <label class="d-inline-flex align-items-center gap-1 ui-caption mb-0">
                                    <input asp-for="DiscountOnBaf" type="checkbox" disabled />
                                    <span>BAF</span>
                                </label>
                                <label class="d-inline-flex align-items-center gap-1 ui-caption mb-0">
                                    <input type="checkbox" id="DiscountScopeTotal" @(Model.DiscountOnTariff && Model.DiscountOnBaf ? "checked" : "") disabled />
                                    <span>Total (Gross)</span>
                                </label>
                            </div>
                            <span id="discountHelp" class="ui-caption ui-muted">Locked to COS default. Overrides require reviewer revision.</span>
                        </div>
                    </div>
                    <div class="billing-recipient-fields" id="commissionOptionsSection" hidden aria-label="Internal rebates and agent commissions">
                        <div class="ui-field">
                            <label for="AgencyIncentiveSelect" class="ui-label">Agency incentive (internal only)</label>
                            <select asp-for="AgencyIncentiveRepresentativeId" class="js-modern-select" id="AgencyIncentiveSelect">
                                <option value="">None</option>
                            </select>
                            <small id="agencyIncentivePreview" class="ui-caption ui-muted">Hidden from client invoices.</small>
                        </div>
                        <div class="ui-field">
                            <label for="AgentCommissionSelect" class="ui-label">Agent commission (internal only)</label>
                            <select asp-for="AgentCommissionRepresentativeId" class="js-modern-select" id="AgentCommissionSelect">
                                <option value="">None</option>
                            </select>
                            <small id="agentCommissionPreview" class="ui-caption ui-muted">Hidden from client invoices.</small>
                        </div>
                    </div>
                    <div class="billing-recipient">
                        <div><span class="ui-caption ui-muted">Statement address</span><p id="recipientAddress" class="ui-body">—</p></div>
                        <div><span class="ui-caption ui-muted">Statement TIN</span><p id="recipientTin" class="ui-body">—</p></div>
                        <div>
                            <span class="ui-caption ui-muted">Payment terms override</span>
                            <select asp-for="Terms" asp-items="@Model.PaymentTerms" class="modern-input js-modern-select" id="billingTerms">
                                <option value="">-- Customer Default --</option>
                            </select>
                            <p id="termsDefaultNote" class="ui-caption ui-muted mt-1 mb-0">Master file default: <strong id="recipientTerms">—</strong></p>
                            <p id="termsOverrideHint" class="ui-caption schedule-review-attention mt-1 mb-0" hidden></p>
                        </div>
                    </div>
                    <p id="recipientNote" class="ui-caption ui-muted">The statement is addressed to the service customer.</p>
                </section>

                <section class="ui-panel ui-stack" aria-labelledby="servicesHeading">
                    <div class="billing-section-heading">
                        <h2 id="servicesHeading" class="ui-section-title">Completed services</h2>
                        <span id="serviceAmountsNote" class="ui-caption ui-muted">Approved rates</span>
                    </div>
                    <div class="billing-table-scroll">
                        <table class="modern-table ui-table billing-service-table">
                            <thead><tr><th>Service</th><th>Actual hours</th><th>Billable hours</th><th id="basicAmountHeading">Basic amount</th><th class="billing-basis-column" hidden>Basic basis</th><th id="bafAmountHeading">BAF amount</th><th class="billing-basis-column" hidden>BAF basis</th><th class="billing-discount-column" hidden>Discount</th><th class="billing-discount-column" hidden>Basic net</th><th class="billing-discount-column" hidden>BAF net</th><th>Tariff / BAF source</th></tr></thead>
                            <tbody id="completedServices"><tr><td colspan="6">Select a customer and COS to view completed services.</td></tr></tbody>
                        </table>
                    </div>
                </section>

                <div class="billing-summary-grid">
                    <section class="ui-panel ui-stack">
                        <div class="billing-section-heading"><h2 id="basicSummaryHeading" class="ui-section-title">Basic</h2><span class="billing-badge split-only" hidden>Separate balance</span></div>
                        <div class="billing-amount"><span>Basic amount</span><strong id="basicGross">0.00</strong></div>
                        <div class="billing-amount billing-discount-row" hidden><span>Less: customer discount</span><strong id="basicDiscount">0.00</strong></div>
                        <div class="billing-amount billing-discount-row" hidden><span>Net basic amount</span><strong id="basicCharges">0.00</strong></div>
                        <div class="billing-amount" id="basicVatRow" hidden><span>VAT included</span><strong id="basicVat">0.00</strong></div>
                        <div class="billing-amount" id="basicEwtRow" hidden><span>Less: withholding tax</span><strong id="basicEwt">0.00</strong></div>
                        <div class="billing-amount billing-summary-total"><strong>Amount due</strong><strong id="basicDue">0.00</strong></div>
                        <div class="billing-amount billing-summary-note"><span>SBMA share</span><strong id="sbmaAmount">0.00</strong></div>
                    </section>
                    <section class="ui-panel ui-stack">
                        <div class="billing-section-heading"><h2 id="bafSummaryHeading" class="ui-section-title">BAF</h2><span class="billing-badge split-only" hidden>Separate balance</span></div>
                        <div class="billing-amount"><span>BAF amount</span><strong id="bafGross">0.00</strong></div>
                        <div class="billing-amount billing-discount-row" hidden><span>Less: customer discount</span><strong id="bafDiscount">0.00</strong></div>
                        <div class="billing-amount billing-discount-row" hidden><span>Net BAF amount</span><strong id="bafCharges">0.00</strong></div>
                        <div class="billing-amount" id="bafVatRow" hidden><span>VAT included</span><strong id="bafVat">0.00</strong></div>
                        <div class="billing-amount" id="bafEwtRow" hidden><span>Less: withholding tax</span><strong id="bafEwt">0.00</strong></div>
                        <div class="billing-amount billing-summary-total"><strong>Amount due</strong><strong id="bafDue">0.00</strong></div>
                        <p id="balanceNote" class="ui-caption ui-muted">The charges are included in one billing balance.</p>
                    </section>
                    <section id="combinedSummary" class="ui-panel billing-amount billing-combined-summary">
                        <strong>Combined amount due</strong><strong id="combinedDue">0.00</strong>
                    </section>
                </div>

                <section class="ui-panel ui-stack" aria-labelledby="remarksHeading">
                    <div class="billing-section-heading">
                        <h2 id="remarksHeading" class="ui-section-title flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary" aria-hidden="true">notes</span>
                            Encoder Remarks / Notes for Approvers
                        </h2>
                        <span class="ui-caption ui-muted">Special terms, tariff basis clarifications, or instructions for commercial and finance reviewers</span>
                    </div>
                    <div class="ui-field">
                        <textarea asp-for="Remarks" class="modern-input" rows="2" maxlength="500" placeholder="e.g. Rate approved via email; 30D terms granted per customer request..."></textarea>
                        <span asp-validation-for="Remarks" class="text-error"></span>
                    </div>
                </section>

                <footer class="billing-footer">
                    <p id="preparationNote" class="ui-caption ui-muted">One preparation · One billing number</p>
                    <div class="billing-footer-actions">
                        <button type="submit" id="previewBilling" class="modern-btn-secondary ui-page-action" formaction="@Url.Action("PreviewPreparation")" formtarget="_blank" disabled>
                            <span class="material-symbols-outlined" aria-hidden="true">visibility</span> Preview statements
                        </button>
                        <button type="submit" id="saveBilling" class="modern-btn-primary ui-page-action" disabled>
                            <span class="material-symbols-outlined" aria-hidden="true">save</span> Save for reviewing
                        </button>
                    </div>
                </footer>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '[aria-label="Booking details"]', title: 'Choose the service customer and COS', text: 'Select a service customer, then a billable COS to load its completed services. Check the vessel, voyage, service dates and location. IOC / Non-IOC is shown below the location and cannot be changed here.', interactive: false },
            { selector: '.billing-vat-settings', title: 'Tax information', text: 'VAT, VAT inclusive and Print withholding are read-only information for the selected customer. Review these before preparing the statement.', interactive: false },
            { selector: '[aria-labelledby="billingHeading"]', title: 'Billing details and recipient', text: 'Enter the billing number and date, then choose the billed party. Separate Basic and BAF creates two numbered bills with separate balances; supply both numbers when enabled. Review the statement address, TIN and payment terms.', interactive: false },
            { selector: '.billing-commercial-options', title: 'Discount and SBMA share', text: 'For a scheduled COS, the customer discount starts from its saved default. Enable it to enter a percentage; clearing the value skips the discount. Apply SBMA share is available only for Subic. Existing tickets without a schedule retain their recorded discounts.', interactive: false },
            { selector: '[aria-labelledby="servicesHeading"]', title: 'Completed services', text: 'Review each tugboat and service, actual and billable hours, Basic and BAF amounts, and rate sources. When a discount applies, extra columns show the discount and net amounts.', interactive: false },
            { selector: '.billing-summary-grid', title: 'Check the amount breakdown', text: 'Review Basic and BAF amounts, any customer discount, VAT and withholding, and the resulting amount due. SBMA share is shown separately. Combined amount due is shown when Basic and BAF share one bill.', interactive: false },
            { selector: '.billing-footer', title: 'Preview and save for reviewing', text: 'Preview the statements before saving. Save for reviewing creates the numbered bill for final approval. Separate Basic and BAF bills each require their own final approval.', interactive: false },
            { selector: '.billing-progress', title: 'Job progress', text: 'After selecting a COS, use its progress panel to see the current stage and any work still needed.', interactive: false }
        ];
    </script>
    <script src="~/msap/js/job-progress.js" asp-append-version="true"></script>
    <script src="~/msap/js/billing-preparation.js" asp-append-version="true"></script>
}
