@model Billing
@{
    ViewData["Title"] = "Review billing";
    ViewData["IsFullWidth"] = true;
    var progressItems = (ViewBag.JobProgressItems as IEnumerable<JobProgressViewModel>)?.ToList() ?? [];
    var related = Model.BasicBilling ?? Model.BafBilling;
    bool bafOnly = Model.BasicBillingId.HasValue;
    bool basicOnly = Model.BafBilling != null;
    string component = bafOnly ? "BAF" : basicOnly ? "Basic" : "Basic and BAF";
    string? blocker = ViewData["PostingBlocker"] as string;
    bool canPrint = BillingService.CanPrint(Model);
    bool isReopenedOrFinalized = Model.UnpostedDate.HasValue || Model.PeriodStatus is MsapPeriodStatus.Final or MsapPeriodStatus.Adjusted;
    bool canReview = ViewData["CanReviewBilling"] is true && Model.Status == MsapConstants.BillingStatus.ForPosting && blocker == null && (ViewData["IsPeriodClosed"] is not true || isReopenedOrFinalized);
    bool canPost = ViewData["CanApproveFinalBilling"] is true && Model.Status == MsapConstants.BillingStatus.Reviewed && blocker == null && (ViewData["IsPeriodClosed"] is not true || isReopenedOrFinalized);
    bool canReject = (ViewData["CanReviewBilling"] is true && Model.Status == MsapConstants.BillingStatus.ForPosting)
        || (ViewData["CanApproveFinalBilling"] is true && Model.Status == MsapConstants.BillingStatus.Reviewed);
    bool canAdjust = ViewData["CanCreateBilling"] is true && Model.Status == MsapConstants.BillingStatus.ForPosting && (Model.RejectedAt.HasValue || Model.UnpostedDate.HasValue);
    bool canEditDraft = ViewData["CanCreateBilling"] is true && Model.Status == MsapConstants.BillingStatus.ForPosting && Model.CustomerOrderSlipId.HasValue && (ViewData["IsPeriodClosed"] is not true || isReopenedOrFinalized);
    bool canReverse = ViewData["CanReverseBilling"] is true && Model.Status == MsapConstants.BillingStatus.ForCollection && Model.AmountPaid == 0;
    bool canDiscard = ViewData["CanDiscardBilling"] is true && Model.Status == MsapConstants.BillingStatus.ForPosting && ViewData["IsPeriodClosed"] is not true;
    var statusLabel = Model.Status == MsapConstants.BillingStatus.ForPosting
        ? "For commercial review"
        : Model.Status == MsapConstants.BillingStatus.Reviewed
            ? "Reviewed · Awaiting final approval"
            : "Approved";
    var adjustmentReason = ViewBag.AdjustmentReason as string;
    var adjustmentAttachmentUrl = ViewBag.AdjustmentAttachmentUrl as string;
}
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/billing-preparation.css" asp-append-version="true" />

<div class="modern-layout app-ui billing-preparation billing-review-screen">
    <div class="billing-workspace">
        <div class="ui-stack">
            @foreach (var progress in progressItems)
            {
                <partial name="_WorkflowProgress" model="progress" />
            }
        </div>
        <main class="billing-content ui-stack">
            <header class="ui-page-header">
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li><a asp-action="Index">Billing</a></li><li>@Model.MsapBillingNumber</li><li aria-current="page">Review</li></ol></nav>
                <h1 class="ui-page-title" data-page-header>Review billing</h1>
                <div class="billing-review-header-actions">
                    <a asp-action="Index" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="modern-btn-secondary ui-page-action" data-ui-back>Back</a>
                    <a asp-action="Preview" asp-route-id="@Model.MsapBillingId" asp-route-printCopy="@canPrint" target="_blank" class="modern-btn-primary ui-page-action">Preview statements</a>
                </div>
                <p class="ui-page-description ui-caption ui-muted">
                    @Model.MsapBillingNumber · @component · @statusLabel · @(Model.IsUndocumented ? "Undocumented" : "Documented")
                    @{
                        var billingChanges = ViewBag.BillingChanges as List<MsapFieldChange> ?? new List<MsapFieldChange>();
                        var hasSeriesOverride = billingChanges.Any(c => c.Field == nameof(Billing.MsapBillingNumber));
                        var masterDefaultTerms = (Model.Principal?.Terms ?? Model.Customer.CustomerTerms)?.Trim();
                        if (string.IsNullOrWhiteSpace(masterDefaultTerms))
                        {
                            masterDefaultTerms = "COD";
                        }
                        var hasTermsOverride = billingChanges.Any(c => c.Field == nameof(Billing.Terms))
                            || (!string.IsNullOrWhiteSpace(Model.Terms) && !string.Equals(Model.Terms.Trim(), masterDefaultTerms, StringComparison.OrdinalIgnoreCase));
                        var hasDueDateChange = billingChanges.Any(c => c.Field == nameof(Billing.DueDate));
                    }
                    @if (hasSeriesOverride)
                    {
                        <span class="schedule-status-pill ui-status ui-attention" title="Invoice number differs from the expected sequential BIR series">Series overridden</span>
                    }
                    @if (hasTermsOverride)
                    {
                        <span class="schedule-status-pill ui-status ui-attention" title="Payment terms differ from the customer/principal master file default">Terms overridden</span>
                    }
                    @if (Model.PeriodStatus == MsapPeriodStatus.Adjusted)
                    {
                        <span class="schedule-status-pill ui-status ui-attention" title="Adjusted after period finalization">Adjusted</span>
                    }
                    else if (Model.PeriodStatus == MsapPeriodStatus.Final)
                    {
                        <span class="schedule-status-pill" title="Finalized month-end period">Final</span>
                    }
                </p>
            </header>
            @if (Model.RejectedAt.HasValue && Model.Status == MsapConstants.BillingStatus.ForPosting)
            {
                <div class="ui-panel ui-critical" role="alert">
                    <p class="ui-body mb-1">
                        <strong>Revision requested</strong> by @(Model.RejectedByUser?.UserName ?? Model.RejectedByUserId) on @Model.RejectedAt.Value.ToString("dd MMM yyyy HH:mm")
                    </p>
                    <p class="ui-caption mb-0">@Model.RejectionReason</p>
                </div>
            }
            @if (billingChanges.Count > 0)
            {
                var visibleChanges = billingChanges
                    .Where(c => !c.Field.EndsWith("_NetAmount", StringComparison.OrdinalIgnoreCase))
                    .ToList();
                <section class="modern-card ui-card ui-attention" aria-label="Overridden values flagged for review and approval" style="border-left: 4px solid #f59e0b; background: rgba(245, 158, 11, 0.06);">
                    <div class="modern-card-header-action flex justify-between items-center w-full flex-wrap gap-2 ui-card-header">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined" style="color: #d97706;" aria-hidden="true">fact_check</span>
                            <h2 class="modern-headline-md ui-section-title mb-0">Overridden values flagged for review &amp; approval</h2>
                            <span class="modern-badge-sm status-tariff">@visibleChanges.Count change@(visibleChanges.Count == 1 ? "" : "s")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(adjustmentAttachmentUrl))
                        {
                            <a asp-action="DownloadAdjustmentAttachment" asp-route-id="@Model.MsapBillingId" target="_blank" class="modern-btn-secondary">
                                <span class="material-symbols-outlined" aria-hidden="true">attach_file</span> View authorization document
                            </a>
                        }
                    </div>
                    <div class="modern-card-body ui-card-body ui-stack">
                        @if (visibleChanges.Count > 0)
                        {
                            <div class="billing-table-scroll">
                                <table class="modern-table ui-table billing-override-table" style="font-size: 0.9rem;">
                                    <thead>
                                        <tr>
                                            <th>Changed field</th>
                                            <th>Previous</th>
                                            <th>Revised</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var change in visibleChanges)
                                        {
                                            <tr>
                                                <td><strong>@change.Label</strong></td>
                                                <td class="ui-muted">@(string.IsNullOrWhiteSpace(change.Before) ? "—" : change.Before)</td>
                                                <td><strong>@change.After</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(adjustmentReason))
                        {
                            <div class="pt-2" style="border-top: 1px solid var(--outline-variant);">
                                <span class="ui-caption ui-muted"><strong>Authorized reason:</strong></span>
                                <span class="ui-body">@adjustmentReason</span>
                            </div>
                        }
                    </div>
                </section>
            }
            @{
                var reviewerDone = Model.ReviewedAt.HasValue;
                var reviewerRejected = !reviewerDone && Model.Status == MsapConstants.BillingStatus.ForPosting && Model.RejectedAt.HasValue;
                var reviewerCurrent = !reviewerDone && !reviewerRejected && Model.Status == MsapConstants.BillingStatus.ForPosting;
                var approverDone = Model.ApprovedAt.HasValue;
                var approverCurrent = !approverDone && Model.Status == MsapConstants.BillingStatus.Reviewed;
            }
            <section class="billing-approval-trail" aria-label="Billing approval progress">
                <div class="billing-approval-step is-done">
                    <span class="material-symbols-outlined billing-approval-icon" aria-hidden="true">check_circle</span>
                    <div>
                        <div class="ui-caption"><strong>1. Preparation</strong> · @Model.CreatedBy</div>
                        <div class="ui-caption ui-muted">Rev @Model.Revision · @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
                <div class="billing-approval-step @(reviewerDone ? "is-done" : reviewerRejected ? "is-attention" : reviewerCurrent ? "is-current" : "")">
                    <span class="material-symbols-outlined billing-approval-icon" aria-hidden="true">@(reviewerDone ? "check_circle" : reviewerRejected ? "error" : reviewerCurrent ? "pending" : "radio_button_unchecked")</span>
                    <div>
                        <div class="ui-caption">
                            <strong>2. Review</strong>
                            @if (reviewerDone)
                            {
                                <span> · @(Model.ReviewedByUser?.UserName ?? Model.ReviewedByUserId)</span>
                            }
                        </div>
                        <div class="ui-caption ui-muted">
                            @(reviewerDone
                                ? $"Rev {Model.ReviewedRevision} · {Model.ReviewedAt!.Value.ToString("dd MMM yyyy HH:mm")}"
                                : reviewerRejected
                                    ? "Revision requested"
                                    : reviewerCurrent
                                        ? "Awaiting commercial review"
                                        : "Pending")
                        </div>
                    </div>
                </div>
                <div class="billing-approval-step @(approverDone ? "is-done" : approverCurrent ? "is-current" : "")">
                    <span class="material-symbols-outlined billing-approval-icon" aria-hidden="true">@(approverDone ? "check_circle" : approverCurrent ? "pending" : "radio_button_unchecked")</span>
                    <div>
                        <div class="ui-caption">
                            <strong>3. Approval</strong>
                            @if (approverDone)
                            {
                                <span> · @(Model.ApprovedByUser?.UserName ?? Model.ApprovedByUserId)</span>
                            }
                        </div>
                        <div class="ui-caption ui-muted">
                            @(approverDone
                                ? $"Rev {Model.ApprovedRevision} · {Model.ApprovedAt!.Value.ToString("dd MMM yyyy HH:mm")}"
                                : approverCurrent
                                    ? "Awaiting final approval"
                                    : "Pending")
                        </div>
                    </div>
                </div>
            </section>
            @if (related != null)
            {
                <section class="ui-panel billing-section-heading" aria-label="Related billing">
                    <div><h2 class="ui-section-title">Related bill · @related.MsapBillingNumber</h2><p class="ui-caption ui-muted">@(bafOnly ? "Basic" : "BAF") · @related.Status · Separate balance</p></div>
                    <a asp-action="Review" asp-route-id="@related.MsapBillingId" class="modern-btn-secondary">Review related bill</a>
                </section>
            }
            <section class="ui-panel ui-stack" aria-label="Billing recipient and booking">
                <div class="billing-fields">
                    <div><span class="ui-caption ui-muted">Service customer</span><p class="ui-body">@Model.Customer.CustomerName</p></div>
                    <div><span class="ui-caption ui-muted">Bill to</span><p class="ui-body">@(Model.Principal?.PrincipalName ?? Model.Customer.CustomerName)</p></div>
                    <div><span class="ui-caption ui-muted">Vessel</span><p class="ui-body">@Model.Vessel.VesselName</p></div>
                    <div><span class="ui-caption ui-muted">Port / terminal</span><p class="ui-body">@Model.Port.PortName / @Model.Terminal.TerminalName</p></div>
                </div>
                <div class="billing-recipient">
                    <div><span class="ui-caption ui-muted">Statement address</span><p class="ui-body">@(Model.Principal?.Address ?? Model.Customer.CustomerAddress)</p></div>
                    <div><span class="ui-caption ui-muted">Statement TIN</span><p class="ui-body">@(Model.Principal?.TIN ?? Model.Customer.CustomerTin)</p></div>
                    <div class="@(hasTermsOverride ? "schedule-review-attention" : "")"><span class="ui-caption ui-muted">Payment terms @(hasTermsOverride ? "(Overridden)" : "")</span><p class="ui-body">@(string.IsNullOrWhiteSpace(Model.Terms) ? "—" : Model.Terms)</p></div>
                    <div class="@(hasDueDateChange ? "schedule-review-attention" : "")"><span class="ui-caption ui-muted">Due date @(hasDueDateChange ? "(Adjusted)" : "")</span><p class="ui-body">@Model.DueDate.ToString("dd MMM yyyy")</p></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="billing-remarks-card" style="background: var(--bg-subtle, #f8f9fa); border-left: 4px solid var(--primary, #0d6efd); padding: 0.75rem 1rem; border-radius: 4px;">
                        <span class="ui-caption ui-muted font-bold" style="display:flex; align-items:center; gap:0.25rem;">
                            <span class="material-symbols-outlined" style="font-size: 16px;" aria-hidden="true">notes</span>
                            Encoder Remarks for Approvers:
                        </span>
                        <p class="ui-body" style="margin: 0.25rem 0 0; white-space: pre-wrap;">@Model.Remarks</p>
                    </div>
                }
                <p class="ui-caption ui-muted">@(Model.IsVatable ? "VAT" : "Non-VAT") · @(Model.IsVatInclusive ? "VAT inclusive" : "VAT exclusive") · @(Model.PrintWht ? "Print withholding" : "No printed withholding") · @(Model.PrintDiscount ? "Print discount" : "Confidential discount")</p>
            </section>
            <section class="ui-panel ui-stack" aria-labelledby="reviewChargesHeading">
                <h2 id="reviewChargesHeading" class="ui-section-title">@component charges for review</h2>
                <div class="billing-table-scroll">
                    <table class="billing-service-table" style="font-size: 0.95rem;">
                        <thead><tr><th>Service / ticket</th><th>Actual / billed hours</th><th>Basic rate</th><th>BAF rate</th><th>Source · Basic / BAF</th><th>After discount</th></tr></thead>
                        <tbody>
                            @foreach (var group in (Model.PaidDispatchTickets ?? []).GroupBy(t => t.Tugboat.TugboatName))
                            {
                                <tr class="billing-tugboat-row"><th colspan="6" scope="rowgroup">@group.Key<span class="billing-tugboat-owner ui-caption ui-muted">@(group.First().Tugboat.IsCompanyOwned ? "Company-owned" : "Subcontractor")</span></th></tr>
                                @foreach (var ticket in group)
                                {
                                    var ticketChanges = billingChanges.Where(c =>
                                        c.Field.Contains($"Ticket_{ticket.DispatchTicketId}_", StringComparison.OrdinalIgnoreCase)
                                        || c.Field.Contains(ticket.DispatchNumber, StringComparison.OrdinalIgnoreCase)
                                        || c.Label.Contains(ticket.DispatchNumber, StringComparison.OrdinalIgnoreCase)).ToList();
                                    var ticketHasOverride = ticketChanges.Count > 0;
                                    var basicRateChange = ticketChanges.FirstOrDefault(c => c.Field.EndsWith("_DispatchRate", StringComparison.OrdinalIgnoreCase) || c.Field.EndsWith("_DispatchBasis", StringComparison.OrdinalIgnoreCase));
                                    var bafRateChange = ticketChanges.FirstOrDefault(c => c.Field.EndsWith("_BafRate", StringComparison.OrdinalIgnoreCase) || c.Field.EndsWith("_BafBasis", StringComparison.OrdinalIgnoreCase));
                                    var netAmountChange = ticketChanges.FirstOrDefault(c => c.Field.EndsWith("_NetAmount", StringComparison.OrdinalIgnoreCase));
                                    var basicRateOverridden = basicRateChange != null;
                                    var bafRateOverridden = bafRateChange != null;
                                    var netAmountOverridden = netAmountChange != null;
                                    <tr style="@(ticketHasOverride ? "background: rgba(245, 158, 11, 0.08);" : "")">
                                        <td>
                                            <strong>@ticket.Service.ServiceName</strong><span class="billing-ticket-number"><strong>@ticket.DispatchNumber</strong></span>
                                            @if (ticketHasOverride)
                                            {
                                                <span class="schedule-status-pill ui-status ui-attention" style="margin-left: 0.35rem;">Overridden</span>
                                            }
                                        </td>
                                        <td>@(ticket.RawDurationHours?.ToString("N2") ?? "—") / <strong>@ticket.TotalHours.ToString("N2")</strong></td>
                                        <td class="@(basicRateOverridden ? "schedule-review-attention" : "")" style="@(basicRateOverridden ? "background: rgba(245, 158, 11, 0.16);" : "")">
                                            @if (bafOnly)
                                            {
                                                <span>—</span>
                                            }
                                            else
                                            {
                                                <strong>@ticket.DispatchRate.ToString("N2")</strong> <span>(@(ticket.DispatchChargeType ?? "Per hour"))</span>
                                            }
                                            @if (basicRateChange != null && !string.IsNullOrWhiteSpace(basicRateChange.Before))
                                            {
                                                <small class="ui-caption d-block">Revised from <strong>@basicRateChange.Before</strong></small>
                                            }
                                        </td>
                                        <td class="@(bafRateOverridden ? "schedule-review-attention" : "")" style="@(bafRateOverridden ? "background: rgba(245, 158, 11, 0.16);" : "")">
                                            @if (basicOnly)
                                            {
                                                <span>—</span>
                                            }
                                            else
                                            {
                                                <strong>@ticket.BAFRate.ToString("N2")</strong> <span>(@(ticket.BAFChargeType ?? "Per hour"))</span>
                                            }
                                            @if (bafRateChange != null && !string.IsNullOrWhiteSpace(bafRateChange.Before))
                                            {
                                                <small class="ui-caption d-block">Revised from <strong>@bafRateChange.Before</strong></small>
                                            }
                                        </td>
                                        <td>@(bafOnly ? "—" : ticket.IsManualTariffRate ? "Manual" : "Table") / @(basicOnly ? "—" : ticket.IsManualBafRate ? "Manual" : "Table")</td>
                                        <td class="@(netAmountOverridden ? "schedule-review-attention" : "")" style="@(netAmountOverridden ? "background: rgba(245, 158, 11, 0.16);" : "")">
                                            <strong>@(bafOnly ? ticket.BAFNetRevenue.ToString("N2") : basicOnly ? ticket.DispatchNetRevenue.ToString("N2") : ticket.TotalNetRevenue.ToString("N2"))</strong>
                                            @if (netAmountChange != null && !string.IsNullOrWhiteSpace(netAmountChange.Before))
                                            {
                                                <small class="ui-caption d-block">Revised from <strong>@netAmountChange.Before</strong></small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="ui-panel ui-stack" aria-label="Saved billing totals">
                <h2 class="ui-section-title">@Model.MsapBillingNumber · @component amounts</h2>
                @{
                    var discountChange = billingChanges.FirstOrDefault(c => c.Field == "DiscountAmount");
                    var discountMetaChanged = billingChanges.Any(c => c.Field.Contains("Discount", StringComparison.OrdinalIgnoreCase));
                    var dispatchChange = billingChanges.FirstOrDefault(c => c.Field == "DispatchAmount");
                    var bafChange = billingChanges.FirstOrDefault(c => c.Field == "BAFAmount");
                    var amountChange = billingChanges.FirstOrDefault(c => c.Field == "Amount");
                    var discountScopeLabel = (Model.DiscountOnTariff, Model.DiscountOnBaf) switch
                    {
                        (true, true) => "Total (Basic & BAF)",
                        (true, false) => "Basic (Tariff) only",
                        (false, true) => "BAF only",
                        _ => "None"
                    };
                    var discountModeLabel = string.Equals(Model.DiscountType, "Flat", StringComparison.OrdinalIgnoreCase)
                        ? "Flat"
                        : "Percentage";
                }
                <div class="billing-totals-row">
                    <div class="billing-total-item @(discountMetaChanged ? "schedule-review-attention" : "")">
                        <span class="ui-caption ui-muted"><strong>Discount · @discountModeLabel · @discountScopeLabel @(discountMetaChanged ? "(Overridden)" : "")</strong></span>
                        <strong class="ui-body">@Model.Discount.ToString("N2")</strong>
                        @if (discountChange != null)
                        {
                            <small class="ui-caption">Revised from <strong>@discountChange.Before</strong></small>
                        }
                    </div>
                    <div class="billing-total-item @(dispatchChange != null ? "schedule-review-attention" : "")">
                        <span class="ui-caption ui-muted"><strong>Basic after discount</strong></span>
                        <strong class="ui-body">@Model.DispatchAmount.ToString("N2")</strong>
                        @if (dispatchChange != null)
                        {
                            <small class="ui-caption">Revised from <strong>@dispatchChange.Before</strong></small>
                        }
                    </div>
                    <div class="billing-total-item @(bafChange != null ? "schedule-review-attention" : "")">
                        <span class="ui-caption ui-muted"><strong>BAF after discount</strong></span>
                        <strong class="ui-body">@Model.BAFAmount.ToString("N2")</strong>
                        @if (bafChange != null)
                        {
                            <small class="ui-caption">Revised from <strong>@bafChange.Before</strong></small>
                        }
                    </div>
                    <div class="billing-total-item is-primary @(amountChange != null ? "schedule-review-attention" : "")">
                        <span class="ui-caption ui-muted"><strong>Statement total</strong></span>
                        <strong class="ui-body text-primary">@Model.Amount.ToString("N2")</strong>
                        @if (amountChange != null)
                        {
                            <small class="ui-caption">Revised from <strong>@amountChange.Before</strong></small>
                        }
                    </div>
                    <div class="billing-total-item">
                        <span class="ui-caption ui-muted"><strong>Remaining balance</strong></span>
                        <strong class="ui-body">@Model.Balance.ToString("N2")</strong>
                    </div>
                </div>
                @if (Model.AgencyIncentiveAmount > 0 || Model.AgentCommissionAmount > 0
                    || !string.IsNullOrWhiteSpace(Model.AgencyIncentiveName) || !string.IsNullOrWhiteSpace(Model.AgentCommissionName))
                {
                    var incChanged = billingChanges.Any(c => c.Field.StartsWith("AgencyIncentive", StringComparison.OrdinalIgnoreCase));
                    var comChanged = billingChanges.Any(c => c.Field.StartsWith("AgentCommission", StringComparison.OrdinalIgnoreCase));
                    <div class="billing-recipient" aria-label="Internal rebates and commissions">
                        <div class="@(incChanged ? "schedule-review-attention" : "")">
                            <span class="ui-caption ui-muted">Agency incentive (internal only)</span>
                            <p class="ui-body mb-0">
                                <strong>@(Model.AgencyIncentiveName ?? "—")</strong>
                                @if (Model.AgencyIncentiveAmount > 0)
                                {
                                    <span>· ₱@Model.AgencyIncentiveAmount.ToString("N2")</span>
                                    <span class="ui-caption ui-muted">(@(Model.AgencyIncentiveMode == "Flat" ? $"Flat ₱{Model.AgencyIncentiveRate:N2}" : $"{Model.AgencyIncentiveRate:0.##}% of {Model.AgencyIncentiveBase}"))</span>
                                }
                            </p>
                        </div>
                        <div class="@(comChanged ? "schedule-review-attention" : "")">
                            <span class="ui-caption ui-muted">Agent commission (internal only)</span>
                            <p class="ui-body mb-0">
                                <strong>@(Model.AgentCommissionName ?? "—")</strong>
                                @if (Model.AgentCommissionAmount > 0)
                                {
                                    <span>· ₱@Model.AgentCommissionAmount.ToString("N2")</span>
                                    <span class="ui-caption ui-muted">(@(Model.AgentCommissionMode == "Flat" ? $"Flat ₱{Model.AgentCommissionRate:N2}" : $"{Model.AgentCommissionRate:0.##}% of {Model.AgentCommissionBase}"))</span>
                                }
                            </p>
                        </div>
                    </div>
                }
                @if (basicOnly)
                {
                    <p class="ui-notice ui-attention" role="note"><span class="material-symbols-outlined" aria-hidden="true">info</span> Reminder: confirm SBMA placement and financial treatment.</p>
                }
            </section>
            @{
                var ticketImages = (Model.PaidDispatchTickets ?? [])
                    .Where(t => !string.IsNullOrEmpty(t.ImageSignedUrl))
                    .ToList();
            }
            <section class="ui-stack" aria-labelledby="ticketImagesHeading">
                <div class="flex justify-between items-center w-full flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        <h2 id="ticketImagesHeading" class="ui-section-title mb-0">Ticket images</h2>
                        @if (ticketImages.Count > 0)
                        {
                            <span class="modern-badge-sm status-billing">@ticketImages.Count</span>
                        }
                    </div>
                    @if (ticketImages.Count > 1)
                    {
                        <div class="flex gap-2">
                            <button type="button" class="modern-btn-secondary" id="toggleAllTicketImages" data-expanded="false">
                                <span class="material-symbols-outlined" aria-hidden="true">unfold_more</span> Expand all
                            </button>
                        </div>
                    }
                </div>
                @if (ticketImages.Count > 0)
                {
                    <div class="ui-stack" id="ticketImagesAccordion">
                        @foreach (var dt in ticketImages)
                        {
                            <details class="modern-card ui-card js-ticket-image-fold">
                                <summary class="modern-card-header-action flex justify-between items-center w-full ui-card-header" style="cursor: pointer; list-style: none;">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary" aria-hidden="true">image</span>
                                        <span class="ui-body"><strong>Dispatch Ticket #@dt.DispatchNumber</strong></span>
                                        <span class="ui-caption ui-muted">@(dt.Tugboat?.TugboatName ?? "—") · @(dt.Service?.ServiceName ?? "—")</span>
                                    </div>
                                    <span class="material-symbols-outlined ui-muted js-fold-icon" aria-hidden="true">expand_more</span>
                                </summary>
                                <div class="modern-card-body ui-card-body text-center">
                                    <img src="@dt.ImageSignedUrl" alt="Dispatch Ticket @dt.DispatchNumber" loading="lazy" style="max-width: 100%; max-height: 85vh; object-fit: contain;" />
                                </div>
                            </details>
                        }
                    </div>
                }
                else
                {
                    <p class="ui-caption ui-muted">No ticket images are available.</p>
                }
            </section>
            <footer class="billing-footer">
                @if (Model.Status == MsapConstants.BillingStatus.ForPosting)
                {
                    <p class="ui-caption ui-muted">Stage 1 of 2: Commercial review for @Model.MsapBillingNumber.</p>
                    <div class="billing-footer-actions">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (canDiscard)
                            {
                                <button type="button" class="modern-btn-error" id="btnDiscardDraft"
                                    data-action="@Url.Action("Delete", "Billing")"
                                    data-id="@Model.MsapBillingId">
                                    <span class="material-symbols-outlined" aria-hidden="true">delete</span> Discard draft
                                </button>
                            }
                            @if (canEditDraft)
                            {
                                <a asp-action="Create" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="modern-btn-secondary">
                                    <span class="material-symbols-outlined" aria-hidden="true">edit</span> Edit billing
                                </a>
                            }
                            @if (canAdjust)
                            {
                                <a asp-action="Adjust" asp-route-id="@Model.MsapBillingId" class="modern-btn-secondary">
                                    <span class="material-symbols-outlined" aria-hidden="true">tune</span> Adjust billing
                                </a>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (canReject)
                            {
                                <button type="button" class="modern-btn-secondary" id="btnRejectBilling"
                                    data-action="@Url.Action("Reject", "Billing")"
                                    data-id="@Model.MsapBillingId"
                                    data-billing-number="@Model.MsapBillingNumber">
                                    <span class="material-symbols-outlined" aria-hidden="true">reply</span> Request revision
                                </button>
                            }
                            @if (canReview)
                            {
                                <form asp-action="EndorseReview" asp-route-id="@Model.MsapBillingId" method="post" id="endorseReviewedBilling" class="d-inline">
                                    <input type="hidden" name="reviewedRevision" value="@Model.Revision" />
                                    <button class="modern-btn-primary ui-page-action" type="submit">
                                        <span class="material-symbols-outlined" aria-hidden="true">fact_check</span> Endorse for approval
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="@(blocker != null || (ViewData["IsPeriodClosed"] is true && !isReopenedOrFinalized) ? "ui-notice ui-critical" : "ui-caption ui-muted")">@(blocker ?? (ViewData["IsPeriodClosed"] is true && !isReopenedOrFinalized ? "This accounting period is closed." : "Waiting for an authorized commercial reviewer."))</span>
                            }
                        </div>
                    </div>
                }
                else if (Model.Status == MsapConstants.BillingStatus.Reviewed)
                {
                    <p class="ui-caption ui-muted">Stage 2 of 2: Final approval applies to @Model.MsapBillingNumber only.</p>
                    <div class="billing-footer-actions">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="ui-caption ui-muted">Reviewed by @(Model.ReviewedByUser?.UserName ?? Model.ReviewedByUserId) on @Model.ReviewedAt?.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (canReject)
                            {
                                <button type="button" class="modern-btn-secondary" id="btnRejectBilling"
                                    data-action="@Url.Action("Reject", "Billing")"
                                    data-id="@Model.MsapBillingId"
                                    data-billing-number="@Model.MsapBillingNumber">
                                    <span class="material-symbols-outlined" aria-hidden="true">reply</span> Request revision
                                </button>
                            }
                            @if (canPost)
                            {
                                <form asp-action="Review" asp-route-id="@Model.MsapBillingId" method="post" id="postReviewedBilling" class="d-inline">
                                    <input type="hidden" name="reviewedRevision" value="@Model.Revision" />
                                    <button class="modern-btn-primary ui-page-action" type="submit">
                                        <span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Approve final bill @Model.MsapBillingNumber
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="@(blocker != null || (ViewData["IsPeriodClosed"] is true && !isReopenedOrFinalized) ? "ui-notice ui-critical" : "ui-caption ui-muted")">@(blocker ?? (ViewData["IsPeriodClosed"] is true && !isReopenedOrFinalized ? "This accounting period is closed." : "Waiting for an authorized final-bill approver."))</span>
                            }
                        </div>
                    </div>
                }
                else if (canReverse)
                {
                    <div class="d-flex justify-content-between align-items-center w-100 flex-wrap gap-2">
                        <p class="ui-caption ui-muted mb-0">This billing is approved for collection.</p>
                        <button type="button" class="modern-btn-secondary" id="btnReopenBilling"
                            data-action="@Url.Action("ReopenForRevision", "Billing")"
                            data-id="@Model.MsapBillingId"
                            data-billing-number="@Model.MsapBillingNumber"
                            data-finalized="@(Model.PeriodStatus == MsapPeriodStatus.Final ? "true" : "false")">
                            <span class="material-symbols-outlined" aria-hidden="true">history</span> Reopen for revision
                        </button>
                    </div>
                }
                else
                {
                    <p class="@(blocker != null || (ViewData["IsPeriodClosed"] is true && !isReopenedOrFinalized) ? "ui-notice ui-critical" : "ui-caption ui-muted")">@(blocker ?? (ViewData["IsPeriodClosed"] is true && !isReopenedOrFinalized ? "This accounting period is closed." : "This billing has already been approved."))</p>
                }
            </footer>
        </main>
    </div>
</div>

<form id="discardBillingForm" method="post" style="display:none;">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '.ui-page-header', title: 'Review this numbered bill', text: 'Check the billing number, component and approval status. Preview statements opens the statement for this bill.', interactive: false },
            { selector: '[aria-label="Related billing"]', title: 'Separate Basic and BAF bills', text: 'The related bill has its own balance and approval. Open it to review the other component separately.', interactive: false },
            { selector: '[aria-label="Billing recipient and booking"]', title: 'Recipient and booking', text: 'Confirm the service customer, billed party, vessel, location, statement address, TIN, terms and tax information.', interactive: false },
            { selector: '[aria-labelledby="reviewChargesHeading"]', title: 'Review the service charges', text: 'Check the tickets, actual and billed hours, Basic and BAF rates, rate sources and saved amounts for this bill.', interactive: false },
            { selector: '[aria-label="Saved billing totals"]', title: 'Saved totals and balance', text: 'Compare the saved Basic and BAF charges with the statement total and remaining billing balance.', interactive: false },
            { selector: '[aria-labelledby="ticketImagesHeading"]', title: 'Supporting tickets', text: 'Review the available ticket images against the services and amounts before final approval.', interactive: false },
            { selector: '.billing-footer', title: 'Final approval', text: 'An authorized approver can approve this numbered bill when its checks are satisfied. Read any blocker here. Approval applies only to this bill; review a related Basic or BAF bill separately.', interactive: false }
        ].filter(function (step) {
            return document.querySelector(step.selector);
        });
    </script>
    <script>
        $('#btnReopenBilling').on('click', async function () {
            const btn = this;
            const isFinal = btn.dataset.finalized === 'true';
            const billingNo = btn.dataset.billingNumber;
            const text = isFinal
                ? 'Reopening this billing returns it to For Posting, unlocks linked tickets and COS for revision, voids its Sales Book entry, and tags this finalized-period bill as Adjusted in the audit history.'
                : 'Reopening this billing returns it to For Posting, unlocks linked tickets and COS for revision, and voids its recorded Sales Book entry.';
            const confirmResult = await ModernAlert.promptAdjustment({
                title: `Reopen billing #${billingNo}?`,
                text,
                placeholder: 'Reason for revision',
                confirmText: 'Reopen for revision',
                cancelText: 'Keep approved',
                requireAttachment: isFinal
            });

            if (!confirmResult.isConfirmed) return;

            ModernAlert.showLoading('Reopening billing for revision...');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const form = document.createElement('form');
            form.method = 'POST';
            form.enctype = 'multipart/form-data';
            form.action = btn.dataset.action;
            form.innerHTML = `
                <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                <input type="hidden" name="id" value="${btn.dataset.id}" />
                <input type="hidden" name="reason" value="${confirmResult.value.reason.replace(/"/g, '&quot;')}" />
            `;
            if (confirmResult.value.file) {
                const fileInput = document.createElement('input');
                fileInput.type = 'file';
                fileInput.name = 'authorizationFile';
                const dt = new DataTransfer();
                dt.items.add(confirmResult.value.file);
                fileInput.files = dt.files;
                form.appendChild(fileInput);
            }
            document.body.appendChild(form);
            form.submit();
        });

        $('#btnDiscardDraft').on('click', async function () {
            const btn = this;
            const confirmResult = await ModernAlert.confirm({
                title: 'Discard this billing preparation?',
                text: 'This discards the unapproved draft and any paired Basic/BAF draft. Actual service tickets and charges are kept and become available for preparation again.',
                icon: 'warning',
                confirmText: 'Discard draft',
                cancelText: 'Keep draft'
            });
            if (confirmResult.isConfirmed) {
                ModernAlert.showLoading('Discarding draft billing...');
                const form = document.getElementById('discardBillingForm');
                form.action = `${btn.dataset.action}/${btn.dataset.id}`;
                form.submit();
            }
        });

        $('#btnRejectBilling').on('click', async function () {
            const btn = this;
            const billingNo = btn.dataset.billingNumber;
            const confirmResult = await ModernAlert.prompt({
                title: `Request revision for billing #${billingNo}?`,
                text: 'Provide a clear reason for returning this billing to the encoder. This unlocks rate and discount adjustments with a required authorization document.',
                inputPlaceholder: 'Reason for revision (minimum 5 characters)',
                confirmText: 'Return to encoder',
                cancelText: 'Cancel',
                required: true
            });
            if (!confirmResult.isConfirmed) return;

            ModernAlert.showLoading('Returning billing for revision...');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = btn.dataset.action;
            form.innerHTML = `
                <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                <input type="hidden" name="id" value="${btn.dataset.id}" />
                <input type="hidden" name="reason" value="${String(confirmResult.value || '').replace(/"/g, '&quot;')}" />
            `;
            document.body.appendChild(form);
            form.submit();
        });

        $('#endorseReviewedBilling').on('submit', async function (event) {
            event.preventDefault();
            const form = this;
            const button = form.querySelector('button');
            if (button.disabled) return;
            button.disabled = true;
            try {
                const result = await ModernAlert.confirm({ title: 'Endorse billing for final approval?', text: 'Confirm you have reviewed the commercial rates, discounts, and supporting tickets.', confirmText: 'Endorse for approval', cancelText: 'Keep reviewing' });
                if (result.isConfirmed) form.submit();
            } finally {
                button.disabled = false;
            }
        });

        $('#postReviewedBilling').on('submit', async function (event) {
            event.preventDefault();
            const form = this;
            const button = form.querySelector('button');
            if (button.disabled) return;
            button.disabled = true;
            try {
                const result = await ModernAlert.confirm({ title: 'Approve this final bill?', text: 'Approve this numbered bill after reviewing its charges, statement and ticket images.', confirmText: 'Approve final bill', cancelText: 'Keep reviewing' });
                if (result.isConfirmed) form.submit();
            } finally {
                button.disabled = false;
            }
        });

        (function () {
            const folds = document.querySelectorAll('.js-ticket-image-fold');
            const toggleAllBtn = document.getElementById('toggleAllTicketImages');
            folds.forEach(function (details) {
                details.addEventListener('toggle', function () {
                    const icon = details.querySelector('.js-fold-icon');
                    if (icon) icon.textContent = details.open ? 'expand_less' : 'expand_more';
                });
            });
            if (toggleAllBtn) {
                toggleAllBtn.addEventListener('click', function () {
                    const expand = toggleAllBtn.dataset.expanded !== 'true';
                    folds.forEach(function (details) { details.open = expand; });
                    toggleAllBtn.dataset.expanded = String(expand);
                    toggleAllBtn.innerHTML = expand
                        ? '<span class="material-symbols-outlined" aria-hidden="true">unfold_less</span> Collapse all'
                        : '<span class="material-symbols-outlined" aria-hidden="true">unfold_more</span> Expand all';
                });
            }
        })();
    </script>
}
