@{


    ViewData["Title"] = "Billing Statements";
    ViewData["IsFullWidth"] = true;
    var jobProgress = ViewBag.JobProgressItems as IEnumerable<JobProgressViewModel>;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Billing</span>
                </div>
                <h1 class="modern-headline-lg" data-page-header>@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                @if (ViewBag.JobOrderId != null)
                {
                    <a asp-action="Index" asp-route-jobOrderId="" asp-route-id="" class="modern-btn-secondary">All Billings</a>
                }
                @if (ViewBag.CanPost == true && (jobProgress == null || jobProgress.Any(p => p.Stage == JobProgressCalculator.BillingStage && !p.Stopped)))
                {
                    <a asp-action="Create" asp-route-jobOrderId="@ViewBag.JobOrderId" class="modern-btn-primary" data-hotkey="c">
                        <span class="material-symbols-outlined">add_circle</span>
                        CREATE BILLING
                    </a>
                }
            </div>
        </div>

        @if (ViewBag.JobProgressItems is IEnumerable<JobProgressViewModel> progress)
        {
            <partial name="_JobProgressList" model="progress" />
        }

        <!-- Filter Group -->
        <div class="flex flex-wrap gap-2">
            <button id="filterAll" class="modern-btn-secondary active">ALL</button>
            <button id="filterForPosting" class="modern-btn-secondary">FOR POSTING</button>
            <button id="filterForCollection" class="modern-btn-secondary">FOR COLLECTION</button>
            <button id="filterCollected" class="modern-btn-secondary">COLLECTED</button>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">receipt_long</span>
                    <h2 class="modern-headline-md">Billing List</h2>
                </div>
                <div class="flex items-center gap-2">
                    <label class="modern-label mb-0" style="color: var(--on-surface-variant)">Filter by Date:</label>
                    <input type="date" id="dateFilter" class="modern-input" style="height: 32px; padding: 0 12px; font-size: 0.875rem; border-radius: 6px;">
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="paginatedTable">
                    <thead>
                        <tr>
                            <th>DATE</th>
                            <th>BILLING #</th>
                            <th>AMOUNT</th>
                            <th>CUSTOMER</th>
                            <th>PORT - TERMINAL</th>
                            <th>VESSEL</th>
                            <th>DISPATCH TICKET #</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
    .modern-btn-secondary.active {
        background-color: var(--primary);
        color: white;
        border-color: var(--primary);
    }
</style>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '#filterAll', title: 'Billing stages', text: 'Filter statements waiting for posting, collection, or already collected. A billing must be posted before collection.', interactive: false },
            { selector: '#dateFilter', title: 'Filter by date', text: 'Choose a billing date to narrow the list.', interactive: false },
            { selector: '#paginatedTable', title: 'Billing list', text: 'Open a billing number to review the statement. Available actions depend on its status, month close, and your access.', interactive: false }
        ];
        if (document.querySelector('.flex-stack .modern-btn-primary')) {
            window.IBS_TOUR_STEPS.unshift({ selector: '.flex-stack .modern-btn-primary', title: 'Create billing', text: 'Create a statement for eligible approved Dispatch Tickets. The saved billing waits for a separate posting action.', interactive: false });
        }
        if (document.querySelector('.financial-job-progress .job-progress')) {
            window.IBS_TOUR_STEPS.unshift({ selector: '.financial-job-progress', title: 'Job progress', text: 'Review the linked Job Order stage and its next available action before posting or collecting.', interactive: false });
        }
    </script>
    <script>
        $(document).ready(function () {
            const previewUrl = '@Url.Action("Preview", "Billing")';
            const editUrl = '@Url.Action("Edit", "Billing")';
            const postUrl = '@Url.Action("Post", "Billing")';
            const canReverse = @((ViewBag.CanReverse as bool? ?? false).ToString().ToLower());
            const canPost = @((ViewBag.CanPost as bool? ?? false).ToString().ToLower());
            const canEdit = @((ViewBag.CanEdit as bool? ?? false).ToString().ToLower());
            const canDelete = @((ViewBag.CanDelete as bool? ?? false).ToString().ToLower());

            // Get status from URL on load
            const urlParams = new URLSearchParams(window.location.search);
            const statusFilter = urlParams.get('status') || '';
            const billingNumber = urlParams.get('billingNumber') || '';

            let table = $('#paginatedTable').DataTable(ModernTable.config({
                order: [[0, 'desc']],
                columnDefs: [{ orderable: false, targets: [8] }],
                ajax: ModernTable.ajax("@Url.Action("GetBillingList", "Billing", new { area = "MSAP", jobOrderId = ViewBag.JobOrderId })"),
                columns: [
                    { data: "date", defaultContent: "" },
                    {
                        data: "msapBillingNumber",
                        render: (data, type, row) => `<a href="${previewUrl}?id=${row.msapBillingId}" class="font-bold" style="text-decoration:none; color: var(--primary)">${data}</a>`
                    },
                    {
                        data: "amount",
                        className: "text-right font-bold",
                        render: (data) => ModernTable.render.currency(data)
                    },
                    { data: "customer.customerName", defaultContent: "" },
                    {
                        data: null,
                        orderable: false,
                        render: (data, type, row) => {
                            const portName = row.terminal?.port?.portName ?? "";
                            const terminalName = row.terminal?.terminalName ?? "";
                            return portName || terminalName ? `${portName} - ${terminalName}` : "";
                        }
                    },
                    { data: "vessel.vesselName", defaultContent: "" },
                    {
                        data: "dispatchTicketNumbers",
                        render: (data, type, row) => {
                            if (!data) return "";
                            const parts = data.split(", ");
                            if (parts.length <= 3) return data;
                            return `<span title="${data.replace(/"/g, '&quot;')}">${parts.slice(0, 3).join(", ")} +${parts.length - 3} more</span>`;
                        }
                    },
                    {
                        data: "status",
                        className: "text-center",
                        render: (data) => {
                            let statusClass = "status-open";
                            if (data === "@MsapConstants.BillingStatus.ForPosting") statusClass = "status-tariff";
                            else if (data === "@MsapConstants.BillingStatus.ForCollection") statusClass = "status-approval";
                            else if (data === "@MsapConstants.BillingStatus.Collected") statusClass = "status-closed";
                            return ModernTable.render.badge(data, statusClass);
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => {
                            if (row.status === "@MsapConstants.BillingStatus.ForPosting") {
                                return ModernTable.render.dropdown([
                                    { label: 'View Details', icon: 'visibility', url: `${previewUrl}?id=${row.msapBillingId}` },
                                    { label: 'Post to Books', icon: 'send', onclick: `confirmPost(${row.msapBillingId})`, condition: !row.isMonthClosed && canPost },
                                    { label: 'Edit', icon: 'edit', url: `${editUrl}?id=${row.msapBillingId}`, condition: !row.isMonthClosed && canEdit },
                                    { label: 'Delete', icon: 'delete', isError: true, onclick: `confirmDelete(${row.msapBillingId})`, condition: !row.isMonthClosed && canDelete }
                                ]);
                            } else if (row.status === "@MsapConstants.BillingStatus.ForCollection") {
                                return ModernTable.render.dropdown([
                                    { label: 'View Details', icon: 'visibility', url: `${previewUrl}?id=${row.msapBillingId}` },
                                    { label: 'Reverse (Unpost)', icon: 'undo', onclick: `confirmReverse(${row.msapBillingId})`, condition: !row.isMonthClosed && canReverse }
                                ]);
                            } else {
                                return ModernTable.render.dropdown([
                                    { label: 'View Details', icon: 'visibility', url: `${previewUrl}?id=${row.msapBillingId}` }
                                ]);
                            }
                        }
                    }
                ],
                initComplete: function() {
                    if (statusFilter) {
                        this.api().column(7).search(statusFilter);
                        updateFilterButtons(statusFilter);
                    }
                    if (billingNumber) {
                        this.api().search(billingNumber);
                    }
                    if (statusFilter || billingNumber) {
                        this.api().draw();
                    }
                }
            }));

            // Date filter handler
            $('#dateFilter').on('change', function() {
                table.column(0).search($(this).val()).draw();
            });

            // Filter button handlers
            $('.modern-btn-secondary[id^="filter"]').on('click', function() {
                const id = $(this).attr('id');
                let status = '';
                if (id === 'filterForPosting') status = "@MsapConstants.BillingStatus.ForPosting";
                else if (id === 'filterForCollection') status = "@MsapConstants.BillingStatus.ForCollection";
                else if (id === 'filterCollected') status = "@MsapConstants.BillingStatus.Collected";

                table.column(7).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            function updateUrl(status) {
                const url = new URL(window.location);
                if (status) url.searchParams.set('status', status);
                else url.searchParams.delete('status');
                window.history.replaceState({}, '', url);
            }

            function updateFilterButtons(status) {
                $('.modern-btn-secondary').removeClass('active');
                if (!status) $('#filterAll').addClass('active');
                else if (status === "@MsapConstants.BillingStatus.ForPosting") $('#filterForPosting').addClass('active');
                else if (status === "@MsapConstants.BillingStatus.ForCollection") $('#filterForCollection').addClass('active');
                else if (status === "@MsapConstants.BillingStatus.Collected") $('#filterCollected').addClass('active');
            }
        });

        function confirmPost(id) {
            ModernAlert.confirm({
                title: 'Post to Books?',
                text: "This will post the billing to the Sales Book. Continue?",
                icon: 'question',
                confirmText: 'Yes, post it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    ModernAlert.showLoading("Posting to books...");
                    window.location.href = '@Url.Action("Post", "Billing")?id=' + id;
                }
            });
        }

        function confirmDelete(id) {
            ModernAlert.confirm({
                title: 'Are you sure?',
                text: "This will delete the draft billing and return all dispatch tickets to the queue.",
                icon: 'warning',
                confirmText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    ModernAlert.showLoading("Deleting billing...");
                    window.location.href = '@Url.Action("Delete", "Billing")?id=' + id;
                }
            });
        }

        function confirmReverse(id) {
            ModernAlert.prompt({
                title: 'Reverse Billing?',
                text: "This will unpost the billing and return all dispatch tickets to 'For Billing' status.",
                icon: 'warning',
                placeholder: 'Enter reason for reversal...',
                confirmText: 'Yes, reverse it!',
                validator: (value) => value ? null : 'Please enter a reason for the reversal.'
            }).then((result) => {
                if (result.isConfirmed) {
                    ModernAlert.showLoading("Reversing billing...");
                    window.location.href = '@Url.Action("Reverse", "Billing")?id=' + id + '&remarks=' + encodeURIComponent(result.value);
                }
            });
        }
    </script>
}
