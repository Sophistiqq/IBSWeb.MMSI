@using System.Security.Claims
@using IBS.Services.MSAP.AccessControl
@inject IAccessControlService AccessControl
@model Collection
@{
    ViewData["Title"] = "Collection receipt " + Model.MsapCollectionNumber;
    ViewData["IsFullWidth"] = true;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    bool canPrepare = userId != null && await AccessControl.HasAccessAsync(userId, ProcedureEnum.CreateCollection);
    bool canBank = userId != null && await AccessControl.HasAccessAsync(userId, ProcedureEnum.AccessTreasury);
    bool canRevertBankingPermission = userId != null && await AccessControl.HasAccessAsync(userId, ProcedureEnum.RevertCollectionBanking);
    bool canReverseBillingPermission = userId != null && await AccessControl.HasAccessAsync(userId, ProcedureEnum.ReverseBilling);
    ViewData["JobProgressActionStage"] = Model.DepositDate.HasValue ? JobProgressCalculator.ClearingStage : JobProgressCalculator.DepositStage;
    ViewData["JobProgressActionTargetId"] = Model.MsapCollectionId;
    bool isFinalOrAdjusted = Model.PeriodStatus is MsapPeriodStatus.Final or MsapPeriodStatus.Adjusted;
    bool canEdit = canPrepare && !Model.IsVoided && (!Model.IsMonthClosed || isFinalOrAdjusted) && !Model.DepositDate.HasValue && !Model.ReturnedDate.HasValue && !Model.ClearedDate.HasValue;
    bool canRevertBanking = canRevertBankingPermission && !Model.IsVoided && (!Model.IsMonthClosed || isFinalOrAdjusted) && (Model.DepositDate.HasValue || Model.ClearedDate.HasValue);
    bool canVoid = (canRevertBankingPermission || canReverseBillingPermission) && !Model.IsVoided && (!Model.IsMonthClosed || isFinalOrAdjusted) && !Model.DepositDate.HasValue && !Model.ClearedDate.HasValue;
    var progressItems = (ViewBag.JobProgressItems as IEnumerable<JobProgressViewModel> ?? []).ToList();
}
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/collection-form.css" asp-append-version="true" />
<div class="modern-layout app-ui collection-form">
    <main class="collection-workspace">
        <aside class="ui-panel schedule-details-progress" aria-label="Job Progress">
            @if (progressItems.Count > 0)
            {
                <partial name="_JobProgressList" model="progressItems" />
            }
            else
            {
                <h2 class="ui-section-title">Job Progress</h2>
                <p class="ui-caption ui-muted">No COS is linked to this receipt.</p>
            }
        </aside>
        <div class="ui-stack collection-content">
            <header class="ui-page-header">
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li><a asp-action="Index">Collections</a></li><li aria-current="page">@Model.MsapCollectionNumber</li></ol></nav>
                <h1 class="ui-page-title" data-page-header>Receipt @Model.MsapCollectionNumber</h1>
                <a asp-action="Index" class="modern-btn-secondary ui-page-action" data-ui-back>Back</a>
                <div class="ui-page-description flex items-center gap-2">
                    <span class="schedule-status-pill ui-status @(Model.PaymentStatus is "Returned" or "Voided" ? "ui-critical" : Model.PaymentStatus == "Cleared" ? "ui-complete" : "ui-attention")">@Model.PaymentStatus</span>
                    <span class="ui-caption ui-muted">@(Model.IsUndocumented ? "Undocumented" : "Documented") · @Model.Date.ToString(MsapConstants.Date_Format)</span>
                </div>
            </header>
            @if (Model.IsVoided)
            {
                <div class="ui-panel ui-critical" role="alert">
                    <p class="ui-body mb-1">
                        <strong>Voided receipt</strong> by @(Model.VoidedBy ?? Model.CanceledBy ?? "System") on @((Model.VoidedDate ?? Model.CanceledDate)?.ToString("dd MMM yyyy HH:mm") ?? "—")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.CancellationRemarks))
                    {
                        <p class="ui-caption mb-0">@Model.CancellationRemarks</p>
                    }
                </div>
            }
            <section class="ui-panel collection-heading @(Model.IsVoided ? "ui-critical" : Model.ClearedDate.HasValue ? "" : Model.ReturnedDate.HasValue && !Model.DepositDate.HasValue ? "ui-critical" : "ui-attention")" aria-label="Receipt actions">
                <div>
                    <h2 class="ui-section-title">Receipt banking</h2>
                    <p class="ui-caption ui-muted">
                        Banking updates this receipt once for all covered billings.
                        @if (Model.PeriodStatus == MsapPeriodStatus.Adjusted)
                        {
                            <span class="schedule-status-pill ui-status ui-attention" title="Adjusted after period finalization">Adjusted</span>
                        }
                        else if (Model.PeriodStatus == MsapPeriodStatus.Final)
                        {
                            <span class="schedule-status-pill" title="Finalized month-end period">Final</span>
                        }
                    </p>
                </div>
                <div class="collection-actions">
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MsapCollectionId" class="modern-btn-secondary"><span class="material-symbols-outlined" aria-hidden="true">edit</span> Edit receipt</a>
                    }
                    @if (canVoid)
                    {
                        <button type="button" class="modern-btn-error" id="btnVoidCollection"
                            data-action="@Url.Action("Void", "Collection")"
                            data-id="@Model.MsapCollectionId"
                            data-number="@Model.MsapCollectionNumber"
                            data-finalized="@(isFinalOrAdjusted ? "true" : "false")">
                            <span class="material-symbols-outlined" aria-hidden="true">block</span> Void receipt
                        </button>
                    }
                    @if (canBank && !Model.IsVoided && (!Model.IsMonthClosed || isFinalOrAdjusted) && !Model.ClearedDate.HasValue)
                    {
                        @if (!Model.DepositDate.HasValue)
                        {
                            <a asp-action="Banking" asp-route-id="@Model.MsapCollectionId" asp-route-bankingAction="@CollectionBankingAction.Deposit" data-collection-banking="@(Model.ReturnedDate.HasValue ? "Record redeposit" : "Record deposit")" class="modern-btn-primary"><span class="material-symbols-outlined" aria-hidden="true">account_balance</span> @(Model.ReturnedDate.HasValue ? "Record redeposit" : "Record deposit")</a>
                        }
                        else
                        {
                            @if (Model.CheckAmount > 0)
                            {
                                <a asp-action="Banking" asp-route-id="@Model.MsapCollectionId" asp-route-bankingAction="@CollectionBankingAction.ReturnCheck" data-collection-banking="Record returned check" class="modern-btn-warning"><span class="material-symbols-outlined" aria-hidden="true">assignment_return</span> Return check</a>
                            }
                            <a asp-action="Banking" asp-route-id="@Model.MsapCollectionId" asp-route-bankingAction="@CollectionBankingAction.Clear" data-collection-banking="Record clearing" class="modern-btn-complete"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span> Record clearing</a>
                        }
                    }
                </div>
                @if (Model.IsVoided)
                {
                    <p class="ui-caption ui-muted">This receipt has been voided. Any previously linked billings were released back to For Collection.</p>
                }
                else if (Model.IsMonthClosed)
                {
                    <p class="ui-caption ui-muted">This receipt belongs to a closed period. Forward banking in an open month is allowed; reverting, editing, or voiding requires an authorized adjustment reason and memo.</p>
                }
                else if (Model.ClearedDate.HasValue)
                {
                    <p class="ui-caption ui-muted">This receipt has cleared. Other receipts or unpaid bills may still remain on the COS.</p>
                }
            </section>
            <section class="ui-panel ui-stack" aria-labelledby="receiptDetailsHeading">
                <h2 id="receiptDetailsHeading" class="ui-section-title">Receipt details</h2>
                <div class="collection-fields">
                    <div class="ui-field"><span class="ui-caption ui-muted">Service customer</span><p class="ui-body">@Model.Customer?.CustomerName</p></div>
                    <div class="ui-field"><span class="ui-caption ui-muted">TIN</span><p class="ui-body">@(string.IsNullOrWhiteSpace(Model.Customer?.CustomerTin) ? "Not recorded" : Model.Customer!.CustomerTin)</p></div>
                    <div class="ui-field"><span class="ui-caption ui-muted">Reference number</span><p class="ui-body">@(string.IsNullOrWhiteSpace(Model.ReferenceNo) ? "Not recorded" : Model.ReferenceNo)</p></div>
                    <div class="ui-field"><span class="ui-caption ui-muted">Address</span><p class="ui-body">@(string.IsNullOrWhiteSpace(Model.Customer?.CustomerAddress) ? "Not recorded" : Model.Customer!.CustomerAddress)</p></div>
                    <div class="ui-field"><span class="ui-caption ui-muted">Business style</span><p class="ui-body">@(string.IsNullOrWhiteSpace(Model.Customer?.BusinessStyle) ? "Not recorded" : Model.Customer!.BusinessStyle)</p></div>
                </div>
            </section>
            <section class="ui-panel ui-stack" aria-labelledby="coveredBillingsHeading">
                <h2 id="coveredBillingsHeading" class="ui-section-title">Billings covered by this receipt</h2>
                <div class="collection-table-scroll">
                    <table class="modern-table ui-table collection-table">
                        <thead><tr><th>Billing</th><th>Component</th><th>Billing date</th><th>Bill amount</th><th>Gross paid by receipt</th><th>Remaining bill balance</th></tr></thead>
                        <tbody>
                            @if (Model.PaidBills is { Count: > 0 })
                            {
                                @foreach (var billing in Model.PaidBills)
                                {
                                    <tr>
                                        <td><a asp-controller="Billing" asp-action="Review" asp-route-id="@billing.MsapBillingId">@billing.MsapBillingNumber</a></td>
                                        <td>@(billing.BasicBillingId.HasValue ? "BAF" : billing.BafBilling != null ? "Basic" : "Combined")</td>
                                        <td>@billing.Date.ToString(MsapConstants.Date_Format)</td>
                                        <td>@billing.Amount.ToString("N2")</td><td>@billing.AmountPaid.ToString("N2")</td><td>@billing.Balance.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6">No billings are linked to this receipt.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="ui-caption ui-muted">Each billing keeps its own payment allocation and remaining balance. A paid balance does not mean the receipt has cleared.</p>
            </section>
            <div class="collection-settlement-layout">
                <div class="ui-stack">
                    <section class="ui-panel ui-stack" aria-labelledby="checkDetailsHeading">
                        <h2 id="checkDetailsHeading" class="ui-section-title">Check details</h2>
                        @if (Model.CheckAmount > 0)
                        {
                            <div class="collection-fields collection-fields--two">
                                <div class="ui-field"><span class="ui-caption ui-muted">Check number</span><p class="ui-body">@(string.IsNullOrWhiteSpace(Model.CheckNumber) ? "Not recorded" : Model.CheckNumber)</p></div>
                                <div class="ui-field"><span class="ui-caption ui-muted">Check date</span><p class="ui-body">@(Model.CheckDate?.ToString(MsapConstants.Date_Format) ?? "Not recorded")</p></div>
                                @if (!string.IsNullOrWhiteSpace(Model.CheckBank))
                                {
                                    <div class="ui-field"><span class="ui-caption ui-muted">Issuing bank</span><p class="ui-body">@Model.CheckBank</p></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CheckBranch))
                                {
                                    <div class="ui-field"><span class="ui-caption ui-muted">Issuing branch</span><p class="ui-body">@Model.CheckBranch</p></div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="ui-body ui-muted">No check payment recorded.</p>
                        }
                    </section>
                    <section class="ui-panel ui-stack" aria-labelledby="depositDetailsHeading">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h2 id="depositDetailsHeading" class="ui-section-title mb-0">Deposit and clearing</h2>
                            @if (canRevertBanking)
                            {
                                <button type="button" class="modern-btn-error" id="btnRevertBanking"
                                    data-action="@Url.Action("RevertBankingStep", "Collection")"
                                    data-id="@Model.MsapCollectionId"
                                    data-step="@(Model.ClearedDate.HasValue ? "Cleared" : "Deposited")"
                                    data-cleared="@(Model.ClearedDate.HasValue ? "true" : "false")"
                                    data-finalized="@(isFinalOrAdjusted ? "true" : "false")">
                                    <span class="material-symbols-outlined" aria-hidden="true">undo</span> Revert banking step
                                </button>
                            }
                        </div>
                        @{
                            var accountNo = Model.BankAccountNumber ?? Model.BankAccount?.AccountNo;
                            var accountName = Model.BankAccountName ?? Model.BankAccount?.AccountName;
                            var hasBankAccount = !string.IsNullOrWhiteSpace(Model.BankAccount?.Bank) || !string.IsNullOrWhiteSpace(accountNo) || !string.IsNullOrWhiteSpace(accountName);
                        }
                        <div class="ui-field">
                            <span class="ui-caption ui-muted">MMSI receiving bank account</span>
                            @if (hasBankAccount)
                            {
                                <p class="ui-body">@(Model.BankAccount?.Bank ?? accountName)</p>
                                @if (!string.IsNullOrWhiteSpace(accountNo) || !string.IsNullOrWhiteSpace(accountName))
                                {
                                    <p class="ui-caption ui-muted">@string.Join(" · ", new[] { accountNo, accountName }.Where(s => !string.IsNullOrWhiteSpace(s)))</p>
                                }
                            }
                            else
                            {
                                <p class="ui-body">Not recorded</p>
                            }
                        </div>
                        <div class="collection-fields">
                            <div class="ui-field"><span class="ui-caption ui-muted">@(Model.ReturnedDate.HasValue ? "Latest deposit" : "Deposit date")</span><p class="ui-body">@(Model.DepositDate?.ToString(MsapConstants.Date_Format) ?? "Not recorded")</p></div>
                            <div class="ui-field"><span class="ui-caption ui-muted">Last check return</span><p class="ui-body">@(Model.ReturnedDate?.ToString(MsapConstants.Date_Format) ?? "Not recorded")</p></div>
                            <div class="ui-field"><span class="ui-caption ui-muted">Clearing date</span><p class="ui-body">@(Model.ClearedDate?.ToString(MsapConstants.Date_Format) ?? "Not recorded")</p></div>
                        </div>
                    </section>
                </div>
                <section class="ui-panel ui-stack collection-summary" aria-labelledby="receiptTotalsHeading">
                    <h2 id="receiptTotalsHeading" class="ui-section-title">Receipt totals</h2>
                    <dl>
                        <div><dt>Cash received</dt><dd>@Model.CashAmount.ToString("N2")</dd></div>
                        <div><dt>Check received</dt><dd>@Model.CheckAmount.ToString("N2")</dd></div>
                        <div><dt>Net received</dt><dd>@Model.Amount.ToString("N2")</dd></div>
                        <div><dt>EWT withheld</dt><dd>@Model.EWT.ToString("N2")</dd></div>
                        <div><dt>WVAT withheld</dt><dd>@Model.WVAT.ToString("N2")</dd></div>
                        <div class="collection-summary-total"><dt>Gross amount settled</dt><dd>@Model.Total.ToString("N2")</dd></div>
                    </dl>
                </section>
            </div>
            <section class="ui-panel ui-field"><h2 class="ui-section-title">Remarks</h2><p class="ui-body collection-remarks">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks." : Model.Remarks)</p></section>
        </div>
    </main>
</div>

<form id="collectionTokenForm" hidden>@Html.AntiForgeryToken()</form>

@section Scripts
{
    <script>
        $('#btnRevertBanking').on('click', async function () {
            const btn = this;
            const isFinal = btn.dataset.finalized === 'true';
            const isCleared = btn.dataset.cleared === 'true';
            const stepText = isCleared
                ? 'This receipt has already cleared. Reverting moves Cleared status back to Deposited so clearing date or details can be corrected. This reversal is logged in the audit trail.'
                : 'This reverts Deposited status back to Undeposited so deposit date, bank account, or collection details can be corrected. This reversal is logged in the audit trail.';
            const text = isFinal
                ? `${stepText} Because this receipt belongs to a finalized period, reverting tags it as Adjusted in the audit history.`
                : stepText;
            const confirmResult = await ModernAlert.promptAdjustment({
                title: 'Revert banking step?',
                text,
                placeholder: 'Reason for reverting',
                confirmText: 'Revert step',
                cancelText: 'Keep current',
                requireAttachment: isFinal
            });

            if (!confirmResult.isConfirmed) return;

            ModernAlert.showLoading('Reverting banking step...');
            const token = document.querySelector('#collectionTokenForm input[name="__RequestVerificationToken"]')?.value || '';
            const form = document.createElement('form');
            form.method = 'POST';
            form.enctype = 'multipart/form-data';
            form.action = btn.dataset.action;
            const addField = (name, value) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                form.appendChild(input);
            };
            addField('__RequestVerificationToken', token);
            addField('id', btn.dataset.id);
            addField('reason', confirmResult.value.reason || '');
            if (confirmResult.value.file) {
                const fileInput = document.createElement('input');
                fileInput.type = 'file';
                fileInput.name = 'authorizationFile';
                const dt = new DataTransfer();
                dt.items.add(confirmResult.value.file);
                fileInput.files = dt.files;
                form.appendChild(fileInput);
            }
            document.body.appendChild(form);
            form.submit();
        });
        $('#btnVoidCollection').on('click', async function () {
            const btn = this;
            const isFinal = btn.dataset.finalized === 'true';
            const receiptNo = btn.dataset.number || '';
            const baseText = `Voiding receipt #${receiptNo} releases all linked billings back to For Collection so they can be re-collected or reopened for revision. This action cannot be undone.`;
            const text = isFinal
                ? `${baseText} Because this receipt belongs to a finalized period, an approved authorization document is required and the reversal will appear in Posted Month Adjustments.`
                : baseText;
            const confirmResult = await ModernAlert.promptAdjustment({
                title: 'Void collection receipt?',
                text,
                placeholder: 'Reason for voiding this collection receipt',
                confirmText: 'Void receipt',
                cancelText: 'Keep receipt',
                requireAttachment: isFinal
            });

            if (!confirmResult.isConfirmed) return;

            ModernAlert.showLoading('Voiding collection receipt...');
            const token = document.querySelector('#collectionTokenForm input[name="__RequestVerificationToken"]')?.value || '';
            const form = document.createElement('form');
            form.method = 'POST';
            form.enctype = 'multipart/form-data';
            form.action = btn.dataset.action;
            const addField = (name, value) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                form.appendChild(input);
            };
            addField('__RequestVerificationToken', token);
            addField('id', btn.dataset.id);
            addField('reason', confirmResult.value.reason || '');
            if (confirmResult.value.file) {
                const fileInput = document.createElement('input');
                fileInput.type = 'file';
                fileInput.name = 'authorizationFile';
                const dt = new DataTransfer();
                dt.items.add(confirmResult.value.file);
                fileInput.files = dt.files;
                form.appendChild(fileInput);
            }
            document.body.appendChild(form);
            form.submit();
        });
    </script>
}
