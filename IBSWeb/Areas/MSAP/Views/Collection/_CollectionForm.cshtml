@model CreateCollectionViewModel
@{
    bool editing = Model.MsapCollectionId.HasValue;
    string title = editing ? "Edit collection" : "Record collection";
}
<div class="modern-layout msap-workflow collection-form collection-entry">
    <form id="collectionForm" method="post" asp-action="@(editing ? "Edit" : "Create")"
          data-billings-url="@Url.Action("GetUncollectedBillingsForTable")"
          data-initial-cos="@Model.CustomerOrderSlipId">
        @Html.AntiForgeryToken()
        <input asp-for="MsapCollectionId" type="hidden" />
        <input asp-for="Amount" type="hidden" />
        <script type="application/json" id="collectionPayments">@Html.Raw(Json.Serialize(Model.BillingPayments))</script>
        <main class="collection-workspace">
            <aside class="wf-panel schedule-details-progress" aria-label="Job Progress">
                <h2 class="wf-section-title" id="collectionProgressHeading">Job Progress</h2>
                <div class="wf-field collection-progress-picker">
                    <label for="progressCos" class="wf-caption wf-muted">Viewing COS</label>
                    <select id="progressCos" class="js-modern-select" data-placeholder="Select billings to view progress" disabled><option value="">Select billings to view progress</option></select>
                </div>
                <div id="financialJobProgress" data-progress-url="@Url.Action("Progress", "CustomerOrderSlip")" data-action-stage="7"></div>
            </aside>
            <div class="wf-stack collection-content">
                <header class="wf-page-header">
                    <nav aria-label="Breadcrumb"><ol class="wf-breadcrumb"><li><a asp-action="Index">Collections</a></li><li aria-current="page">@title</li></ol></nav>
                    <h1 class="wf-page-title" data-page-header>@title</h1>
                    <a asp-action="Index" class="modern-btn-secondary wf-page-action">Collections</a>
                    <p class="wf-page-description wf-caption wf-muted">One receipt / check / Separate allocation and balance for each bill</p>
                </header>
                <div asp-validation-summary="All" class="text-error" role="alert"></div>
                <p id="collectionError" class="text-error" role="alert" hidden></p>
                <section class="wf-panel collection-fields" aria-label="Billing filters">
                    <div class="wf-field">
                        <label asp-for="CustomerId" class="wf-label">Service customer *</label>
                        @if (editing)
                        {
                            <input asp-for="CustomerId" type="hidden" />
                            <input class="modern-input" value="@(Model.Customers?.FirstOrDefault(c => c.Value == Model.CustomerId.ToString())?.Text)" readonly aria-label="Service customer" />
                        }
                        else
                        {
                            <select asp-for="CustomerId" asp-items="Model.Customers" class="js-modern-select" required><option value="">Select customer</option></select>
                        }
                    </div>
                    <div class="wf-field"><label for="billedParty" class="wf-label">Billed party / Filter</label><select id="billedParty" class="js-modern-select" data-placeholder="All billed parties"><option value="">All billed parties</option></select></div>
                    <div class="wf-field"><span class="wf-caption wf-muted">Selected billings</span><strong id="selectedCount">0 bills / 0 COS</strong></div>
                </section>
                <section class="wf-panel wf-stack" aria-labelledby="allocationHeading">
                    <div class="collection-heading"><h2 id="allocationHeading" class="wf-section-title">Billing allocation</h2><input id="billingSearch" class="modern-input" type="search" placeholder="Search billing number or COS..." aria-label="Search billing number or COS" /></div>
                    <div class="collection-table-scroll">
                        <table class="collection-table">
                            <thead><tr><th><input id="selectAllBillings" type="checkbox" aria-label="Select all visible eligible bills" /></th><th>Billing / COS</th><th>Gross balance</th><th>Withholding</th><th>Net available</th><th>Payment allocation</th><th>Balance after allocation</th></tr></thead>
                            <tbody id="collectionBillings"><tr><td colspan="7">Select a customer to load billings.</td></tr></tbody>
                        </table>
                    </div>
                    <p class="wf-caption wf-muted">Select approved bills and enter the net payment for each. Unapproved bills cannot be selected. Bills on another receipt must be reviewed on that receipt.</p>
                </section>
                <section class="wf-panel wf-stack" aria-labelledby="collectionDetailsHeading">
                    <div class="collection-heading"><h2 id="collectionDetailsHeading" class="wf-section-title">Collection details</h2><label class="collection-check"><input asp-for="IsUndocumented" /> Undocumented</label></div>
                    <div class="collection-fields">
                        <div class="wf-field"><label asp-for="MsapCollectionNumber" class="wf-label">Collection / receipt number *</label><input asp-for="MsapCollectionNumber" class="modern-input" maxlength="10" required /><span asp-validation-for="MsapCollectionNumber" class="text-error"></span></div>
                        <div class="wf-field"><label asp-for="Date" class="wf-label">Collection date *</label><input asp-for="Date" type="date" class="modern-input" required value="@(Model.Date != default ? Model.Date.ToString("yyyy-MM-dd") : DateTimeHelper.GetCurrentPhilippineTime().ToString("yyyy-MM-dd"))" /></div>
                        <div class="wf-field"><label asp-for="ReferenceNo" class="wf-label">Reference number</label><input asp-for="ReferenceNo" class="modern-input" /></div>
                    </div>
                </section>
                <div class="collection-settlement-layout">
                    <div class="wf-stack">
                        <section class="wf-panel wf-stack" aria-labelledby="paymentHeading">
                            <h2 id="paymentHeading" class="wf-section-title">Payment and withholding</h2>
                            <div class="collection-fields collection-fields--two">
                                <div class="wf-field"><label asp-for="CashAmount" class="wf-label">Cash payment</label><input asp-for="CashAmount" type="number" min="0" step="0.01" class="modern-input" required /></div>
                                <div class="wf-field"><label asp-for="CheckAmount" class="wf-label">Check payment</label><input asp-for="CheckAmount" type="number" min="0" step="0.01" class="modern-input" required /></div>
                                <div class="wf-field"><label asp-for="EWT" class="wf-label">Total EWT / From selected allocations</label><input asp-for="EWT" type="number" min="0" step="0.01" class="modern-input" readonly /></div>
                                <div class="wf-field"><label asp-for="WVAT" class="wf-label">Total WVAT / From selected allocations</label><input asp-for="WVAT" type="number" min="0" step="0.01" class="modern-input" readonly /></div>
                            </div>
                        </section>
                        <section class="wf-panel wf-stack" aria-labelledby="checkHeading">
                            <h2 id="checkHeading" class="wf-section-title">Check details</h2>
                            <p class="wf-caption wf-muted">Date, number and issuing bank are required when receiving a check.</p>
                            <div class="collection-fields collection-fields--two">
                                <div class="wf-field"><label asp-for="CheckDate" class="wf-label">Check date</label><input asp-for="CheckDate" type="date" class="modern-input" /></div>
                                <div class="wf-field"><label asp-for="CheckNumber" class="wf-label">Check number</label><input asp-for="CheckNumber" type="text" class="modern-input" /></div>
                                <div class="wf-field"><label asp-for="CheckBank" class="wf-label">Issuing bank</label><input asp-for="CheckBank" type="text" class="modern-input" /></div>
                                <div class="wf-field"><label asp-for="CheckBranch" class="wf-label">Bank branch</label><input asp-for="CheckBranch" type="text" class="modern-input" /></div>
                            </div>
                        </section>
                    </div>
                    <section class="wf-panel wf-stack collection-summary" aria-labelledby="settlementHeading">
                        <h2 id="settlementHeading" class="wf-section-title">Receipt settlement</h2>
                        <dl>
                            <div><dt>Selected billings</dt><dd id="summaryCount">0</dd></div>
                            <div><dt>Selected gross balance</dt><dd id="summaryGross">0.00</dd></div>
                            <div><dt>Cash + check received</dt><dd id="summaryReceived">0.00</dd></div>
                            <div><dt>Allocated EWT</dt><dd id="summaryEwt">0.00</dd></div>
                            <div><dt>Allocated WVAT</dt><dd id="summaryWvat">0.00</dd></div>
                            <div class="collection-summary-total"><dt>Gross amount allocated</dt><dd id="summaryAllocated">0.00</dd></div>
                            <div><dt>Remaining selected balance</dt><dd id="summaryRemaining">0.00</dd></div>
                        </dl>
                        <p id="settlementStatus" class="wf-caption" role="status">Cash plus check must match the allocated net payments.</p>
                        <p class="wf-caption wf-muted">Zero balance does not mean cleared. Deposit and clearing follow receipt entry.</p>
                    </section>
                </div>
                <section class="wf-panel wf-field"><label asp-for="Remarks" class="wf-label">Remarks</label><textarea asp-for="Remarks" class="modern-input" rows="2" placeholder="Add payment reference notes..."></textarea></section>
                <footer class="collection-heading"><p class="wf-caption wf-muted">One receipt covers the selected bills. Each billing keeps its own allocation and balance.</p><div class="collection-actions"><a class="modern-btn-secondary" asp-action="Index">Cancel</a><button type="submit" class="modern-btn-primary" id="saveCollection">@(editing ? "Save changes" : "Save collection")</button></div></footer>
            </div>
        </main>
    </form>
</div>
