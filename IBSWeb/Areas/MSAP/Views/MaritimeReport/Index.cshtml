@using IBS.Utility.MSAP.Helpers
@{
    ViewData["Title"] = "Reports";
    ViewData["IsFullWidth"] = true;
    var philippineToday = DateTimeHelper.GetCurrentPhilippineTime();
    var monthStart = new DateOnly(philippineToday.Year, philippineToday.Month, 1);
}

<div class="modern-layout">
    <main class="modern-container">
        <div class="flex items-center gap-2 mb-1">
            <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
            <span class="material-symbols-outlined text-xs">chevron_right</span>
            <span class="modern-label" style="color: var(--on-surface)">Reports</span>
        </div>
        <h1 class="modern-headline-lg">MMSI Reports</h1>

        <div class="modern-grid" style="margin-top: 1.5rem;">
            <div class="modern-col-12">
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1.5rem;">
                    <div class="modern-card">
                        <div class="modern-card-header-info"><span class="material-symbols-outlined">menu_book</span><h2 class="modern-headline-md">Sales Book</h2></div>
                        <div class="modern-card-body">
                            <p class="text-sm">Approved numbered bills by final approval date. Reversed entries are excluded; billing dates are retained separately.</p>
                            <form asp-action="SalesBook" method="post" data-download>
                                <div class="modern-grid-compact">
                                    <div><label for="bookFrom" class="modern-label">Approval from</label><input id="bookFrom" name="dateFrom" type="date" value="@monthStart.ToString("yyyy-MM-dd")" class="modern-input" required /></div>
                                    <div><label for="bookTo" class="modern-label">Approval to</label><input id="bookTo" name="dateTo" type="date" value="@philippineToday.ToString("yyyy-MM-dd")" class="modern-input" required /></div>
                                </div>
                                <button type="submit" class="modern-btn-primary w-100">Download Sales Book</button>
                            </form>
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">receipt_long</span>
                            <h2 class="modern-headline-md">Dispatch for Billing</h2>
                        </div>
                        <div class="modern-card-body" style="gap: 1rem;">
                            <p class="text-sm" style="color: var(--on-surface-variant);">Dispatch tickets ready for billing with tariff and BAF amounts.</p>
                            <form method="post" data-download action="@Url.Action("DispatchForBilling", "MaritimeReport", new { area = "MSAP" })">
                                @Html.AntiForgeryToken()
                                <div class="modern-grid-compact" style="margin-bottom: 0.75rem;">
                                    <div>
                                        <label class="modern-label">From</label>
                                        <input type="date" name="dateFrom" value="@monthStart.ToString("yyyy-MM-dd")" class="modern-input w-100" required>
                                    </div>
                                    <div>
                                        <label class="modern-label">To</label>
                                        <input type="date" name="dateTo" value="@philippineToday.ToString("yyyy-MM-dd")" class="modern-input w-100" required>
                                    </div>
                                </div>
                                <button type="submit" class="modern-btn-primary w-100">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">download</span> Download Excel
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">summarize</span>
                            <h2 class="modern-headline-md">Dispatch Ticket Summary</h2>
                        </div>
                        <div class="modern-card-body" style="gap: 1rem;">
                            <p class="text-sm" style="color: var(--on-surface-variant);">Detailed dispatch summary with billing and collection info.</p>
                            <form method="post" data-download action="@Url.Action("DispatchTicketSummary", "MaritimeReport", new { area = "MSAP" })">
                                @Html.AntiForgeryToken()
                                <div class="modern-grid-compact" style="margin-bottom: 0.75rem;">
                                    <div>
                                        <label class="modern-label">From</label>
                                        <input type="date" name="dateFrom" value="@monthStart.ToString("yyyy-MM-dd")" class="modern-input w-100" required>
                                    </div>
                                    <div>
                                        <label class="modern-label">To</label>
                                        <input type="date" name="dateTo" value="@philippineToday.ToString("yyyy-MM-dd")" class="modern-input w-100" required>
                                    </div>
                                </div>
                                <button type="submit" class="modern-btn-primary w-100">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">download</span> Download Excel
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">monitoring</span>
                            <h2 class="modern-headline-md">Sales Summary (AR Monitoring)</h2>
                        </div>
                        <div class="modern-card-body" style="gap: 1rem;">
                            <p class="text-sm" style="color: var(--on-surface-variant);">AR monitoring report with trip details for the selected date range.</p>
                            <form method="post" data-download action="@Url.Action("SalesSummary", "MaritimeReport", new { area = "MSAP" })">
                                @Html.AntiForgeryToken()
                                <div class="modern-grid-compact" style="margin-bottom: 0.75rem;">
                                    <div>
                                        <label for="salesDateFrom" class="modern-label">From</label>
                                        <input id="salesDateFrom" type="date" name="dateFrom" value="@monthStart.ToString("yyyy-MM-dd")" class="modern-input w-100" required>
                                    </div>
                                    <div>
                                        <label for="salesDateTo" class="modern-label">To</label>
                                        <input id="salesDateTo" type="date" name="dateTo" value="@philippineToday.ToString("yyyy-MM-dd")" class="modern-input w-100" required>
                                    </div>
                                </div>
                                <button type="submit" class="modern-btn-primary w-100">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">download</span> Download Excel
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
