@model CustomerOrderSlip
@inject IRoleService MsapRoleService
@{
    ViewData["Title"] = $"COS {Model.CustomerOrderSlipNumber}";
    ViewData["IsFullWidth"] = true;
    ViewData["Cos"] = Model;
    var booking = ViewBag.VesselSchedule as VesselSchedule;
    var progress = (JobProgressViewModel)ViewBag.JobProgress;
    var entries = booking?.ServiceEntries ?? new List<VesselScheduleServiceEntry>();
    var activeEntries = entries.Where(entry => !entry.CancelledAt.HasValue && !(Model.DispatchTickets.Any(t => t.VesselScheduleServiceEntryId == entry.VesselScheduleServiceEntryId && t.Status == MsapConstants.DispatchTicketStatus.Deleted) && !Model.DispatchTickets.Any(t => t.VesselScheduleServiceEntryId == entry.VesselScheduleServiceEntryId && t.Status != MsapConstants.DispatchTicketStatus.Deleted))).ToList();
    var pendingServices = activeEntries.Where(entry => !Model.DispatchTickets.Any(ticket => ticket.VesselScheduleServiceEntryId == entry.VesselScheduleServiceEntryId && ticket.Status != MsapConstants.DispatchTicketStatus.Deleted)).ToList();
    var approvalPending = booking != null && (booking.ApprovedRevision != booking.Revision || booking.Status == MsapConstants.VesselScheduleStatus.Tentative);
    var isReapproval = booking != null && booking.ApprovedRevision.HasValue && (booking.ApprovedRevision != booking.Revision || booking.Status == MsapConstants.VesselScheduleStatus.Tentative);
    var bookingClosed = booking?.Status is MsapConstants.VesselScheduleStatus.Completed or MsapConstants.VesselScheduleStatus.Cancelled;
    var canRecord = ViewBag.CanCreateDispatchTicket == true && Model.Status == MsapConstants.CustomerOrderSlipStatus.Open
        && !bookingClosed && ViewBag.HasBilling != true && !isReapproval;
    ViewData["CanRecordExpectedService"] = canRecord;
    ViewData["CanCancelExpectedService"] = ViewBag.CanEditCustomerOrderSlip == true && !bookingClosed
        && Model.Status == MsapConstants.CustomerOrderSlipStatus.Open && ViewBag.HasBilling != true;
    var canVoidTicketRow = ViewBag.CanEditTicket == true && ViewBag.HasBilling != true
        && Model.Status == MsapConstants.CustomerOrderSlipStatus.Open && booking?.Status != MsapConstants.VesselScheduleStatus.Cancelled;
    var tugIds = entries.Select(entry => entry.TugboatId).Concat(Model.DispatchTickets.Select(ticket => ticket.TugBoatId)).Distinct().ToList();
    var statusLabel = bookingClosed && booking != null ? MsapConstants.VesselScheduleStatus.GetDisplayName(booking.Status)
        : approvalPending ? booking!.ApprovedRevision.HasValue ? "Pending reapproval" : "Approval pending"
        : booking != null && Model.Status == MsapConstants.CustomerOrderSlipStatus.Open ? "COS approved"
        : MsapConstants.CustomerOrderSlipStatus.GetDisplayName(Model.Status);
    var ticketEntry = ViewBag.ActualTicketEntry as DispatchTicketViewModel;
    var viewedTicket = ViewData["ViewedTicket"] as DispatchTicket;
    var selectedEntry = entries.FirstOrDefault(entry => entry.VesselScheduleServiceEntryId == ticketEntry?.VesselScheduleServiceEntryId);
    var canViewRates = ViewData["CanViewRates"] is true;
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var msapRole = userId is not null ? await MsapRoleService.GetUserRoleAsync(userId) : null;
    var canViewAuditHistory = msapRole == MsapRoles.Admin;
}
<link rel="stylesheet" href="~/msap/css/vessel-schedule.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/cos-details.css" asp-append-version="true" />
<div class="schedule-screen-layout app-ui">
    <partial name="_WorkflowProgress" model="progress" />
    <main class="cos-details-workspace ui-stack">
        @Html.AntiForgeryToken()
        <header class="ui-page-header">
            <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li><a asp-action="Index">COS records</a></li><li aria-current="page">@Model.CustomerOrderSlipNumber</li></ol></nav>
            <h1 class="ui-page-title" data-page-header>@(approvalPending ? "Urgent service entry" : "COS details & tickets")</h1>
            <a asp-action="Index" class="modern-btn-secondary ui-page-action" data-ui-back>Back</a>
            <div class="ui-page-description cos-details-status">
                <span class="schedule-status-pill">@statusLabel</span>
                <span class="ui-body ui-muted">@Model.CustomerOrderSlipNumber</span>
                @if (entries.Count > 0)
                {
                    <span class="ui-body ui-muted">@(activeEntries.Count - pendingServices.Count) of @activeEntries.Count tickets entered · @pendingServices.Count pending</span>
                }
            </div>
        </header>
        @if (approvalPending)
        {
            if (isReapproval)
            {
                <p class="ui-panel ui-body ui-attention">Schedule revision pending commercial reapproval · Ticket recording and charge calculations are blocked until reapproved.</p>
            }
            else
            {
                <p class="ui-panel ui-body ui-attention">Approval pending · Actual ticket entry is allowed. Charges and billing remain pending until schedule approval.</p>
            }
        }
        <section class="ui-panel ui-panel--compact ui-stack" id="cosBookingDetails" aria-label="COS booking details">
            <dl class="schedule-review-fields cos-details-fields">
                <div><dt class="ui-caption ui-muted">Customer</dt><dd class="ui-value">@Model.Customer.CustomerName</dd></div>
                <div><dt class="ui-caption ui-muted">Vessel</dt><dd class="ui-value">@Model.Vessel.VesselName</dd></div>
                <div><dt class="ui-caption ui-muted">Port / terminal</dt><dd class="ui-value">@Model.Port.PortName / @Model.Terminal.TerminalName</dd></div>
                <div><dt class="ui-caption ui-muted">Voyage</dt><dd class="ui-value">@(Model.VoyageNumber ?? "—")</dd></div>
                <div class="cos-planned-window"><dt class="ui-caption ui-muted">Planned window · Philippine time</dt><dd class="ui-value">@(Model.PlannedStartTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not scheduled") @(Model.PlannedEndTime.HasValue ? $"– {Model.PlannedEndTime:dd MMM yyyy, HH:mm}" : "")</dd></div>
                @if (booking != null)
                {
                    @if (canViewRates)
                    {
                        <div><dt class="ui-caption ui-muted">COS discount</dt><dd class="ui-value">@(booking.SkipCosDiscount ? "0% · Skipped" : $"{booking.CosDiscountPercent.GetValueOrDefault():0.##}% · Applied")</dd></div>
                    }
                    <div><dt class="ui-caption ui-muted">SBMA share</dt><dd class="ui-value">@(booking.SbmaEnabled ? "Enabled · Actual time" : "Disabled")</dd></div>
                }
            </dl>
            <div class="cos-details-links">
                @if (booking != null)
                {
                    <a asp-controller="VesselSchedule" asp-action="Details" asp-route-id="@booking.VesselScheduleId">View vessel schedule</a>
                }
                @if (ViewBag.CanEditCustomerOrderSlip == true && booking == null && Model.Status == MsapConstants.CustomerOrderSlipStatus.Open && ViewBag.HasDispatchTickets != true && ViewBag.HasBilling != true)
                {
                    <a asp-action="Edit" asp-route-id="@Model.CustomerOrderSlipId">Edit COS</a>
                }
            </div>
        </section>
        <section class="ui-panel ui-stack" id="cosServices" aria-labelledby="cosServicesTitle">
            <div class="cos-section-heading">
                <h2 class="ui-section-title" id="cosServicesTitle">Services &amp; tickets</h2>
                @if (pendingServices.Count > 0)
                {
                    <span class="schedule-status-pill ui-status ui-attention">@pendingServices.Count ticket(s) missing</span>
                }
                @if (entries.Count == 0 && canRecord)
                {
                    <a asp-controller="DispatchTicket" asp-action="Create" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="modern-btn-secondary">Add ticket</a>
                }
            </div>
            @if (ViewBag.HasBilling == true)
            {
                <p class="ui-body ui-muted">Billing #@ViewBag.BillingNumber is linked to this COS. Ticket modifications are restricted.</p>
            }
            <div class="schedule-services-table" role="region" aria-label="Services and tickets by tugboat" tabindex="0">
                <table class="schedule-review-table cos-services-table">
                    <thead><tr>
                        <th>Service</th>
                        <th>Ticket number</th>
                        <th>Actual hours</th><th>Billable hours</th><th>Service status</th><th>Action</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var tugId in tugIds)
                        {
                            var tugEntries = entries.Where(entry => entry.TugboatId == tugId).ToList();
                            var tugTickets = Model.DispatchTickets.Where(ticket => ticket.TugBoatId == tugId).ToList();
                            var tug = tugEntries.FirstOrDefault()?.Tugboat ?? tugTickets.First().Tugboat;
                            <tr class="cos-tug-group"><th colspan="6">@tug.TugboatName <span class="ui-caption ui-muted">@(tug.IsCompanyOwned ? "Company-owned" : "Subcontractor")</span></th></tr>
                            @foreach (var entry in tugEntries)
                            {
                                var ticket = tugTickets.OrderBy(item => item.Status == MsapConstants.DispatchTicketStatus.Deleted ? 1 : 0).FirstOrDefault(item => item.VesselScheduleServiceEntryId == entry.VesselScheduleServiceEntryId);
                                var calculationBlocker = ticket == null ? null : progress.CalculationBlockers.GetValueOrDefault(ticket.DispatchTicketId);
                                var isSelected = ticketEntry != null && (ticket != null ? ticketEntry.DispatchTicketId == ticket.DispatchTicketId : ticketEntry.VesselScheduleServiceEntryId == entry.VesselScheduleServiceEntryId);
                                var rowState = isSelected ? "ui-active" : calculationBlocker != null || ticket?.Status == MsapConstants.DispatchTicketStatus.CalculationPending ? "ui-critical" : entry.CancelledAt.HasValue != true && (ticket == null || approvalPending) ? "ui-attention" : "";
                                <tr class="@rowState">
                                    <td>@entry.Service.ServiceName</td>
                                    @if (entry.CancelledAt.HasValue)
                                    {
                                        <td colspan="4"><span class="schedule-status-pill">Service cancelled</span><small class="ui-caption ui-muted">@entry.CancellationReason · @entry.CancelledAt.Value.ToString("dd MMM yyyy, HH:mm")</small></td><td>—</td>
                                    }
                                    else if (ticket == null)
                                    {
                                        <td>Not entered</td><td>Pending</td><td>Pending</td><td><span class="ui-status ui-attention">Awaiting ticket</span></td>
                                        <td>
                                            <div class="cos-service-actions">
                                                @if (ViewData["CanRecordExpectedService"] is true)
                                                {
                                                    @if (ticketEntry?.VesselScheduleServiceEntryId == entry.VesselScheduleServiceEntryId)
                                                    {
                                                        <span class="ui-status ui-active" aria-current="true">Entering ticket</span>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId"
                                                           asp-route-expectedServiceEntryId="@entry.VesselScheduleServiceEntryId" asp-fragment="actualTicketEntry" class="cos-ticket-link cos-ticket-primary">
                                                            <span class="material-symbols-outlined" style="font-size: 15px;">add</span> Record ticket
                                                        </a>
                                                    }
                                                }
                                                @if (ViewData["CanCancelExpectedService"] is true)
                                                {
                                                    <button type="button" class="cos-cancel-subtext" data-cancel-service="@entry.VesselScheduleServiceEntryId" data-cos-id="@Model.CustomerOrderSlipId" data-url="@Url.Action("CancelService", "CustomerOrderSlip")">Cancel service</button>
                                                }
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            @if (ViewData["CanViewActualTicket"] is true)
                                            {
                                                <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" asp-route-dispatchTicketId="@ticket.DispatchTicketId" asp-fragment="actualTicketEntry" class="font-bold text-primary" style="text-decoration:none;">@ticket.DispatchNumber</a>
                                            }
                                            else
                                            {
                                                @ticket.DispatchNumber
                                            }
                                            @if (ticket.DateLeft.HasValue && ticket.TimeLeft.HasValue && ticket.DateArrived.HasValue && ticket.TimeArrived.HasValue)
                                            {
                                                <small class="ui-caption ui-muted">@ticket.DateLeft.Value.ToString("dd MMM") @ticket.TimeLeft.Value.ToString("HH:mm") – @ticket.DateArrived.Value.ToString("dd MMM") @ticket.TimeArrived.Value.ToString("HH:mm")</small>
                                            }
                                        </td>
                                        <td>@(ticket.RawDurationHours?.ToString("0.00") ?? "—")</td>
                                        <td>@ticket.TotalHours.ToString("0.00")</td>
                                        <td>
                                            @if (ticket.Status == MsapConstants.DispatchTicketStatus.Deleted)
                                            {
                                                <span class="schedule-status-pill ui-status ui-critical">Voided</span>
                                            }
                                            else
                                            {
                                                <span class="schedule-status-pill ui-status @(approvalPending ? "ui-attention" : calculationBlocker != null || ticket.Status == MsapConstants.DispatchTicketStatus.CalculationPending ? "ui-critical" : "ui-complete")">@(approvalPending ? "Awaiting approval" : calculationBlocker != null || ticket.Status == MsapConstants.DispatchTicketStatus.CalculationPending ? "Calculation pending" : "Recorded")</span>
                                            }
                                            @if (ticket.PeriodStatus == MsapPeriodStatus.Adjusted)
                                            {
                                                <span class="schedule-status-pill ui-status ui-attention" title="Adjusted after period finalization">Adjusted</span>
                                            }
                                            else if (ticket.PeriodStatus == MsapPeriodStatus.Final)
                                            {
                                                <span class="schedule-status-pill" title="Finalized month-end period">Final</span>
                                            }
                                            @if (calculationBlocker != null)
                                            {
                                                <small class="cos-ticket-blocker ui-caption ui-muted">@calculationBlocker</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="cos-service-actions">
                                                @if (ViewData["CanViewActualTicket"] is true)
                                                {
                                                    <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" asp-route-dispatchTicketId="@ticket.DispatchTicketId" asp-fragment="actualTicketEntry" class="cos-ticket-link">
                                                        <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span> View ticket
                                                    </a>
                                                }
                                                @if (canVoidTicketRow && ticket.Status != MsapConstants.DispatchTicketStatus.Billed && ticket.Status != MsapConstants.DispatchTicketStatus.Deleted)
                                                {
                                                    <button type="button" class="cos-cancel-subtext" data-void-ticket="@ticket.DispatchTicketId" data-cos-id="@Model.CustomerOrderSlipId" data-dispatch-number="@ticket.DispatchNumber" data-finalized="@(ticket.PeriodStatus == MsapPeriodStatus.Final ? "true" : "false")" data-url="@Url.Action("VoidTicket", "DispatchTicket")">Void ticket</button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                            @foreach (var ticket in tugTickets.Where(item => !tugEntries.Any(entry => entry.VesselScheduleServiceEntryId == item.VesselScheduleServiceEntryId)))
                            {
                                var calculationBlocker = progress.CalculationBlockers.GetValueOrDefault(ticket.DispatchTicketId);
                                var isSelected = ticketEntry != null && ticketEntry.DispatchTicketId == ticket.DispatchTicketId;
                                var rowState = isSelected ? "ui-active" : calculationBlocker != null || ticket.Status == MsapConstants.DispatchTicketStatus.CalculationPending ? "ui-critical" : approvalPending ? "ui-attention" : "";
                                <tr class="@rowState">
                                    <td>@ticket.Service.ServiceName</td>
                                    <td>
                                        @if (ViewData["CanViewActualTicket"] is true)
                                        {
                                            <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" asp-route-dispatchTicketId="@ticket.DispatchTicketId" asp-fragment="actualTicketEntry" class="font-bold text-primary" style="text-decoration:none;">@ticket.DispatchNumber</a>
                                        }
                                        else
                                        {
                                            @ticket.DispatchNumber
                                        }
                                        @if (ticket.DateLeft.HasValue && ticket.TimeLeft.HasValue && ticket.DateArrived.HasValue && ticket.TimeArrived.HasValue)
                                        {
                                            <small class="ui-caption ui-muted">@ticket.DateLeft.Value.ToString("dd MMM") @ticket.TimeLeft.Value.ToString("HH:mm") – @ticket.DateArrived.Value.ToString("dd MMM") @ticket.TimeArrived.Value.ToString("HH:mm")</small>
                                        }
                                    </td>
                                    <td>@(ticket.RawDurationHours?.ToString("0.00") ?? "—")</td>
                                    <td>@ticket.TotalHours.ToString("0.00")</td>
                                    <td>
                                        @if (ticket.Status == MsapConstants.DispatchTicketStatus.Deleted)
                                        {
                                            <span class="schedule-status-pill ui-status ui-critical">Voided</span>
                                        }
                                        else
                                        {
                                            <span class="schedule-status-pill ui-status @(approvalPending ? "ui-attention" : calculationBlocker != null || ticket.Status == MsapConstants.DispatchTicketStatus.CalculationPending ? "ui-critical" : "ui-complete")">@(approvalPending ? "Awaiting approval" : calculationBlocker != null || ticket.Status == MsapConstants.DispatchTicketStatus.CalculationPending ? "Calculation pending" : "Recorded")</span>
                                        }
                                        @if (ticket.PeriodStatus == MsapPeriodStatus.Adjusted)
                                        {
                                            <span class="schedule-status-pill ui-status ui-attention" title="Adjusted after period finalization">Adjusted</span>
                                        }
                                        else if (ticket.PeriodStatus == MsapPeriodStatus.Final)
                                        {
                                            <span class="schedule-status-pill" title="Finalized month-end period">Final</span>
                                        }
                                        @if (calculationBlocker != null)
                                        {
                                            <small class="cos-ticket-blocker ui-caption ui-muted">@calculationBlocker</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="cos-service-actions">
                                            @if (ViewData["CanViewActualTicket"] is true)
                                            {
                                                <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" asp-route-dispatchTicketId="@ticket.DispatchTicketId" asp-fragment="actualTicketEntry" class="cos-ticket-link">
                                                    <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span> View ticket
                                                </a>
                                            }
                                            @if (canVoidTicketRow && ticket.Status != MsapConstants.DispatchTicketStatus.Billed && ticket.Status != MsapConstants.DispatchTicketStatus.Deleted)
                                            {
                                                <button type="button" class="cos-cancel-subtext" data-void-ticket="@ticket.DispatchTicketId" data-cos-id="@Model.CustomerOrderSlipId" data-dispatch-number="@ticket.DispatchNumber" data-finalized="@(ticket.PeriodStatus == MsapPeriodStatus.Final ? "true" : "false")" data-url="@Url.Action("VoidTicket", "DispatchTicket")">Void ticket</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (tugIds.Count == 0) { <p class="ui-body ui-muted">No services or tickets recorded.</p> }
        </section>
        @if (ticketEntry != null)
        {
            <section class="ui-panel ui-stack" id="actualTicketEntry" aria-labelledby="actualTicketTitle">
                <div class="cos-section-heading"><h2 class="ui-section-title" id="actualTicketTitle">@(ViewData["EditActualTicket"] is true ? "Edit actual ticket" : ticketEntry.DispatchTicketId.HasValue ? "View actual ticket" : "Enter actual ticket") · @(selectedEntry?.Tugboat.TugboatName ?? viewedTicket?.Tugboat.TugboatName) / @(selectedEntry?.Service.ServiceName ?? viewedTicket?.Service.ServiceName)</h2><span class="schedule-status-pill">@(ticketEntry.DispatchTicketId.HasValue ? "Recorded" : "Not saved yet")</span></div>
                <partial name="_ActualTicketEntry" model="ticketEntry" />
            </section>
        }
        @{
            var otherTugTickets = Model.DispatchTickets.Where(t => !t.Tugboat.IsCompanyOwned && t.VesselScheduleServiceEntryId.HasValue && t.Status != MsapConstants.DispatchTicketStatus.Deleted).ToList();
            var otherCharges = ViewData["OtherTugCharges"] as List<OtherTugCharge> ?? [];
            var canViewOtherCharges = ViewData["CanViewOtherTugCharges"] is true;
            var canManageOtherCharges = ViewData["CanManageOtherTugCharges"] is true;
        }
        @if (otherTugTickets.Count > 0)
        {
            <section class="ui-panel ui-stack" id="otherTugCharges" aria-labelledby="otherTugChargesTitle">
                <h2 id="otherTugChargesTitle" class="ui-section-title">Other Tug Charges</h2>
                <p class="ui-caption ui-muted">Provider charges are reviewed separately from actual tickets and customer billing. Missing costs remain pending. Payment is handled in IBS.</p>
                <div class="schedule-services-table"><table class="schedule-review-table">
                    <thead><tr><th>Tugboat / ticket</th><th>Provider</th><th>Provider reference</th><th>Allocated charge (₱)</th><th>Status</th><th>Action</th></tr></thead>
                    <tbody>
                    @foreach (var ticket in otherTugTickets)
                    {
                        var charge = otherCharges.FirstOrDefault(c => c.Lines.Any(l => l.DispatchTicketId == ticket.DispatchTicketId));
                        var line = charge?.Lines.Single(l => l.DispatchTicketId == ticket.DispatchTicketId);
                        <tr class="@(charge?.ConfirmedAt.HasValue == true ? "" : "ui-attention")">
                            <td>@ticket.Tugboat.TugboatName<small class="ui-caption ui-muted">@ticket.DispatchNumber</small></td>
                            <td>@(charge?.ProviderName ?? ticket.Tugboat.TugboatOwner?.TugboatOwnerName ?? "Provider not assigned")</td>
                            <td>@(charge?.ProviderReference ?? "—")</td>
                            <td>@(line == null ? "Pending" : canViewOtherCharges ? line.Amount.ToString("N2") : "Restricted")</td>
                            <td><span class="schedule-status-pill ui-status @(charge?.ConfirmedAt.HasValue == true ? "ui-complete" : "ui-attention")">@(charge == null ? "Provider charge pending" : charge.ConfirmedAt.HasValue ? "Charge confirmed" : "For reviewing")</span></td>
                            <td>
                                @if (charge != null && canViewOtherCharges)
                                {
                                    <a asp-controller="OtherTugCharge" asp-action="Editor" asp-route-id="@charge.OtherTugChargeId" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="cos-ticket-link">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span> @(charge.ConfirmedAt.HasValue ? "View charge" : "Review charge")
                                    </a>
                                }
                                else if (canManageOtherCharges && ticket.Tugboat.TugboatOwnerId.HasValue)
                                {
                                    <a asp-controller="OtherTugCharge" asp-action="Editor" asp-route-id="" asp-route-ticketId="@ticket.DispatchTicketId" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="cos-ticket-link cos-ticket-primary">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">add</span> Record provider charge
                                    </a>
                                }
                                else { <span class="ui-caption ui-muted">@(ticket.Tugboat.TugboatOwnerId.HasValue ? "Finance follow-up" : "Assign the tugboat provider in master files")</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <section class="ui-panel ui-stack"><h2 class="ui-section-title">Planning notes</h2><p class="ui-body schedule-note">@Model.Remarks</p></section>
        }
        @if (canViewAuditHistory)
        {
            <section class="ui-panel" id="timelineAccordion" aria-label="Workflow activity">
                <button type="button" id="timelineToggle" class="cos-timeline-toggle" aria-expanded="false" aria-controls="timelineBody"><span class="ui-section-title">Workflow timeline</span><span class="material-symbols-outlined" id="timelineChevron" aria-hidden="true">expand_more</span></button>
                <div id="timelineBody" style="overflow:hidden;max-height:0;opacity:0"><div id="timelineContainer"><p class="ui-body ui-muted">Expand to load the workflow activity.</p></div></div>
            </section>
        }
        <footer class="cos-details-footer">
            <span class="ui-caption ui-muted">@progress.Guidance</span>
            <span class="ui-body">@Model.DispatchTickets.Count(t => t.Status != MsapConstants.DispatchTicketStatus.Deleted) ticket(s)@if (canViewRates) {<text> · Calculated billing ₱ @Model.DispatchTickets.Where(ticket => ticket.Status != MsapConstants.DispatchTicketStatus.CalculationPending && ticket.Status != MsapConstants.DispatchTicketStatus.Deleted).Sum(ticket => ticket.TotalBilling).ToString("N2")</text>
                @if (Model.DispatchTickets.Any(ticket => ticket.Status == MsapConstants.DispatchTicketStatus.CalculationPending))
                {
                    <span class="ui-caption ui-muted">· Unresolved charges excluded</span>
                }}</span>
        </footer>
    </main>
</div>

@section Scripts {
    <script src="~/msap/js/cos-ticket-entry.js" asp-append-version="true"></script>
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '.job-progress', title: 'Follow the job', text: 'Review the current stage and next action, from schedule approval through actual tickets, billing, collection, deposit and clearing. Read any blockers before continuing.', interactive: false },
            { selector: '#cosBookingDetails', title: 'COS booking details', text: 'Check the customer, vessel, service location, voyage and planned window. Open the linked schedule to review the booking and rates. Direct COS records can be edited only when their state and your access allow it.', interactive: false },
            { selector: '#cosServices', title: 'Services and actual tickets', text: 'Services are grouped by tugboat. Use the available row action to enter a missing actual ticket or view a saved one. Review actual hours, billable hours and service status. Urgent entry can record actuals before approval; charges and billing remain pending.', interactive: false },
            { selector: '#actualTicketEntry', title: 'Record or review an actual ticket', text: 'Check the ticket number, master, actual start and end, and supporting files. Service and tugboat come from the planned entry. Hourly charges use a one-hour minimum; SBMA uses actual service time. Save actual ticket or Save changes records your entry; Close ticket returns to the service list.', interactive: false },
            { selector: '#otherTugCharges', title: 'Provider charges', text: 'Review subcontractor charges separately from customer billing. Record or review a provider charge through the available action. Missing provider costs remain pending; provider payment is handled in IBS.', interactive: false },
            { selector: '#timelineAccordion', title: 'Workflow activity', text: 'Expand the workflow timeline to load the activity history available to your role.', interactive: false },
            { selector: '.cos-details-footer', title: 'Ticket totals', text: 'Review the ticket count and calculated billing total. Tickets with unresolved charges are excluded from the calculated total.', interactive: false }
        ].filter(function (step) {
            return document.querySelector(step.selector);
        });
    </script>
    <script>
        const PageConfig = {
            customerOrderSlipId: @Model.CustomerOrderSlipId,
            customerOrderSlipNumber: '@Model.CustomerOrderSlipNumber',
            status: '@Model.Status',
            hasTickets: @(Model.DispatchTickets.Any() ? "true" : "false"),
            messages: {
                error:   @Json.Serialize(TempData.Peek("error") ?? TempData.Peek("Denied")),
                success: @Json.Serialize(TempData.Peek("success")),
                warning: @Json.Serialize(TempData.Peek("warning"))
            }
        };

        $(document).ready(function () {
            @if (TempData["PromptAddTicket"] is true && (booking == null || booking.ServiceEntries.Count == 0) && ViewBag.CanCreateDispatchTicket == true && Model.Status == MsapConstants.CustomerOrderSlipStatus.Open && !bookingClosed && !ViewBag.HasBilling && Model.DispatchTickets.All(t => t.Status != MsapConstants.DispatchTicketStatus.Billed))
            {
                <text>
                ModernAlert.confirm({ title: 'Dispatch Ticket saved', text: 'Do you need to add more tickets?', icon: 'question', confirmText: 'Add another ticket', cancelText: 'Continue with existing tickets' })
                    .then(result => { if (result.isConfirmed) window.location.href = '@Url.Action("Create", "DispatchTicket", new { area = "MSAP", customerOrderSlipId = Model.CustomerOrderSlipId })'; });
                </text>
            }
            // Show TempData messages
            if (PageConfig.messages.error) {
                ModernAlert.error(PageConfig.messages.error);
            }
            if (PageConfig.messages.success) {
                ModernAlert.success(PageConfig.messages.success);
            }
            if (PageConfig.messages.warning) {
                ModernAlert.warning(PageConfig.messages.warning);
            }

            // Accordion: lazy-load timeline on first expand
            let timelineLoaded = false;
            $('#timelineToggle').on('click', function () {
                const $body = $('#timelineBody');
                const $chevron = $('#timelineChevron');
                const isExpanded = $(this).attr('aria-expanded') === 'true';

                if (isExpanded) {
                    // Collapse
                    $body.css({ 'max-height': '0', 'opacity': '0' });
                    $chevron.css('transform', 'rotate(0deg)');
                    $(this).attr('aria-expanded', 'false');
                } else {
                    // Expand
                    $(this).attr('aria-expanded', 'true');
                    $chevron.css('transform', 'rotate(180deg)');

                    if (!timelineLoaded) {
                        timelineLoaded = true;
                        loadTimeline();
                    }

                    // Set to a large enough max-height so content fully shows
                    $body.css({ 'max-height': '5000px', 'opacity': '1' });
                }
            });
        });

        function loadTimeline() {
            $.get('@Url.Action("GetTimeline", "AuditTrail", new { area = "MSAP" })', { id: PageConfig.customerOrderSlipId }, function(data) {
                $('#timelineContainer').html(data);
            }).fail(function() {
                $('#timelineContainer').html('<div class="text-center py-4 text-danger"><p>Failed to load timeline.</p></div>');
            });
        }

    </script>
}
