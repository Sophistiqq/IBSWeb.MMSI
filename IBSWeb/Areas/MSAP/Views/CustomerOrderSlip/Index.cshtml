<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
@{
    ViewData["Title"] = "COS records";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <!-- Header Section -->
        <div class="flex-stack ui-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb">
                    <li>MSAP</li>
                    <li aria-current="page">COS records</li>
                </ol></nav>
                <h1 class="modern-headline-lg ui-page-title" data-page-header>@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2 ui-actions">
                @if (ViewBag.CanCreate == true)
                {
                    <a asp-controller="VesselSchedule" asp-action="Create" class="modern-btn-primary" data-hotkey="c">
                        <span class="material-symbols-outlined">add_circle</span>
                        CREATE SCHEDULE
                    </a>
                }
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card ui-card">
            <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">list_alt</span>
                    <h2 class="modern-headline-md ui-section-title">COS List</h2>
                </div>
                <div class="flex items-center gap-2">
                    <label class="modern-label mb-0 ui-label" style="color: var(--on-surface-variant)">Filter by Date:</label>
                    <input type="date" id="dateFilter" class="modern-input ui-input" style="height: 32px; padding: 0 12px; font-size: 0.875rem; border-radius: 6px;">
                </div>
            </div>
            <div class="modern-card-body ui-card-body">
                <table class="modern-table ui-table" id="customerOrderSlipsTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>COS #</th>
                            <th>Customer</th>
                            <th>Vessel</th>
                            <th>COS #</th>
                            <th>Voyage #</th>
                            <th class="text-center">Tickets</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { selector: '.flex-stack', title: 'COS records', text: 'Open a COS below. Create a schedule to begin a new booking; approval creates its linked COS.', interactive: false },
            { selector: '#dateFilter', title: 'Filter by date', text: 'Choose an order date to narrow the list. Clear the date to show all orders again.', interactive: false },
            { selector: '#customerOrderSlipsTable', title: 'COS list', text: 'Review the customer, vessel, ticket count, and status. Select an order number or View Details to continue its workflow.', interactive: false }
        ];
    </script>
    <script>
        $(document).ready(function () {
            const detailsUrl = '@Url.Action("Details", "CustomerOrderSlip", new { area = "MSAP" })';

            const urlParams = new URLSearchParams(window.location.search);
            const searchTerm = urlParams.get('q') || '';

            let table = $('#customerOrderSlipsTable').DataTable(ModernTable.config({
                order: [[0, 'desc']],
                search: { search: searchTerm },
                columnDefs: [
                    { targets: [6, 7, 8], className: 'text-center' },
                    { targets: [8], orderable: false }
                ],
                ajax: ModernTable.ajax("@Url.Action("GetCustomerOrderSlipList", "CustomerOrderSlip", new { area = "MSAP" })"),
                columns: [
                    {
                        data: "date",
                        defaultContent: "",
                        render: (data) => ModernTable.render.date(data)
                    },
                    {
                        data: "customerOrderSlipNumber",
                        render: (data, type, row) => `<a href="${detailsUrl}?id=${row.customerOrderSlipId}" class="font-bold" style="text-decoration:none; color: var(--primary)">${data}</a>`
                    },
                    {
                        data: "customer.customerName",
                        defaultContent: "",
                        render: (data) => ModernTable.render.ellipsis(data, 250)
                    },
                    {
                        data: "vessel.vesselName",
                        defaultContent: "",
                        render: (data) => `<span class="font-bold uppercase">${ModernTable.render.ellipsis(data, 200)}</span>`
                    },
                    { data: "cosNumber", defaultContent: "-" },
                    { data: "voyageNumber", defaultContent: "" },
                    {
                        data: "dispatchTickets",
                        render: (data) => `<span class="modern-badge-sm" style="background-color: var(--surface-container-low); color: var(--on-surface-variant)">${data ? data.length : 0}</span>`
                    },
                    {
                        data: "status",
                        render: (data) => {
                            const cls = data === "Open" ? "status-open" : "status-closed";
                            return ModernTable.render.badge(data === "Closed" ? "@MsapConstants.CustomerOrderSlipStatus.GetDisplayName(MsapConstants.CustomerOrderSlipStatus.Closed)" : data, cls);
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'View Details', icon: 'visibility', url: `${detailsUrl}?id=${row.customerOrderSlipId}` }
                        ])
                    }
                ]
            }));

            // Date filter
            $('#dateFilter').on('change', function () {
                table.column(0).search($(this).val()).draw();
            });

            // Sync search with URL
            table.on('search.dt', function () {
                const query = table.search();
                const url = new URL(window.location);
                if (query) url.searchParams.set('q', query);
                else url.searchParams.delete('q');
                window.history.replaceState({}, '', url);
            });
        });
    </script>
}
