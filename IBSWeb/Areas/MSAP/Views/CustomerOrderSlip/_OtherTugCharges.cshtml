@model CustomerOrderSlip
@{
    var tickets = Model.DispatchTickets.Where(t => !t.Tugboat.IsCompanyOwned && t.VesselScheduleServiceEntryId.HasValue).ToList();
    var charges = ViewData["OtherTugCharges"] as List<OtherTugCharge> ?? [];
    var canView = ViewData["CanViewOtherTugCharges"] is true;
    var canManage = ViewData["CanManageOtherTugCharges"] is true;
}
@if (tickets.Count > 0)
{
    <section class="ui-panel ui-stack" id="otherTugCharges" aria-labelledby="otherTugChargesTitle">
        <h2 id="otherTugChargesTitle" class="ui-section-title">Other Tug Charges</h2>
        <p class="ui-caption ui-muted">Provider charges are reviewed separately from actual tickets and customer billing. Missing costs remain pending. Payment is handled in IBS; its payment link is not yet integrated.</p>
        <div class="schedule-services-table"><table class="schedule-review-table">
            <thead><tr><th>Tugboat / ticket</th><th>Provider</th><th>Provider reference</th><th>Allocated charge</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var ticket in tickets)
            {
                var charge = charges.FirstOrDefault(c => c.Lines.Any(l => l.DispatchTicketId == ticket.DispatchTicketId));
                var line = charge?.Lines.Single(l => l.DispatchTicketId == ticket.DispatchTicketId);
                <tr class="@(charge?.ConfirmedAt.HasValue == true ? "" : "ui-attention")">
                    <td>@ticket.Tugboat.TugboatName<small class="ui-caption ui-muted">@ticket.DispatchNumber</small></td>
                    <td>@(charge?.ProviderName ?? ticket.Tugboat.TugboatOwner?.TugboatOwnerName ?? "Provider not assigned")</td>
                    <td>@(charge?.ProviderReference ?? "—")</td>
                    <td>@(line == null ? "Pending" : canView ? line.Amount.ToString("N2") : "Restricted")</td>
                    <td><span class="schedule-status-pill ui-status @(charge?.ConfirmedAt.HasValue == true ? "ui-complete" : "ui-attention")">@(charge == null ? "Provider charge pending" : charge.ConfirmedAt.HasValue ? "Charge confirmed" : "For reviewing")</span></td>
                    <td>
                        @if (charge != null && canView)
                        {
                            <a asp-controller="OtherTugCharge" asp-action="Editor" asp-route-id="@charge.OtherTugChargeId" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="cos-ticket-link">@(charge.ConfirmedAt.HasValue ? "View charge" : "Review charge")</a>
                        }
                        else if (canManage && ticket.Tugboat.TugboatOwnerId.HasValue)
                        {
                            <a asp-controller="OtherTugCharge" asp-action="Editor" asp-route-ticketId="@ticket.DispatchTicketId" asp-route-customerOrderSlipId="@Model.CustomerOrderSlipId" class="cos-ticket-link">Record provider charge</a>
                        }
                        else { <span class="ui-caption ui-muted">@(ticket.Tugboat.TugboatOwnerId.HasValue ? "Finance follow-up" : "Assign the tugboat provider in master files")</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    </section>
}
