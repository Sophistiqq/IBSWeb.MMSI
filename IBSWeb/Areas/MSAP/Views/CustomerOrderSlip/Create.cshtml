@model IBS.Models.MSAP.ViewModels.CustomerOrderSlipViewModel

@{
    ViewData["Title"] = "Create COS";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form asp-action="Create" method="post" id="customerOrderSlipForm">
        <main class="modern-container">
            <!-- Header Section -->
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">COS records</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">New COS</span>
                    </div>
                    <h1 class="modern-headline-lg" data-page-header>Create COS</h1>
                </div>
                <div class="flex gap-2" data-tour-step="11">
                    <button type="button" class="modern-btn-primary" id="confirmCreateBtn">
                        <span class="material-symbols-outlined">save</span> Create COS
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid">
                <!-- Left Column: Primary Logistics & Remarks (col-8) -->
                <section class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">anchor</span>
                            <h2 class="modern-headline-md">Logistics & Vessel Details</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="modern-grid">
                                <div class="modern-col-8">
                                    <label asp-for="CustomerId" class="modern-label">Customer <span class="text-error">*</span></label>
                                    <div id="CustomerContainer" data-tour-step="1">
                                        <select asp-for="CustomerId" asp-items="@Model.Customers" class="js-modern-select" id="CustomerId" data-testid="select-CustomerId" data-placeholder="-- Select Customer --">
                                            <option value="">-- Select Customer --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="CustomerId" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4" data-tour-step="2">
                                    <label asp-for="Date" class="modern-label">Order Date</label>
                                    <input asp-for="Date" type="date" class="modern-input" />
                                    <span asp-validation-for="Date" class="text-error text-xs"></span>
                                </div>
                            </div>

                            <div class="modern-grid mt-2">
                                <div class="modern-col-4">
                                    <label asp-for="VesselId" class="modern-label">Vessel</label>
                                    <div id="VesselContainer" data-tour-step="3">
                                        <select asp-for="VesselId" asp-items="@Model.Vessels" class="js-modern-select" id="VesselSelect" data-testid="select-VesselId" data-placeholder="-- Select Vessel --">
                                            <option value="">-- Select Vessel --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="VesselId" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="PortId" class="modern-label">Port</label>
                                    <div id="PortContainer" data-tour-step="4">
                                        <select asp-for="PortId" asp-items="@Model.Ports" class="js-modern-select" id="PortId" data-testid="select-PortId" data-placeholder="-- Select Port --">
                                            <option value="">-- Select Port --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="PortId" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="TerminalId" class="modern-label">Terminal</label>
                                    <div id="TerminalContainer" data-tour-step="5">
                                        <select asp-for="TerminalId" asp-items="@Model.Terminals" class="js-modern-select" id="TerminalId" data-testid="select-TerminalId" data-placeholder="-- Select Terminal --">
                                            <option value="">-- Select Terminal --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="TerminalId" class="text-error text-xs"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modern-card" style="flex: 1;">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">notes</span>
                            <h2 class="modern-headline-md">Remarks</h2>
                        </div>
                        <div class="modern-card-body" style="height: 100%;" data-tour-step="10">
                            <textarea asp-for="Remarks" class="modern-input" style="height: 100%; min-height: 150px;" placeholder="Additional notes or special instructions..."></textarea>
                            <span asp-validation-for="Remarks" class="text-error text-xs"></span>
                        </div>
                    </div>
                </section>

                <!-- Right Column: Metadata & Timing (col-4) -->
                <section class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                    <div class="modern-card">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">description</span>
                            <h2 class="modern-headline-md">References</h2>
                        </div>
                        <div class="modern-card-body">
                            <div data-tour-step="6">
                                <label asp-for="COSNumber" class="modern-label">COS Number</label>
                                <input asp-for="COSNumber" class="modern-input" placeholder="Optional" maxlength="20" />
                                <span asp-validation-for="COSNumber" class="text-error text-xs"></span>
                            </div>
                            <div class="mt-3" data-tour-step="7">
                                <label asp-for="VoyageNumber" class="modern-label">Voyage Number</label>
                                <input asp-for="VoyageNumber" class="modern-input" placeholder="Optional" maxlength="100" />
                                <span asp-validation-for="VoyageNumber" class="text-error text-xs"></span>
                            </div>
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-high); color: var(--on-surface);">
                            <span class="material-symbols-outlined">schedule</span>
                            <h2 class="modern-headline-md">Planned Schedule</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="flex flex-column" style="gap: 1.25rem;">
                                <div data-tour-step="8">
                                    <label asp-for="PlannedStartTime" class="modern-label">Planned Arrival/Start</label>
                                    <input asp-for="PlannedStartTime" type="datetime-local" class="modern-input timeline-input" id="PlannedStartTime" />
                                    <span asp-validation-for="PlannedStartTime" class="text-error text-xs"></span>
                                </div>
                                <div data-tour-step="9">
                                    <label asp-for="PlannedEndTime" class="modern-label">Planned Departure/End</label>
                                    <input asp-for="PlannedEndTime" type="datetime-local" class="modern-input timeline-input" id="PlannedEndTime" />
                                    <span asp-validation-for="PlannedEndTime" class="text-error text-xs"></span>
                                    <div id="durationWarning" class="text-error text-xs mt-1" style="display: none;">
                                        <span class="material-symbols-outlined text-xs" style="vertical-align: middle;">warning</span> End time must be after start time.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { step: 1, title: "Customer", text: "Select the customer requesting the tug service. Check the customer name carefully; this identifies the customer on the COS and related dispatch tickets." },
            { step: 2, title: "Order Date", text: "The order date defaults to today in Philippine time. Set it to the date this COS should be recorded under. The planned arrival and departure times are entered separately.", autoAdvance: false },
            { step: 3, title: "Vessel", text: "Select the vessel that will receive the tug service. Confirm that the vessel name matches the service request before choosing the port and terminal." },
            { step: 4, title: "Port", text: "Select the port where the service will take place. Changing the port clears the selected terminal and loads the terminals for the new port, so select the terminal again." },
            { step: 5, title: "Terminal", text: "Select the terminal within the chosen port where the vessel will be serviced. If the expected terminal is missing, first check that you selected the correct port." },
            { step: 6, title: "COS Number (Optional)", text: "Enter the COS reference number from the supporting document, if available. Use the reference exactly as provided, up to 20 characters, or leave this field blank.", required: false, autoAdvance: false },
            { step: 7, title: "Voyage Number (Optional)", text: "Enter the voyage reference for this vessel visit, if available. This helps distinguish the trip from other visits by the same vessel. Leave it blank if no reference was provided.", required: false, autoAdvance: false },
            { step: 8, title: "Planned Arrival/Start (Optional)", text: "Enter the expected arrival or service start date and time, if known. This records the planned timing; actual service times are recorded on the dispatch ticket. Leave it blank if the plan is not yet known.", required: false, autoAdvance: false },
            { step: 9, title: "Planned Departure/End (Optional)", text: "Enter the expected departure or service end date and time, if known. When both planned times are entered, the end must be later than the start. Check the date as well as the time for overnight service.", required: false, autoAdvance: false },
            { step: 10, title: "Remarks (Optional)", text: "Add special instructions or details the team needs for this job, such as coordination notes or service requirements. Leave this blank when there are no additional instructions.", required: false, autoAdvance: false },
            { step: 11, title: "Create COS", text: "Review the customer, vessel, location, references, and planned schedule. Click Create COS, then confirm to save. The new order opens in Details, where you can continue with dispatch tickets. Cancel returns to the list without saving.", autoAdvance: false }
        ];
    </script>

    <script>
        $(document).ready(function () {
            // ── Planned Duration Validation ────────────────────────────────
            function validatePlannedTimes() {
                const startVal = $("#PlannedStartTime").val();
                const endVal = $("#PlannedEndTime").val();
                if (!startVal || !endVal) return;

                const start = new Date(startVal);
                const end = new Date(endVal);
                const $warning = $("#durationWarning");
                const $submitBtn = $("button[type='submit']");

                if (!isNaN(start) && !isNaN(end)) {
                    if (end <= start) {
                        $warning.show();
                        $submitBtn.prop("disabled", true).css('opacity', '0.5');
                    } else {
                        $warning.hide();
                        $submitBtn.prop("disabled", false).css('opacity', '1');
                    }
                }
            }

            $(".timeline-input").on("change input", validatePlannedTimes);

            // ── Port-Terminal Cascade ──────────────────────────────────────
            $('#PortId').on('change', function () {
                var portId = $(this).val();
                var terminalSelect = $('#TerminalId');

                terminalSelect.empty().append('<option value="">-- Select Terminal --</option>');
                terminalSelect.trigger('change');

                if (!portId) return;

                $.ajax({
                    url: '@Url.Action("ChangeTerminal", "CustomerOrderSlip")',
                    type: 'GET',
                    data: { portId: portId },
                    success: function (data) {
                        $.each(data, function (i, item) {
                            terminalSelect.append($('<option>', {
                                value: item.value,
                                text: item.text
                            }));
                        });
                        terminalSelect.trigger('change');
                    }
                });
            });

            $('#confirmCreateBtn').on('click', confirmCreate);
        });

        function confirmCreate() {
            if (!ModernFormValidator.validate('customerOrderSlipForm')) return;

            ModernAlert.confirm({
                title: 'Create COS?',
                text: "Please ensure all details are correct before proceeding.",
                icon: 'question',
                confirmText: 'Yes, create it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    ModernAlert.showLoading("Creating COS...");
                    document.getElementById("customerOrderSlipForm").submit();
                }
            });
        }
    </script>
}
