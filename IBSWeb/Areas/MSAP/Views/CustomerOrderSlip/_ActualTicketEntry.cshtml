@model DispatchTicketViewModel
@inject IBS.Services.MSAP.IRoleService MsapRoleService
@{
    var editing = Model.DispatchTicketId.HasValue && ViewData["EditActualTicket"] is true;
    var readOnly = Model.DispatchTicketId.HasValue && !editing;
    var savedTicket = ViewData["ViewedTicket"] as DispatchTicket;
    var cos = ViewData["Cos"] as CustomerOrderSlip;
    var booking = ViewBag.VesselSchedule as VesselSchedule;
    var canEdit = readOnly && ViewBag.CanEditTicket == true && ViewBag.HasBilling != true
        && cos?.Status == MsapConstants.CustomerOrderSlipStatus.Open
        && Model.Status != MsapConstants.DispatchTicketStatus.Billed && savedTicket?.Status != MsapConstants.DispatchTicketStatus.Deleted
        && booking?.Status != MsapConstants.VesselScheduleStatus.Cancelled;
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var role = readOnly || userId == null ? null : await MsapRoleService.GetUserRoleAsync(userId);
    var imageRequired = role != MsapRoles.Admin && string.IsNullOrEmpty(Model.ImageName);
    var canVoid = canEdit && savedTicket != null && savedTicket?.Status != MsapConstants.DispatchTicketStatus.Billed && savedTicket?.Status != MsapConstants.DispatchTicketStatus.Deleted;
    var canViewRates = ViewData["CanViewRates"] is true;
    var serviceEntry = booking?.ServiceEntries.SingleOrDefault(e => e.VesselScheduleServiceEntryId == (savedTicket?.VesselScheduleServiceEntryId ?? Model.VesselScheduleServiceEntryId));
    var serviceNumber = Model.ServiceNumber ?? savedTicket?.Service?.ServiceNumber ?? serviceEntry?.Service?.ServiceNumber;
    var isWatering = MsapConstants.IsWateringService(serviceNumber);
    var isNewTicket = !Model.DispatchTicketId.HasValue;
    var hasInitialImage = !string.IsNullOrEmpty(Model.ImageSignedUrl);
}
<form asp-controller="DispatchTicket" asp-action="@(editing ? "EditTicket" : "Create")" method="post" enctype="multipart/form-data" class="ui-stack cos-ticket-entry-form" id="@(readOnly ? "cosActualTicketDetails" : "cosActualTicketForm")" data-is-new-ticket="@(isNewTicket ? "true" : "false")" data-is-editing="@(editing ? "true" : "false")" data-is-readonly="@(readOnly ? "true" : "false")" data-image-required="@(imageRequired ? "true" : "false")" data-has-initial-image="@(hasInitialImage ? "true" : "false")" onsubmit="@(readOnly ? "return false;" : null)">
    <input name="inlineEntry" type="hidden" value="true" />
    <input asp-for="DispatchTicketId" type="hidden" />
    <input asp-for="CustomerOrderSlipId" type="hidden" />
    <input asp-for="VesselScheduleServiceEntryId" type="hidden" />
    <input asp-for="CustomerId" type="hidden" /><input asp-for="VesselId" type="hidden" />
    <input asp-for="PortId" type="hidden" /><input asp-for="TerminalId" type="hidden" />
    <input asp-for="TugBoatId" type="hidden" /><input asp-for="ServiceId" type="hidden" />
    <input asp-for="VoyageNumber" type="hidden" />
    @if (!readOnly)
    {
        <input id="cosTicketImage" name="imageFile" type="file" accept="image/*" class="cos-sr-file-input" required="@imageRequired" tabindex="-1" aria-label="Supporting dispatch ticket image" />
        <input id="cosTicketCamera" type="file" accept="image/*" capture="environment" class="cos-sr-file-input" tabindex="-1" aria-label="Take dispatch ticket photo with camera" />
    }
    @if (isNewTicket)
    {
        <div class="cos-photo-first-gate" id="cosPhotoFirstGate">
            <div class="cos-photo-dropzone" id="cosPhotoDropzone">
                <span class="material-symbols-outlined cos-photo-dropzone-icon" aria-hidden="true">add_a_photo</span>
                <h3 class="ui-section-title">Start with the dispatch ticket photo</h3>
                <p class="ui-body ui-muted">Take a photo, choose one from your device, drag &amp; drop it here, or press <kbd>Ctrl+V</kbd> to paste. The photo will open side-by-side with the entry form.</p>
                <div class="cos-photo-dropzone-actions">
                    <button type="button" class="modern-btn-primary cos-camera-only" data-trigger-camera-upload>
                        <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span> Take photo
                    </button>
                    <button type="button" class="modern-btn-primary" data-trigger-photo-upload>
                        <span class="material-symbols-outlined" aria-hidden="true">upload_file</span> Choose photo
                    </button>
                    @if (!imageRequired)
                    {
                        <button type="button" class="modern-btn-secondary" data-skip-photo>Skip photo</button>
                    }
                </div>
            </div>
        </div>
    }
    <div class="cos-entry-workspace" id="cosEntryWorkspace" data-has-image="@(hasInitialImage ? "true" : "false")" data-image-collapsed="false">
        <aside class="cos-image-pane" id="cosTicketImagePane" aria-label="Dispatch ticket photo reference">
            <div class="cos-image-pane-header">
                <div class="cos-image-pane-heading">
                    <span class="material-symbols-outlined" aria-hidden="true">image</span>
                    <span class="cos-image-pane-title" id="cosTicketImageStatus">@(hasInitialImage ? "Saved photo" : "Ticket photo")</span>
                </div>
                <div class="cos-image-toolbar" role="toolbar" aria-label="Image controls">
                    <button type="button" class="cos-icon-btn" data-image-rotate title="Rotate 90°" aria-label="Rotate 90 degrees"><span class="material-symbols-outlined" aria-hidden="true">rotate_right</span></button>
                    <button type="button" class="cos-icon-btn" data-image-reset title="Reset view" aria-label="Reset view"><span class="material-symbols-outlined" aria-hidden="true">restart_alt</span></button>
                    @if (!readOnly)
                    {
                        <button type="button" class="cos-icon-btn" data-trigger-photo-upload title="Replace photo" aria-label="Replace photo"><span class="material-symbols-outlined" aria-hidden="true">photo_camera</span></button>
                    }
                    <button type="button" class="cos-icon-btn" data-image-fullscreen title="Fullscreen" aria-label="Fullscreen preview"><span class="material-symbols-outlined" aria-hidden="true">open_in_full</span></button>
                    <button type="button" class="cos-icon-btn cos-image-collapse-btn" data-image-toggle title="Hide photo" aria-label="Hide photo" aria-expanded="true"><span class="material-symbols-outlined" aria-hidden="true">expand_less</span></button>
                </div>
            </div>
            <div class="cos-image-pane-body" id="cosTicketImageBody">
                <div class="cos-image-pane-stage" id="cosTicketImageStage">
                    <img id="cosTicketImagePreview" class="cos-image-pane-img" src="@(hasInitialImage ? Model.ImageSignedUrl : null)" data-initial-url="@(Model.ImageSignedUrl ?? "")" alt="Dispatch ticket photo preview" hidden="@(!hasInitialImage)" />
                    <div class="cos-image-empty" id="cosTicketImageEmpty" hidden="@hasInitialImage">
                        <span class="material-symbols-outlined" aria-hidden="true">hide_image</span>
                        <p class="ui-caption ui-muted">No dispatch ticket photo attached.</p>
                        @if (!readOnly)
                        {
                            <button type="button" class="modern-btn-secondary" data-trigger-photo-upload>
                                <span class="material-symbols-outlined" aria-hidden="true">upload_file</span> Attach photo
                            </button>
                        }
                    </div>
                </div>
                <p class="ui-caption ui-muted cos-image-pane-caption">Zoom or rotate as needed · Drag to pan when zoomed · Verify entries against hard copy</p>
            </div>
        </aside>
        <div class="cos-entry-main ui-stack" id="cosEntryMain">
    @if (savedTicket?.Status == MsapConstants.DispatchTicketStatus.Deleted)
    {
        <p class="ui-notice ui-critical" role="status">Voided · This ticket entry has been voided and is excluded from billing calculations.</p>
    }
    <p class="ui-caption">COS: @Model.COSNumber · Actual ticket details can be saved while approval or rates are pending. Billing requires approved COS terms and calculated charges.</p>
    <fieldset class="cos-entry-fields" disabled="@readOnly">
        <div class="ui-field"><label asp-for="DispatchNumber" class="ui-label">Actual ticket number *</label><input asp-for="DispatchNumber" class="modern-input ui-input" maxlength="20" required /></div>
        <div class="ui-field"><label asp-for="Date" class="ui-label">Ticket date *</label><input asp-for="Date" type="date" class="modern-input ui-input" required /></div>
        <div class="ui-field cos-entry-captain">
            @if (readOnly)
            {
                <label for="cosTicketCaptain" class="ui-label">Captain / tug master</label>
                <input id="cosTicketCaptain" class="modern-input ui-input" value="@(Model.TugMasters?.FirstOrDefault(c => c.Value == Model.TugMasterId?.ToString())?.Text ?? "Not recorded")" type="text" disabled />
            }
            else
            {
                <label asp-for="TugMasterId" class="ui-label">Captain / tug master *</label>
                <select asp-for="TugMasterId" asp-items="Model.TugMasters" class="js-modern-select" data-placeholder="Select captain" required><option value="">Select captain</option></select>
            }
        </div>
        <div class="ui-field cos-entry-half"><label for="DateLeft" class="ui-label">Actual start * · Philippine time</label><div class="cos-date-time"><input asp-for="DateLeft" type="date" class="modern-input ui-input" aria-label="Actual start date" required /><input asp-for="TimeLeft" type="time" class="modern-input ui-input" aria-label="Actual start time" required /></div></div>
        <div class="ui-field cos-entry-half cos-entry-end"><label for="DateArrived" class="ui-label">Actual end * · Philippine time</label><div class="cos-date-time"><input asp-for="DateArrived" type="date" class="modern-input ui-input" aria-label="Actual end date" required /><input asp-for="TimeArrived" type="time" class="modern-input ui-input" aria-label="Actual end time" required /></div></div>
        <div class="ui-field cos-entry-half">
            @if (readOnly)
            {
                <span class="ui-label">Supporting image</span>
                @if (!string.IsNullOrEmpty(Model.ImageSignedUrl))
                {
                    <a href="@Model.ImageSignedUrl" target="_blank" rel="noopener" class="cos-ticket-link">Open image in new tab</a>
                }
                else
                {
                    <span class="ui-body ui-muted">No image attached</span>
                }
            }
            else
            {
                <span class="ui-label">Supporting image @(imageRequired ? "*" : "")</span>
                <div class="cos-file-picker-row">
                    <button type="button" class="modern-btn-secondary cos-file-picker-btn cos-camera-only" data-trigger-camera-upload>
                        <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span> Take photo
                    </button>
                    <button type="button" class="modern-btn-secondary cos-file-picker-btn" data-trigger-photo-upload>
                        <span class="material-symbols-outlined" aria-hidden="true">upload_file</span> @(hasInitialImage ? "Replace photo" : "Choose photo")
                    </button>
                    <span class="ui-caption ui-muted cos-file-picker-name" id="cosTicketImageFileName">@(hasInitialImage ? (Model.ImageName ?? "Saved photo") : "No file selected")</span>
                </div>
                @if (editing && !string.IsNullOrEmpty(Model.ImageSignedUrl))
                {
                    <a href="@Model.ImageSignedUrl" target="_blank" rel="noopener" class="cos-ticket-link">Open current image</a>
                }
            }
        </div>
        <div class="ui-field cos-entry-half">
            @if (readOnly)
            {
                <span class="ui-label">Supporting video</span>
                @if (!string.IsNullOrEmpty(Model.VideoSignedUrl))
                {
                    <a href="@Model.VideoSignedUrl" target="_blank" rel="noopener" class="cos-ticket-link">View video</a>
                }
                else
                {
                    <span class="ui-body ui-muted">No video attached</span>
                }
            }
            else
            {
                <label for="cosTicketVideo" class="ui-label">Supporting video</label><input id="cosTicketVideo" name="videoFile" type="file" accept="video/*" class="modern-input ui-input" />
                @if (editing && !string.IsNullOrEmpty(Model.VideoSignedUrl))
                {
                    <a href="@Model.VideoSignedUrl" target="_blank" rel="noopener" class="cos-ticket-link">View current video</a>
                    <span class="ui-caption ui-muted">Choose a file only to replace the current video.</span>
                }
            }
        </div>
        @if (isWatering)
        {
            <div class="ui-field cos-entry-half"><label asp-for="Tons" class="ui-label">Tons *</label><input asp-for="Tons" type="number" step="0.0001" min="0.0001" class="modern-input ui-input" placeholder="e.g. 11" required /></div>
            <div class="ui-field cos-entry-half"><label asp-for="DispatchRate" class="ui-label">Rate (₱ / ton) *</label><input asp-for="DispatchRate" type="number" step="0.01" min="0.01" class="modern-input ui-input" placeholder="e.g. 500.00" required /></div>
        }
        <div class="ui-field cos-entry-remarks"><label asp-for="Remarks" class="ui-label">Remarks</label><textarea asp-for="Remarks" class="modern-input ui-input" rows="2" maxlength="100"></textarea></div>
    </fieldset>
    <div class="cos-duration-preview" aria-live="polite">
        <div class="ui-field"><span class="ui-caption ui-muted">Actual duration</span><output class="ui-value" id="cosActualDuration">@(readOnly ? $"{savedTicket?.RawDurationMinutes} min · {savedTicket?.RawDurationHours:0.00} hours" : "Enter actual times")</output></div>
        <div class="ui-field"><span class="ui-caption ui-muted">Billable duration</span><output class="ui-value" id="cosBillableDuration">@(readOnly ? $"{savedTicket?.TotalHours:0.00} hours" : "Enter actual times")</output></div>
        <p class="ui-caption ui-muted">Hourly charges use a one-hour minimum. SBMA uses actual service time.</p>
    </div>
    @if (savedTicket != null)
    {
        var progress = (JobProgressViewModel)ViewBag.JobProgress;
        var entry = booking?.ServiceEntries.SingleOrDefault(e => e.VesselScheduleServiceEntryId == savedTicket.VesselScheduleServiceEntryId);
        var blocker = progress?.CalculationBlockers.GetValueOrDefault(savedTicket.DispatchTicketId);
        var approvalPending = booking != null && (booking.ApprovedRevision != booking.Revision || booking.Status == MsapConstants.VesselScheduleStatus.Tentative);
        var calculated = savedTicket.Status is MsapConstants.DispatchTicketStatus.ForBilling or MsapConstants.DispatchTicketStatus.Billed;
        var cosDiscount = booking == null ? savedTicket.DispatchDiscount : booking.SkipCosDiscount ? 0m : booking.CosDiscountPercent.GetValueOrDefault();
        var tariffMethod = calculated ? savedTicket.DispatchChargeType : entry?.TariffBasis switch
        {
            TariffChargeBasis.PerHour => "Per hour",
            TariffChargeBasis.PerMove => "Per Move",
            _ => "Not specified"
        };
        var bafMethod = calculated ? savedTicket.BAFChargeType : entry?.BafMethod switch
        {
            BafCalculationMethod.PerHour => "Per hour",
            BafCalculationMethod.PerMove => "Per Move",
            BafCalculationMethod.Lumpsum => "Lumpsum",
            BafCalculationMethod.Industry => "Industry",
            _ => "Not specified"
        };

        @if (canViewRates)
        {
            <section class="cos-ticket-charges ui-stack" aria-labelledby="ticketChargesTitle">
                <div class="cos-section-heading">
                    <h3 class="ui-section-title" id="ticketChargesTitle">Ticket charges</h3>
                </div>
                <p class="ui-caption ui-muted">Service date: @(savedTicket.DateLeft?.ToString("dd MMM yyyy") ?? "Not entered") · @(approvalPending ? "Proposed COS discount" : "Approved COS discount"): @(booking?.SkipCosDiscount == true ? "0% · Skipped" : $"{cosDiscount:0.##}%")</p>
                @if (blocker != null)
                {
                    <p class="ui-notice ui-critical" role="status">@blocker</p>
                }
                <div class="schedule-services-table" role="region" aria-label="Saved ticket charge breakdown" tabindex="0">
                    <table class="modern-table ui-table schedule-review-table">
                        <thead><tr><th>Charge</th><th>Method</th><th>Rate (₱)</th><th>Source</th><th>Gross (₱)</th><th>Discount</th><th>Net (₱)</th></tr></thead>
                        <tbody>
                            <tr>
                                <th scope="row">Basic tariff</th><td>@tariffMethod</td>
                                <td>@(calculated ? savedTicket.DispatchRate.ToString("N2") : "Pending")</td>
                                <td>@(isWatering ? "Ticket entry" : calculated ? (savedTicket.IsManualTariffRate ? "Manual rate" : "Rate table") : "Rate table")</td>
                                <td>@(calculated ? savedTicket.DispatchBillingAmount.ToString("N2") : "Pending")</td>
                                <td>@(calculated ? $"{savedTicket.DispatchDiscount:0.##}%" : "—")</td>
                                <td>@(calculated ? savedTicket.DispatchNetRevenue.ToString("N2") : "Pending")</td>
                            </tr>
                            <tr>
                                <th scope="row">BAF</th><td>@bafMethod</td>
                                <td>@(calculated ? savedTicket.BAFRate.ToString("N2") : "Pending")</td>
                                <td>@(calculated ? (savedTicket.IsManualBafRate ? "Manual rate" : "Rate table") : "Rate table")</td>
                                <td>@(calculated ? savedTicket.BAFBillingAmount.ToString("N2") : "Pending")</td>
                                <td>@(calculated ? $"{savedTicket.BAFDiscount:0.##}%" : "—")</td>
                                <td>@(calculated ? savedTicket.BAFNetRevenue.ToString("N2") : "Pending")</td>
                            </tr>
                        </tbody>
                        <tfoot><tr><th scope="row" colspan="4">Total</th><td>@(calculated ? savedTicket.TotalBilling.ToString("N2") : "Pending")</td><td></td><td>@(calculated ? savedTicket.TotalNetRevenue.ToString("N2") : "Pending")</td></tr></tfoot>
                    </table>
                </div>
                <p class="ui-caption ui-muted">Amounts are in PHP. @(editing ? "These are the saved charges. Saving changes recalculates charges when actual service times change." : "Recalculation uses recorded service times and approved tariff terms. Missing-match manual tariffs follow approved table rates; job-specific tariff overrides remain fixed. Applicable approved weekly table BAF replaces manual BAF.")</p>
            </section>
        }
        else
        {
            <section class="cos-ticket-charges ui-stack" aria-labelledby="ticketChargesTitle">
                <h3 class="ui-section-title" id="ticketChargesTitle">Billing calculation status</h3>
                @if (blocker != null)
                {
                    <p class="ui-notice ui-critical" role="status">@blocker</p>
                }
                else
                {
                    <p class="ui-caption ui-muted">@(calculated ? "Calculated and ready for billing. Financial rates and amounts are restricted to Commercial and Finance." : "Pending tariff calculation.")</p>
                }
            </section>
        }
    }
        </div>
    </div>
    <div class="cos-entry-footer">
        @if (canVoid && savedTicket != null)
        {
            <button type="button" class="modern-btn-error" style="margin-right: auto;"
                data-void-ticket="@savedTicket!.DispatchTicketId"
                data-cos-id="@savedTicket!.CustomerOrderSlipId"
                data-cos-url="@Url.Action("Details", "CustomerOrderSlip", new { area = "MSAP", id = savedTicket!.CustomerOrderSlipId })"
                data-dispatch-number="@savedTicket!.DispatchNumber"
                data-finalized="@(savedTicket!.PeriodStatus is MsapPeriodStatus.Final or MsapPeriodStatus.Adjusted ? "true" : "false")"
                data-url="@Url.Action("VoidTicket", "DispatchTicket")">
                <span class="material-symbols-outlined" aria-hidden="true">cancel</span> Void ticket
            </button>
        }
        <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" class="modern-btn-secondary">@(readOnly ? "Close ticket" : editing ? "Cancel changes" : "Cancel entry")</a>
        @if (canEdit)
        {
            <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId" asp-route-dispatchTicketId="@Model.DispatchTicketId" asp-route-editTicket="true" class="modern-btn-primary"><span class="material-symbols-outlined" aria-hidden="true">edit</span> Edit ticket</a>
        }
        @if (!readOnly)
        {
            <button type="submit" class="modern-btn-primary cos-ticket-save-btn"><span class="material-symbols-outlined" aria-hidden="true">save</span> @(editing ? "Save changes" : "Save actual ticket")</button>
        }
    </div>
</form>
