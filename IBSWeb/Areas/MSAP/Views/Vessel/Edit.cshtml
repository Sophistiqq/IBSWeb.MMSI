@model IBS.Models.MSAP.ViewModels.VesselViewModel

@{
    ViewData["Title"] = "Edit Vessel";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <form asp-action="Edit" method="post" id="mainForm">
        <input type="hidden" asp-for="VesselId" />
        <main class="modern-container ui-page">
            <!-- Header Section -->
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Vessels</a></li><li aria-current="page">Edit Vessel</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2 ui-actions">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">edit</span>
                            <h2 class="modern-headline-md ui-section-title">Vessel Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="flex flex-column gap-4">
                                <div>
                                    <label asp-for="VesselName" class="modern-label ui-label">Vessel Name <span class="text-error">*</span></label>
                                    <input asp-for="VesselName" class="form-control ui-input" placeholder="Enter vessel name" />
                                    <span asp-validation-for="VesselName" class="text-error text-xs"></span>
                                </div>

                                <div class="modern-grid">
                                    <div class="modern-col-6">
                                        <label asp-for="VesselNumber" class="modern-label ui-label">Vessel # <span class="text-error">*</span></label>
                                        <input asp-for="VesselNumber" class="form-control ui-input" placeholder="Vessel number" />
                                        <span asp-validation-for="VesselNumber" class="text-error text-xs"></span>
                                    </div>
                                    <div class="modern-col-6">
                                        <label asp-for="VesselType" class="modern-label ui-label">Vessel Type <span class="text-error">*</span></label>
                                        <input asp-for="VesselType" class="form-control ui-input" placeholder="e.g. Bulk Carrier, Tanker" />
                                        <span asp-validation-for="VesselType" class="text-error text-xs"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
