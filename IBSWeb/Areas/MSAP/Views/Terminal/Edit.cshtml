@model IBS.Models.MSAP.ViewModels.TerminalViewModel

@{
    ViewData["Title"] = "Edit Terminal";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <form asp-action="Edit" method="post" id="mainForm">
        <input type="hidden" asp-for="TerminalId" />
        <main class="modern-container ui-page">
            <!-- Header Section -->
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Terminals</a></li><li aria-current="page">Edit Terminal</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2 ui-actions">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">edit</span>
                            <h2 class="modern-headline-md ui-section-title">Terminal Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="flex flex-column gap-4">
                                <div>
                                    <label asp-for="TerminalNumber" class="modern-label ui-label">Terminal Number <span class="text-error">*</span></label>
                                    <input asp-for="TerminalNumber" class="form-control ui-input" placeholder="Enter 3-digit code" maxlength="3" />
                                    <span asp-validation-for="TerminalNumber" class="text-error text-xs"></span>
                                </div>

                                <div>
                                    <label asp-for="TerminalName" class="modern-label ui-label">Terminal Name <span class="text-error">*</span></label>
                                    <input asp-for="TerminalName" class="form-control ui-input" placeholder="Enter terminal name" />
                                    <span asp-validation-for="TerminalName" class="text-error text-xs"></span>
                                </div>

                                <div>
                                    <label asp-for="PortId" class="modern-label ui-label">Linked Port <span class="text-error">*</span></label>
                                    <select asp-for="PortId" asp-items="@Model.Ports" class="js-modern-select" data-placeholder="-- Select Port --">
                                        <option value="">-- Select Port --</option>
                                    </select>
                                    <span asp-validation-for="PortId" class="text-error text-xs"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input asp-for="IsIoc" class="form-check-input" type="checkbox" style="width:1.25rem; height:1.25rem; border: 1px solid var(--outline-variant);">
                                    <label asp-for="IsIoc" class="modern-label mb-0 ui-label" style="text-transform: none; font-size: 14px; font-weight: 500;">Classify as IOC?</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
