@{
    ViewData["Title"] = "Terminals";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <!-- Header Section -->
        <div class="flex-stack ui-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li aria-current="page">Terminals</li></ol></nav>
                <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2 ui-actions">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card ui-card">
            <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">corporate_fare</span>
                    <h2 class="modern-headline-md ui-section-title">Terminal List</h2>
                </div>
            </div>
            <div class="modern-card-body ui-card-body">
                <table class="modern-table ui-table" id="terminalsTable">
                    <thead>
                        <tr>
                            <th>Terminal #</th>
                            <th>Terminal Name</th>
                            <th>Port</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "Terminal", new { area = "MSAP" })';
            const deleteUrl = '@Url.Action("Delete", "Terminal", new { area = "MSAP" })';

            let table = $('#terminalsTable').DataTable(ModernTable.config({
                serverSide: false,
                ajax: ModernTable.ajax("@Url.Action("GetTerminalList", "Terminal", new { area = "MSAP" })"),
                columns: [
                    { data: "terminalNumber" },
                    {
                        data: "terminalName",
                        render: (data) => `<span class="font-bold uppercase">${data}</span>`
                    },
                    { data: "port.portName" },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Terminal', icon: 'edit', url: `${editUrl}?id=${row.terminalId}` },
                            {
                                label: 'Delete Terminal',
                                icon: 'delete',
                                isError: true,
                                onclick: `confirmDelete('${deleteUrl}?id=${row.terminalId}')`
                            }
                        ])
                    }
                ]
            }));
        });

        function confirmDelete(url) {
            ModernAlert.confirm({
                title: 'Delete Terminal?',
                text: "Are you sure you want to delete this terminal entry?",
                icon: 'warning',
                confirmText: 'Yes, Delete',
                cancelText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>
}
