@model UserAccess

<fieldset class="border border-outline-variant rounded p-3">
    <legend class="modern-label px-1">Tariff and BAF rates</legend>
    <p class="text-sm mb-3">Rate access is separate from maritime master-file access. For MSAP Users, preparing or approving updates includes viewing rates; approval must be granted separately.</p>
    <div class="flex flex-wrap gap-4">
        <label class="flex items-center gap-2 cursor-pointer"><input asp-for="CanViewRates" class="form-check-input" /><span class="text-sm">View and export rates</span></label>
        <label class="flex items-center gap-2 cursor-pointer"><input asp-for="CanManageRates" class="form-check-input" /><span class="text-sm">Prepare drafts and submit rate updates</span></label>
        <label class="flex items-center gap-2 cursor-pointer"><input asp-for="CanApproveRateUpload" class="form-check-input" /><span class="text-sm">Approve and activate rate updates</span></label>
    </div>
    <p class="text-sm mt-3">Prepare access allows editing, submitting and refreshing the user's own drafts. Admin and SuperAdmin can perform all rate actions, including approval. Assign these permissions to other authorized MSAP Users.</p>
</fieldset>
