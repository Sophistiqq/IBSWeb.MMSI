@model UserAccess

<fieldset class="border border-outline-variant rounded p-3">
    <legend class="modern-label px-1">Schedule and billing approvals</legend>
    <p class="text-sm mb-3">Assign to authorized approvers. Admin and SuperAdmin retain schedule / COS and final billing approval access.</p>
    <div class="flex flex-wrap gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
            <input asp-for="CanApproveSchedule" class="form-check-input" />
            <span class="text-sm">Approve schedule / COS</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
            <input asp-for="CanApproveFinalBilling" class="form-check-input" />
            <span class="text-sm">Approve final billing</span>
        </label>
    </div>
</fieldset>
