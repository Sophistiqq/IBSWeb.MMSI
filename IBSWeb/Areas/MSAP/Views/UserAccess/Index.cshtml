@{
    ViewData["Title"] = "User Access";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <!-- Header Section -->
        <div class="flex-stack ui-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>GENERAL</li><li aria-current="page">User Access</li></ol></nav>
                <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2 ui-actions">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">security</span>
                    CREATE USER ACCESS
                </a>
            </div>
        </div>

        <p class="ui-caption ui-muted">Individual permissions for Users are shown below. Admin and SuperAdmin have all supported actions; inactive accounts cannot act. Preparing does not grant approval or banking authority.</p>

        <!-- Table Card -->
        <div class="modern-card ui-card">
            @Html.AntiForgeryToken()
            <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">admin_panel_settings</span>
                    <h2 class="modern-headline-md ui-section-title">User Access List</h2>
                </div>
            </div>
            <div class="modern-card-body ui-card-body">
                <div class="modern-table-container">
                <table class="modern-table ui-table" id="userAccessTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Schedule / COS</th>
                            <th>Tickets</th>
                            <th>Rates</th>
                            <th>Billing</th>
                            <th>Collections</th>
                            <th>Other tugs</th>
                            <th>References / reports</th>
                            <th style="text-align: right !important">Actions</th>
                        </tr>
                    </thead>
                </table>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        //  simple AJAX DataTable — no modal needed, Edit navigates to its own page
        $(document).ready(function () {
            $('#userAccessTable').DataTable(ModernTable.config({
                ajax: ModernTable.ajax('/MSAP/UserAccess/GetUserAccessList'),
                columns: [
                    { data: 'displayName', render: data => `<span class="font-bold">${escapeHtml(data ?? '')}</span>` },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canCreateCustomerOrderSlip, 'Prepare'], [row.canEditCustomerOrderSlip, 'Edit / cancel'], [row.canApproveSchedule, 'Approve']]) },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canCreateDispatchTicket, 'Record'], [row.canEditDispatchTicket, 'Edit / recalculate']]) },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canViewRates, 'View'], [row.canManageRates, 'Prepare'], [row.canApproveRateUpload, 'Approve']]) },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canCreateBilling, 'Prepare'], [row.canEditBilling, 'Edit draft'], [row.canDeleteBilling, 'Discard draft'], [row.canApproveFinalBilling, 'Approve']]) },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canCreateCollection, 'Prepare receipts'], [row.canAccessTreasury, 'Banking']]) },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canManageOtherTugCharges, 'Prepare'], [row.canConfirmOtherTugCharges, 'Confirm']]) },
                    { data: null, orderable: false, render: (data, type, row) => permissionSummary([[row.canManageMaritimeMasterFile, 'Maintain'], [row.canViewMaritimeReport, 'Reports']]) },
                    {
                        data: null,
                        orderable: false,
                        render: function (data) {
                            return `<div style="display:flex;justify-content:flex-end">${ModernTable.render.dropdown([
                                { label: 'Edit Access', icon: 'edit', onclick: `window.location='/MSAP/UserAccess/Edit/${data.id}'` }
                            ])}</div>`;
                        }
                    }
                ],
                order: [[0, 'asc']]
            }));
        });

        function permissionSummary(flags) {
            return flags.filter(([allowed]) => allowed).map(([, label]) => label).join(' · ') || '—';
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }
    </script>
}
