@{
    ViewData["Title"] = "Bank Account Master File";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <div class="flex-stack ui-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li aria-current="page">Bank Accounts</li></ol></nav>
                <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2 ui-actions">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <div class="modern-card ui-card">
            <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">account_balance</span>
                    <h2 class="modern-headline-md ui-section-title">Bank Account List</h2>
                </div>
            </div>
            <div class="modern-card-body ui-card-body">
                <table class="modern-table ui-table" id="bankAccountTable">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Bank</th>
                            <th>Branch</th>
                            <th>Account No</th>
                            <th>Account Name</th>
                            <th>Company</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "BankAccount", new { area = "MSAP" })';

            let table = $('#bankAccountTable').DataTable(ModernTable.config({
                serverSide: false,
                ajax: {
                    url: "@Url.Action("GetAll", "BankAccount", new { area = "MSAP" })",
                    type: "GET",
                    data: function(d) { return d; },
                },
                columns: [
                    { data: "bankAccountCode" },
                    { data: "bank" },
                    { data: "branch", defaultContent: "-" },
                    { data: "accountNo" },
                    { data: "accountName" },
                    { data: "company" },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Bank Account', icon: 'edit', url: `${editUrl}?id=${row.bankAccountId}` }
                        ])
                    }
                ]
            }));
        });
    </script>
}
