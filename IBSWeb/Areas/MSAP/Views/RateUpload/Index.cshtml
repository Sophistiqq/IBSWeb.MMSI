@model List<RateUpload>
@{
    ViewData["Title"] = "Rate updates";
    ViewData["IsFullWidth"] = true;
}
<link rel="stylesheet" href="~/msap/css/rate-maintenance.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<div class="modern-layout">
    <main class="app-ui rate-workspace ui-stack">
        <header class="ui-page-header">
            <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li><a asp-controller="Home" asp-action="Index">MSAP</a></li><li aria-current="page">Rate updates</li></ol></nav>
            <h1 class="ui-page-title" data-page-header>Rate updates</h1>
            <div class="rate-upload-actions ui-page-action">
                <a asp-controller="TariffRate" asp-action="Export" asp-route-kind="@RateTableKind.Tariff" class="modern-btn-secondary">Export active Tariff (.xlsx)</a>
                <a asp-controller="TariffRate" asp-action="Export" asp-route-kind="@RateTableKind.BAF" class="modern-btn-secondary">Export active BAF (.xlsx)</a>
                @if (ViewData["CanUpload"] is true) { <a asp-action="Editor" class="modern-btn-primary">Open rate editor</a> }
            </div>
            <p class="ui-page-description ui-caption ui-muted">Edit tariff and BAF rates separately, then compare and submit selected changes. Saving for review leaves live rates unchanged.</p>
        </header>
        @if (ViewData["CanUpload"] is true)
        {
            <section class="ui-panel ui-stack" aria-label="Stage audited Excel workbook">
                <div class="rate-upload-heading">
                    <div>
                        <h2 class="ui-section-title">Stage audited Excel workbook</h2>
                        <p class="ui-caption ui-muted mb-0">Upload a reviewed .xlsx export (amounts enforced to 2 decimal places). Live rates stay unchanged until compared and approved.</p>
                    </div>
                </div>
                <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem;">
                    @Html.AntiForgeryToken()
                    <div class="ui-field" style="min-width: 150px; margin-bottom: 0;">
                        <label for="importKind" class="ui-label">Rate table</label>
                        <select id="importKind" name="kind" class="js-modern-select">
                            <option value="@RateTableKind.Tariff">Tariff</option>
                            <option value="@RateTableKind.BAF">BAF</option>
                        </select>
                    </div>
                    <div class="ui-field" style="min-width: 260px; flex: 1; margin-bottom: 0;">
                        <label for="importFile" class="ui-label">Excel file (.xlsx)</label>
                        <input id="importFile" name="file" type="file" accept=".xlsx" class="modern-input" style="height: 40px; padding: 0.35rem 0.75rem;" required />
                    </div>
                    <button type="submit" class="modern-btn-primary" style="height: 40px; align-self: flex-end; white-space: nowrap;">Stage &amp; compare</button>
                </form>
            </section>
        }
        <section class="ui-panel ui-stack">
            <div class="rate-upload-heading"><h2 class="ui-section-title">@(ViewData["AwaitingReview"] is true ? "Awaiting review" : "Recent submissions")</h2><a asp-action="Editor" class="modern-btn-secondary">View rates and exports</a></div>
            <div class="rate-table-scroll">
                <table class="modern-table ui-table">
                    <thead><tr><th>Prepared</th><th>Table</th><th>Prepared by</th><th>Rows</th><th>New / changed</th><th>Status</th><th>Action</th></tr></thead>
                    <tbody>
                    @foreach (var upload in Model)
                    {
                        <tr class="@(upload.SubmittedAt.HasValue && !upload.ApprovedAt.HasValue ? "ui-attention" : "")"><td>@upload.UploadedAt.ToString("dd MMM yyyy, HH:mm")</td><td>@upload.RateKind</td><td>@upload.UploadedBy</td><td>@upload.TotalRows</td><td>@upload.ChangedRows</td><td>@upload.Status</td><td><a asp-action="Details" asp-route-id="@upload.RateUploadId" class="modern-btn-secondary">Compare rates</a></td></tr>
                    }
                    @if (Model.Count == 0) { <tr><td colspan="7">No rate updates have been prepared.</td></tr> }
                    </tbody>
                </table>
            </div>
            @{
                var currentPage = ViewData["Page"] is int p ? p : 1;
                var totalPages = ViewData["TotalPages"] is int tp ? tp : 1;
                var totalCount = ViewData["TotalCount"] is int tc ? tc : Model.Count;
                var awaiting = ViewData["AwaitingReview"] is true;
            }
            <div class="rate-upload-heading">
                <p class="ui-caption ui-muted">Page @currentPage of @totalPages (@totalCount total) · Philippine time</p>
                <div class="flex flex-wrap items-center gap-2">
                    @if (totalPages > 1)
                    {
                        <nav class="rate-list-filters" aria-label="Pagination">
                            @if (currentPage > 1)
                            {
                                <a asp-action="Index" asp-route-awaitingReview="@awaiting" asp-route-page="@(currentPage - 1)" class="modern-btn-secondary">Previous 10</a>
                            }
                            @if (currentPage < totalPages)
                            {
                                <a asp-action="Index" asp-route-awaitingReview="@awaiting" asp-route-page="@(currentPage + 1)" class="modern-btn-secondary">Older 10</a>
                            }
                        </nav>
                    }
                    <nav class="rate-list-filters" aria-label="Filter rate updates"><a asp-action="Index" class="modern-btn-secondary" aria-current="@(!awaiting ? "page" : null)">All updates</a><a asp-action="Index" asp-route-awaitingReview="true" class="modern-btn-secondary" aria-current="@(awaiting ? "page" : null)">Awaiting review</a></nav>
                </div>
            </div>
        </section>
    </main>
</div>
