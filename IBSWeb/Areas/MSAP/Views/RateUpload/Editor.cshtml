@model RateEditorViewModel
@{
    var isCombined = string.Equals(Model.Mode, "combined", StringComparison.OrdinalIgnoreCase);
    var hasPendingBookingRates = Model.ScheduleId.HasValue && Model.CombinedRows.Any(r => r.SourceScheduleId == Model.ScheduleId && (r.IsPendingTariff || r.IsPendingBaf));
    ViewData["Title"] = isCombined ? "Combined Basic & BAF rate editor" : $"{Model.Kind} rate editor";
    ViewData["IsFullWidth"] = true;
    var canEdit = ViewData["CanEditRates"] is true;
    var canApprove = ViewData["CanApproveRates"] is true;
}
<link rel="stylesheet" href="~/msap/css/workflow-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/msap/css/rate-maintenance.css" asp-append-version="true" />
<div class="modern-layout">
    <main class="app-ui rate-workspace ui-stack" id="rateEditor"
          data-mode="@Model.Mode"
          data-save-url="@Url.Action("SaveDraft")"
          data-preview-url="@Url.Action("PreviewBatch")"
          data-batch-save-url="@Url.Action("SaveBatch")"
          data-return-url="@Model.ReturnUrl"
          data-can-edit="@canEdit.ToString().ToLowerInvariant()"
          data-can-approve="@canApprove.ToString().ToLowerInvariant()">
        <header class="ui-page-header">
            <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li><a asp-controller="Home" asp-action="Index">MSAP</a></li><li><a asp-action="Index">Rate updates</a></li><li aria-current="page">Rate editor</li></ol></nav>
            <h1 class="ui-page-title" data-page-header>@(isCombined ? "Basic & BAF rates" : $"{Model.Kind} rates")</h1>
            <div class="rate-upload-actions ui-page-action">
                @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl" class="modern-btn-secondary">Back to Booking #@Model.ScheduleId</a>
                }
                <a asp-action="Index" class="modern-btn-secondary">Rate updates / approvals</a>
            </div>
            <p class="ui-page-description ui-caption ui-muted">
                @(isCombined
                    ? "Manage Basic (Tariff) and weekly BAF rates side-by-side without switching tabs."
                    : Model.Kind == RateTableKind.BAF
                        ? "Enter the final calculated BAF amount. Charging follows the approved COS method."
                        : "Maintain base service charges independently of BAF.")
                @(canEdit ? " Drafts and review submissions leave live rates unchanged until approved." : " View and export access only.")
            </p>
        </header>

        @if (Model.ScheduleId.HasValue)
        {
            <section class="ui-panel @(hasPendingBookingRates ? "ui-attention" : "") rate-schedule-banner" aria-label="Schedule context">
                <div>
                    <strong>@Model.ScheduleLabel</strong>
                    <span class="ui-caption ui-muted">
                        @(hasPendingBookingRates
                            ? " · Missing or unestablished service rates for this booking are shown at the top."
                            : " · All service rates for this booking already match the rate tables. Showing existing rates if corrections are needed.")
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl" class="modern-btn-secondary">Return to schedule</a>
                }
            </section>
        }

        @if (!Model.Id.HasValue)
        {
            <nav class="rate-list-filters" aria-label="Rate table">
                <a asp-action="Editor" asp-route-mode="combined" asp-route-asOfDate="@Model.AsOfDate.ToString("yyyy-MM-dd")" asp-route-scheduleId="@Model.ScheduleId" asp-route-customerId="@Model.SelectedCustomerId" asp-route-portId="@Model.SelectedPortId" asp-route-terminalId="@Model.SelectedTerminalId" asp-route-serviceId="@Model.SelectedServiceId" asp-route-returnUrl="@Model.ReturnUrl" class="modern-btn-secondary" aria-current="@(isCombined ? "page" : null)">Combined (Basic &amp; BAF)</a>
                <a asp-action="Editor" asp-route-kind="Tariff" asp-route-mode="single" asp-route-asOfDate="@Model.AsOfDate.ToString("yyyy-MM-dd")" asp-route-scheduleId="@Model.ScheduleId" asp-route-customerId="@Model.SelectedCustomerId" asp-route-portId="@Model.SelectedPortId" asp-route-terminalId="@Model.SelectedTerminalId" asp-route-serviceId="@Model.SelectedServiceId" asp-route-amount="@Model.InitialAmount" asp-route-returnUrl="@Model.ReturnUrl" class="modern-btn-secondary" aria-current="@(!isCombined && Model.Kind == RateTableKind.Tariff ? "page" : null)">Tariff rates</a>
                <a asp-action="Editor" asp-route-kind="BAF" asp-route-mode="single" asp-route-asOfDate="@Model.AsOfDate.ToString("yyyy-MM-dd")" asp-route-scheduleId="@Model.ScheduleId" asp-route-customerId="@Model.SelectedCustomerId" asp-route-portId="@Model.SelectedPortId" asp-route-terminalId="@Model.SelectedTerminalId" asp-route-serviceId="@Model.SelectedServiceId" asp-route-amount="@Model.InitialAmount" asp-route-returnUrl="@Model.ReturnUrl" class="modern-btn-secondary" aria-current="@(!isCombined && Model.Kind == RateTableKind.BAF ? "page" : null)">BAF rates</a>
            </nav>
        }

        @if (isCombined || Model.Kind == RateTableKind.BAF)
        {
            <p class="ui-caption ui-muted">BAF coverage runs Tuesday through Monday by actual service date. Add and approve a dated entry for each applicable service week, even if the amount stays the same (0 is valid for Zero BAF).</p>
        }

        <section class="ui-panel ui-stack">
            <div class="rate-editor-filters">
                <div class="ui-field"><label class="ui-label" for="rateCustomer">Customer</label><select id="rateCustomer" class="js-modern-select"><option value="">All customers</option>@foreach (var item in Model.Customers) { <option value="@item.Id" selected="@(item.Id == Model.SelectedCustomerId)">@item.Code - @item.Name</option> }</select></div>
                <div class="ui-field"><label class="ui-label" for="ratePort">Port</label><select id="ratePort" class="js-modern-select"><option value="">All ports</option>@foreach (var item in Model.Ports) { <option value="@item.Id" selected="@(item.Id == Model.SelectedPortId)">@item.Name</option> }</select></div>
                <div class="ui-field"><label class="ui-label" for="rateTerminal">Terminal</label><select id="rateTerminal" class="js-modern-select"><option value="">All terminals</option>@foreach (var item in Model.Terminals) { <option value="@item.Id" data-port="@item.PortId" selected="@(item.Id == Model.SelectedTerminalId)">@item.Name</option> }</select></div>
                <div class="ui-field"><label class="ui-label" for="rateService">Service</label><select id="rateService" class="js-modern-select"><option value="">All services</option>@foreach (var item in Model.Services) { <option value="@item.Id" selected="@(item.Id == Model.SelectedServiceId)">@item.Name</option> }</select></div>
                <div class="ui-field"><label class="ui-label" for="rateSearch">Search</label><input id="rateSearch" type="search" class="modern-input" placeholder="Customer / location / service" /></div>
            </div>
            <div class="rate-upload-heading">
                <div class="rate-list-filters">
                    <label class="ui-caption"><input id="rateChangedOnly" type="checkbox" /> Show changed rows only</label>
                    @if (isCombined)
                    {
                        <label class="ui-caption"><input id="ratePendingOnly" type="checkbox" checked="@hasPendingBookingRates" /> Missing / pending rates only</label>
                    }
                </div>
                @if (canEdit) { <button id="rateAdd" type="button" class="modern-btn-secondary">+ Add rate for selected combination</button> }
            </div>
            @if (canEdit)
            {
                <p class="ui-caption ui-muted">Select a customer, port, terminal and service to add a new combination. Existing references are locked. For a new weekly BAF rate, use a Tuesday effective date; retain the date only when correcting that dated rate.</p>
            }
        </section>

        <section class="ui-panel ui-stack">
            <div class="rate-upload-heading">
                <h2 class="ui-section-title">@(Model.Id.HasValue ? "Saved draft" : isCombined ? $"Combined rates effective on {Model.AsOfDate:dd MMM yyyy}" : $"Rates effective on {Model.AsOfDate:dd MMM yyyy}")</h2>
                <span id="rateCounts" class="ui-caption" aria-live="polite"></span>
            </div>
            @if (canEdit && !isCombined)
            {
                <p class="ui-caption ui-muted">Tab moves between cells; Enter moves down. Paste amounts or two columns (ISO date + amount) from Excel into existing rows. Yellow marks edits; blue marks new dated entries. Blank is missing; 0 is valid.</p>
            }
            <div id="rateEditorError" class="rate-editor-error ui-caption" role="alert" hidden></div>
            <div class="rate-table-scroll rate-editor-scroll">
                <table class="modern-table rate-editor-table @(isCombined ? "rate-editor-combined-table" : "") ui-table">
                    <caption class="visually-hidden">Editable effective dates and rate amounts. Reference columns are read only.</caption>
                    @if (isCombined)
                    {
                        <thead>
                            <tr>
                                <th scope="col">Customer</th>
                                <th scope="col">Port / terminal</th>
                                <th scope="col">Service</th>
                                <th scope="col">Basic (Tariff ₱)</th>
                                <th scope="col">BAF (Tuesday ₱)</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                    }
                    else
                    {
                        <thead>
                            <tr>
                                <th scope="col">Customer</th>
                                <th scope="col">Port / terminal</th>
                                <th scope="col">Service</th>
                                <th scope="col">Previous date / amount</th>
                                <th scope="col">Effective date</th>
                                <th scope="col">@Model.Kind amount</th>
                                <th scope="col">Change</th>
                            </tr>
                        </thead>
                    }
                    <tbody id="rateEditorRows"></tbody>
                </table>
            </div>
            <div class="rate-upload-heading">
                <div class="rate-list-filters" id="ratePagination" hidden>
                    <button type="button" id="ratePrevPage" class="modern-btn-secondary">Previous</button>
                    <span id="ratePageLabel" class="ui-caption ui-muted"></span>
                    <button type="button" id="rateNextPage" class="modern-btn-secondary">Next</button>
                </div>
                <div class="rate-upload-actions">
                    @Html.AntiForgeryToken()
                    @if (canEdit)
                    {
                        <button id="rateSave" type="button" class="modern-btn-secondary">Save draft</button>
                        @if (canApprove)
                        {
                            <button id="rateApprove" type="button" class="modern-btn-primary">
                                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Save &amp; approve
                            </button>
                        }
                        else
                        {
                            <button id="rateSubmit" type="button" class="modern-btn-primary">Submit for approval</button>
                        }
                    }
                </div>
            </div>
        </section>

        <section class="rate-exports" aria-label="Export rates">
            <form asp-controller="RateUpload" asp-action="Editor" method="get" class="ui-panel ui-stack">
                <input type="hidden" name="kind" value="@Model.Kind" />
                <input type="hidden" name="mode" value="@Model.Mode" />
                <h2 class="ui-section-title">Load / export current @Model.Kind rates</h2>
                <div class="rate-export-fields"><div class="ui-field"><label class="ui-label" for="asOfDate">As of date</label><input id="asOfDate" name="asOfDate" type="date" class="modern-input" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" required /></div><button type="submit" class="modern-btn-secondary">Load rates</button><button type="submit" formaction="@Url.Action("Export", "TariffRate")" data-export class="modern-btn-secondary">Export current</button></div>
            </form>
            <form asp-controller="TariffRate" asp-action="Export" method="get" class="ui-panel ui-stack" data-download>
                <input type="hidden" name="kind" value="@Model.Kind" /><input type="hidden" name="history" value="true" />
                <h2 class="ui-section-title">Export @Model.Kind history</h2>
                <div class="rate-export-fields"><div class="ui-field"><label class="ui-label" for="dateFrom">Effective from</label><input id="dateFrom" name="dateFrom" type="date" class="modern-input" min="1900-01-01" max="9998-12-31" required /></div><div class="ui-field"><label class="ui-label" for="dateTo">Effective through</label><input id="dateTo" name="dateTo" type="date" class="modern-input" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" required /></div><button type="submit" class="modern-btn-secondary" data-export>Export history</button></div>
            </form>
        </section>
    </main>
</div>
<script type="application/json" id="rateEditorData">@Json.Serialize(Model)</script>
@section Scripts {
    <script src="~/msap/js/rate-editor.js" asp-append-version="true"></script>
}
