@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <script>
        (function () {
            var t = localStorage.getItem('msap_theme');
            if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maintenance Page</title>
    <link rel="stylesheet" href="~/msap/css/modern-ui.css" asp-append-version="true" />
</head>
<body class="msap-maintenance-page">
    <main class="msap-maintenance-card">
        <div class="msap-maintenance-icon" aria-hidden="true">🛠️</div>
        <h1 class="msap-maintenance-title">We'll be back soon!</h1>
        <p class="msap-maintenance-text">Our website is currently undergoing scheduled maintenance. We're working hard to improve your experience. Please check back later.</p>
        <div class="msap-maintenance-cta">
            <p class="msap-maintenance-text">In the meantime, feel free to <a href="viber://chat?number=+639516396666">contact us on Viber</a> for assistance.</p>
        </div>
    </main>
</body>
</html>
