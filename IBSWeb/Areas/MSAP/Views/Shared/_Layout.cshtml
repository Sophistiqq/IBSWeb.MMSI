@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var selectedCompany = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value;
    }

    var userName = UserManager.GetUserName(User);

    ViewBag.AppVersion = "0.1.233";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
<script>
    (function() {
        var t = localStorage.getItem('msap_theme');
        if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
        document.documentElement.setAttribute('data-bs-theme', t);
    })();
</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IBS</title>
    <link id="favicon-light" href="/msap/svg/ibs-icon-black.svg" rel="shortcut icon" type="image/svg+xml" />
    <link id="favicon-dark" href="/msap/svg/ibs-icon-white.svg" rel="shortcut icon" type="image/svg+xml" />
    <link rel="stylesheet" href="~/msap/lib/bootstrap/dist/css/bootstrap.css">
    <link rel="stylesheet" href="~/IBSWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> <!--Select2 plug ins-->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.1/css/dataTables.dataTables.css" /> <!--Data tables plug ins-->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.1.0/css/buttons.dataTables.min.css"> <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.css" /><!--Data table pug-in-->
    <link rel="stylesheet" href="~/msap/css/site.css" asp-append-version="true" />

    <!-- Modern Redesign Dependencies -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Hanken+Grotesk:wght@600;700;800&display=block" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet" />
    <link rel="stylesheet" href="~/msap/css/modern-ui.css" asp-append-version="true" />
    <!-- Modern navbar -->
    <link rel="stylesheet" href="~/msap/css/modern-navbar.css" asp-append-version="true" />

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
    </style>

    @if (SignInManager.IsSignedIn(User))
    {
        <link class="qa-sidebar-style" rel="stylesheet" href="~/msap/css/quick-access-sidebar.css" asp-append-version="true" />
        <script src="~/msap/js/quick-access-sidebar.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-selected-company="@selectedCompany">
    <script>
        (function () {
            document.body.classList.add('mnav-enabled');
        })();
    </script>
    <partial name="_Navbar" />
    <div class="@(ViewData["IsFullWidth"] is true ? "container-fluid p-0" : "container") main-content-wrapper">
        <main role="main">
            <input type="hidden" id="hfUsername" value="@userName" />
            @RenderBody()
        </main>
    </div>

    <footer b-q5eydxz0xc class="border-top footer bg-primary text-light">
        <div class="container text-center">
            &copy; 2026 - MMSI <i class="bi bi-r-circle"></i> &middot; @($"v{ViewBag.AppVersion}")
        </div>
    </footer>

    <script src="~/msap/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/msap/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/msap/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/msap/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/msap/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script><!--select 2 scripts-->
    <script src="https://cdn.datatables.net/2.0.1/js/dataTables.js"></script><!--data tables scripts-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><!--sweet alert scripts-->
    <script src="~/msap/js/modern-alert.js" asp-append-version="true"></script>
    <script src="~/msap/js/spinner.js" asp-append-version="true"></script>
    <script src="~/msap/js/modern-select.js" asp-append-version="true"></script>
    <script src="~/msap/js/collection-banking.js" asp-append-version="true"></script>
    <script src="~/msap/js/modern-form-validator.js" asp-append-version="true"></script>
    <script src="~/msap/js/modern-table.js" asp-append-version="true"></script>
    <script src="~/msap/js/modern-hotkeys.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/select/3.1.3/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/3.1.3/js/select.dataTables.js"></script>
    <!-- Modern navbar controller -->
    <script src="~/msap/js/modern-navbar.js" asp-append-version="true"></script>
    <!-- Guided tour overlay -->
    <script src="~/msap/js/tutorial.js" asp-append-version="true"></script>

    <!-- TempData flash messages -->
    <partial name="_Notification" />

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function() {
            var html = document.documentElement;
            var favLight = document.getElementById('favicon-light');
            var favDark = document.getElementById('favicon-dark');

            function syncIcons(theme) {
                var icons = document.querySelectorAll('[id$="theme-icon"]');
                icons.forEach(function(el) {
                    el.textContent = theme === 'dark' ? 'light_mode' : 'dark_mode';
                });
            }

            function setTheme(theme) {
                html.setAttribute('data-bs-theme', theme);
                localStorage.setItem('msap_theme', theme);
                syncIcons(theme);
                if (theme === 'dark') {
                    if (favDark) favDark.rel = 'shortcut icon';
                    if (favLight) favLight.rel = '';
                } else {
                    if (favDark) favDark.rel = '';
                    if (favLight) favLight.rel = 'shortcut icon';
                }
            }

            function toggleTheme() {
                var next = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                setTheme(next);
            }

            document.querySelectorAll('[id$="theme-toggle"]').forEach(function(btn) {
                btn.addEventListener('click', toggleTheme);
            });

            setTheme(html.getAttribute('data-bs-theme'));

            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            mq.addEventListener('change', function(e) {
                if (!localStorage.getItem('msap_theme')) {
                    setTheme(e.matches ? 'dark' : 'light');
                }
            });
        })();
    </script>
</body>
</html>
