@inject IBS.Services.MSAP.AccessControl.IAccessControlService AccessControl
@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
@if (User.Identity?.IsAuthenticated == true && userId != null
    && await AccessControl.HasAccessAsync(userId, IBS.Models.MSAP.Enums.ProcedureEnum.AccessMsap))
{
    <li class="mnav-item" role="none">
        <a class="mnav-trigger" asp-area="MSAP" asp-controller="Home" asp-action="Index" role="menuitem">
            <span class="material-symbols-outlined" aria-hidden="true">directions_boat</span>
            <span>MSAP</span>
        </a>
    </li>
}
