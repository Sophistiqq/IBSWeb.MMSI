@using System.Security.Claims
@using IBS.Services.MSAP.AccessControl
@inject IAccessControlService AccessControl
@model JobProgressViewModel
@{
    (int Stage, string Label)[] stages =
    {
        (0, "Planning"), (1, "COS approval"), (2, "Service tickets"),
        (JobProgressCalculator.BillingStage, "Billing"), (JobProgressCalculator.PostingStage, "Final bill approval"),
        (JobProgressCalculator.CollectionStage, "Collection"), (JobProgressCalculator.DepositStage, "Deposit"),
        (JobProgressCalculator.ClearingStage, "Clearing"), (JobProgressCalculator.CompletedStage, "Fully cleared")
    };
    var currentStage = Model.Stage is JobProgressCalculator.TariffStage or JobProgressCalculator.ApprovalStage ? 2 : Model.Stage;
    if (Model.Stage == JobProgressCalculator.DepositStage && Model.BankingCollection?.ReturnedDate.HasValue == true)
    {
        stages[6] = (JobProgressCalculator.DepositStage, "Redeposit");
    }
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    bool canAct = !Model.Stopped && Model.Permission.HasValue && userId != null
        && await AccessControl.HasAccessAsync(userId, Model.Permission.Value);
    bool actionHere = ViewData["JobProgressActionStage"] is int stage && stage == Model.Stage
        && (ViewData["JobProgressActionTargetId"] is not int targetId || targetId == Model.TargetId);
    bool canViewBilling = userId != null && await AccessControl.HasAccessAsync(userId, ProcedureEnum.ViewBillings);
    bool canViewCos = userId != null && await AccessControl.HasAccessAsync(userId, ProcedureEnum.ViewOperations);
    var reviewBill = Model.LinkedBillings.FirstOrDefault(b => b.Status == MsapConstants.BillingStatus.ForPosting) ?? Model.LinkedBillings.FirstOrDefault();
    var actionUrl = !canAct ? null : Url.Action(Model.ActionName, Model.ActionController, new
    {
        area = "MSAP",
        id = Model.TargetId,
        customerOrderSlipId = Model.CustomerOrderSlipId
    });
}
<link rel="stylesheet" href="~/msap/css/job-progress.css" asp-append-version="true" />
<section class="modern-card job-progress" aria-label="Job Progress">
    <div class="job-progress-heading">
        <h2 class="modern-headline-md">Job Progress</h2>
        <span class="modern-badge-sm @(Model.CalculationBlockers.Count > 0 ? "ui-status ui-critical" : Model.Stopped && !Model.IsCancelled && !Model.IsInvalidated ? "ui-status ui-attention" : "")">@(Model.IsCancelled ? "Cancelled" : Model.IsInvalidated ? "Invalidated" : Model.Stopped ? "Needs attention" : stages.First(s => s.Stage == currentStage).Label)</span>
    </div>
    <ol class="job-progress-timeline" aria-label="Job stages">
        @for (int index = 0; index < stages.Length; index++)
        {
            var step = stages[index];
            bool bypassed = !Model.HasSchedule && step.Stage < 2;
            bool done = !bypassed && step.Stage < currentStage;
            string label = done ? step.Stage switch
            {
                0 => "Planned",
                1 => "COS approved",
                2 => "Tickets recorded",
                JobProgressCalculator.BillingStage => "Billing prepared",
                JobProgressCalculator.PostingStage => "Final bill approved",
                _ => step.Label
            } : step.Label;
            string? stepUrl = null;
            if (!bypassed && userId != null)
            {
                if (step.Stage is 0 or 1 && canViewCos && Model.VesselScheduleId.HasValue)
                {
                    stepUrl = Url.Action("Details", "VesselSchedule", new { area = "MSAP", id = Model.VesselScheduleId });
                }
                else if (step.Stage == 2 && canViewCos && Model.CustomerOrderSlipId.HasValue)
                {
                    stepUrl = Url.Action("Details", "CustomerOrderSlip", new { area = "MSAP", id = Model.CustomerOrderSlipId });
                }
                else if (step.Stage == JobProgressCalculator.BillingStage && canViewBilling)
                {
                    if (reviewBill != null)
                    {
                        stepUrl = Url.Action("Review", "Billing", new { area = "MSAP", id = reviewBill.MsapBillingId });
                    }
                    else if (!Model.Stopped && currentStage == JobProgressCalculator.BillingStage && canAct)
                    {
                        stepUrl = actionUrl;
                    }
                }
                else if (step.Stage == JobProgressCalculator.PostingStage && canViewBilling && reviewBill != null)
                {
                    stepUrl = Url.Action("Review", "Billing", new { area = "MSAP", id = reviewBill.MsapBillingId });
                }
            }
            <li class="@(bypassed ? "is-bypassed" : done ? "is-done" : step.Stage == currentStage && !Model.Stopped ? "is-current" : "")" aria-current="@(step.Stage == currentStage && !Model.Stopped ? "step" : null)">
                <span class="job-progress-dot" aria-hidden="true">@(bypassed ? "—" : done ? "✓" : (index + 1).ToString())</span>
                <span class="job-progress-stage-content">
                    @if (stepUrl != null)
                    {
                        <a href="@stepUrl" class="job-progress-stage-link">@label</a>
                    }
                    else
                    {
                        <span>@label</span>
                    }
                    @if (step.Stage == 1 && Model.CustomerOrderSlipNumber != null)
                    {
                        <small class="job-progress-detail">@Model.CustomerOrderSlipNumber</small>
                    }
                    @if (step.Stage == 2 && Model.CustomerOrderSlipId.HasValue)
                    {
                        <small class="job-progress-detail">@(Model.ExpectedTicketCount > 0 ? $"{Model.RecordedTicketCount} / {Model.ExpectedTicketCount} recorded" : $"{Model.RecordedTicketCount} recorded")</small>
                    }
                    @if (step.Stage == JobProgressCalculator.PostingStage)
                    {
                        @foreach (var bill in Model.LinkedBillings)
                        {
                            string billStatus = bill.Status switch
                            {
                                MsapConstants.BillingStatus.ForPosting => "Awaiting approval",
                                MsapConstants.BillingStatus.ForCollection or MsapConstants.BillingStatus.Collected => "Approved",
                                _ => bill.Status
                            };
                            string billType = bill.BasicBillingId.HasValue ? "BAF" : bill.BafBilling != null ? "Basic" : "Combined";
                            <small class="job-progress-detail">
                                @if (canViewBilling)
                                {
                                    <a asp-area="MSAP" asp-controller="Billing" asp-action="Review" asp-route-id="@bill.MsapBillingId">@billType #@bill.MsapBillingNumber</a>
                                }
                                else
                                {
                                    <span>@billType #@bill.MsapBillingNumber</span>
                                }
                                <span> · @billStatus</span>
                            </small>
                        }
                    }
                </span>
                @if (bypassed)
                {
                    <span class="visually-hidden">Skipped for direct COS</span>
                }
            </li>
        }
    </ol>
    <div class="job-progress-next @(Model.CalculationBlockers.Count > 0 ? "ui-critical" : Model.Stopped && !Model.IsCancelled && !Model.IsInvalidated ? "ui-attention" : "")">
        <div>
            <span class="modern-label">@(Model.Stage == JobProgressCalculator.CompletedStage && !Model.Stopped ? "Completed" : "Next Action")</span>
            <p>@Model.Guidance</p>
            @if (Model.CalculationBlockers.Count > 0)
            {
                <ul class="job-progress-blockers">
                    @foreach (var blocker in Model.CalculationBlockers.Values)
                    {
                        <li>@blocker</li>
                    }
                </ul>
            }
            @if (!canAct && Model.Permission.HasValue && !Model.Stopped)
            {
                <p class="job-progress-handoff">Waiting for an authorized user to handle @Model.WaitingFor.</p>
            }
        </div>
        @if (canAct && !string.IsNullOrEmpty(Model.ActionName) && !(actionHere && Model.BankingCollection != null))
        {
            @if (Model.BankingCollection is Collection receipt)
            {
                <div class="flex flex-wrap gap-2">
                    <a asp-area="MSAP" asp-controller="Collection" asp-action="Banking" asp-route-id="@receipt.MsapCollectionId"
                       asp-route-bankingAction="@(Model.Stage == JobProgressCalculator.DepositStage ? CollectionBankingAction.Deposit : CollectionBankingAction.Clear)"
                       data-collection-banking="@Model.ActionLabel" class="modern-btn-primary">@Model.ActionLabel</a>
                    @if (Model.Stage == JobProgressCalculator.ClearingStage && receipt.CheckAmount > 0)
                    {
                        <a asp-area="MSAP" asp-controller="Collection" asp-action="Banking" asp-route-id="@receipt.MsapCollectionId"
                           asp-route-bankingAction="@CollectionBankingAction.ReturnCheck" data-collection-banking="Return Bounced Check" class="modern-btn-secondary">Return Check</a>
                    }
                </div>
            }
            else if (Model.Stage == JobProgressCalculator.TariffStage || actionHere)
            {
                <button type="button" class="modern-btn-primary" disabled title="@(actionHere ? "Use the designated action on this screen" : "Use the tariff action on the Dispatch Ticket row")">@Model.ActionLabel</button>
            }
            else
            {
                <a href="@actionUrl" data-schedule-confirm="@(Model.ActionController == "VesselSchedule" && Model.ActionName == "Confirm" ? "true" : null)" class="modern-btn-primary">@Model.ActionLabel</a>
            }
        }
    </div>
</section>
