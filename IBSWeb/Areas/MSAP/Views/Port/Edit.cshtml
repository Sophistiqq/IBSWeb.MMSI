@model IBS.Models.MSAP.ViewModels.PortViewModel

@{
    ViewData["Title"] = "Edit Port";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <form asp-action="Edit" method="post" id="mainForm">
        <input type="hidden" asp-for="PortId" />
        <main class="modern-container ui-page">
            <!-- Header Section -->
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Ports</a></li><li aria-current="page">Edit Port</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
                </div>
                <div class="flex gap-2 ui-actions">
                    <button type="submit" class="modern-btn-primary">
                        <span class="material-symbols-outlined">save</span> Save Changes
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid justify-center">
                <section class="modern-col-6">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">edit</span>
                            <h2 class="modern-headline-md ui-section-title">Port Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <div class="flex flex-column gap-4">
                                <div>
                                    <label asp-for="PortNumber" class="modern-label ui-label">Port Number <span class="text-error">*</span></label>
                                    <input asp-for="PortNumber" class="form-control ui-input" placeholder="Enter 3-digit code" maxlength="3" />
                                    <span asp-validation-for="PortNumber" class="text-error text-xs"></span>
                                </div>

                                <div>
                                    <label asp-for="PortName" class="modern-label ui-label">Port Name <span class="text-error">*</span></label>
                                    <input asp-for="PortName" class="form-control ui-input" placeholder="Enter port name" />
                                    <span asp-validation-for="PortName" class="text-error text-xs"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    }
