@model IEnumerable<IBS.Models.MSAP.AuditTrail>
@{
    var adjustmentLogs = ViewBag.AdjustmentLogs as IEnumerable<IBS.Models.MSAP.MsapAdjustmentLog> ?? Enumerable.Empty<IBS.Models.MSAP.MsapAdjustmentLog>();
    var usedLogIds = new HashSet<int>();
}

@if (!Model.Any())
{
    <div class="text-center py-5 opacity-50">
        <span class="material-symbols-outlined icon-size-hero">history</span>
        <p class="modern-label mt-2">No activities recorded yet.</p>
    </div>
}
else
{
    <div class="workflow-timeline">
        <div class="timeline-container">
            @foreach (var item in Model)
            {
                var docClass = getDocClass(item.DocumentType);
                <div class="timeline-item">
                    <div class="timeline-connector"></div>
                    <div class="timeline-marker @docClass.Marker">
                        <span class="material-symbols-outlined">@getIcon(item)</span>
                    </div>
                    @{
                        string mainActivity = item.Activity;
                        string? reason = null;
                        if (item.Activity.Contains("Reason:"))
                        {
                            var parts = item.Activity.Split("Reason:", 2);
                            mainActivity = parts[0].TrimEnd('.', ' ');
                            reason = parts[1].Trim();
                        }

                        var normDocType = item.DocumentType == "Dispatch Ticket" ? "DispatchTicket" : item.DocumentType;
                        var matchedLog = adjustmentLogs
                            .Where(l => !usedLogIds.Contains(l.Id)
                                && l.DocumentType == normDocType
                                && ((item.RecordId.HasValue && l.RecordId == item.RecordId.Value)
                                    || (!string.IsNullOrEmpty(item.ReferenceNumber) && l.ReferenceNumber == item.ReferenceNumber))
                                && Math.Abs((l.EditedDate - item.Date).TotalMinutes) <= 2)
                            .OrderBy(l => Math.Abs((l.EditedDate - item.Date).TotalSeconds))
                            .FirstOrDefault();

                        if (matchedLog != null)
                        {
                            usedLogIds.Add(matchedLog.Id);
                            if (string.IsNullOrEmpty(reason) && !string.IsNullOrEmpty(matchedLog.Reason))
                            {
                                reason = matchedLog.Reason;
                            }
                        }

                        var fieldChanges = new List<IBS.Models.MSAP.MsapFieldChange>();
                        if (matchedLog != null && !string.IsNullOrWhiteSpace(matchedLog.ChangesJson))
                        {
                            try
                            {
                                fieldChanges = System.Text.Json.JsonSerializer.Deserialize<List<IBS.Models.MSAP.MsapFieldChange>>(matchedLog.ChangesJson) ?? new();
                            }
                            catch
                            {
                                // ignore malformed JSON
                            }
                        }

                        bool isAdjustment = matchedLog != null || reason != null || item.Activity.StartsWith("Reopened") || item.Activity.StartsWith("Voided") || item.Activity.StartsWith("Reverted");
                    }
                    <div class="timeline-card @(isAdjustment ? "timeline-card--adjusted" : "")">
                        <div class="timeline-info">
                            <span class="timeline-activity">@mainActivity</span>
                            @if (!string.IsNullOrEmpty(reason))
                            {
                                <div class="timeline-reason mt-1">
                                    <strong class="timeline-reason-label">Adjustment Reason:</strong> @reason
                                </div>
                            }
                            @if (fieldChanges.Count > 0)
                            {
                                <div class="timeline-changes mt-1">
                                    @foreach (var change in fieldChanges)
                                    {
                                        <span class="timeline-change-pill">
                                            <strong>@(string.IsNullOrWhiteSpace(change.Label) ? change.Field : change.Label):</strong> @(change.Before ?? "-") &rarr; @(change.After ?? "-")
                                        </span>
                                    }
                                </div>
                            }
                            <div class="timeline-meta mt-1">
                                <span class="modern-badge-sm @docClass.Badge">@item.DocumentType</span>
                                @if (isAdjustment)
                                {
                                    <span class="schedule-status-pill ui-status ui-attention timeline-adjusted-pill">Adjusted</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ReferenceNumber))
                                {
                                    <span class="modern-label timeline-ref-label">REF: #@item.ReferenceNumber</span>
                                }
                            </div>
                        </div>
                        <div class="timeline-time-user">
                            <time class="timeline-timestamp">@item.Date.ToString("MMM dd, HH:mm")</time>
                            <span class="timeline-username">
                                <span class="material-symbols-outlined msap-icon-xs">person</span>
                                @(string.IsNullOrWhiteSpace(item.ActorName) ? "Name unavailable" : item.ActorName)
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@functions {
    public class DocClasses {
        public string Marker { get; set; } = string.Empty;
        public string Badge { get; set; } = string.Empty;
    }

    DocClasses getDocClass(string docType) => docType switch {
        "COS" => new DocClasses { Marker = "marker-jo", Badge = "badge-jo" },
        "Dispatch Ticket" => new DocClasses { Marker = "marker-dt", Badge = "badge-dt" },
        "Tariff" => new DocClasses { Marker = "marker-tariff", Badge = "badge-tariff" },
        "Billing" => new DocClasses { Marker = "marker-billing", Badge = "badge-billing" },
        "Collection" => new DocClasses { Marker = "marker-collection", Badge = "badge-collection" },
        _ => new DocClasses { Marker = "", Badge = "" }
    };

    string getIcon(IBS.Models.MSAP.AuditTrail item) {
        var activity = item.Activity.ToLower();

        if (activity.StartsWith("created") || activity.StartsWith("create")) return "add";
        if (activity.Contains("approved") && !activity.Contains("disapproved")) return "check_circle";
        if (activity.Contains("disapproved")) return "cancel";
        if (activity.Contains("edited") || activity.Contains("update") || activity.Contains("edit")) return "edit_square";
        if (activity.Contains("closed")) return "task_alt";
        if (activity.Contains("posted")) return "send";

        return item.DocumentType switch {
            "COS" => "assignment",
            "Dispatch Ticket" => "local_shipping",
            "Tariff" => "payments",
            "Billing" => "receipt_long",
            "Collection" => "account_balance_wallet",
            _ => "history"
        };
    }
}
