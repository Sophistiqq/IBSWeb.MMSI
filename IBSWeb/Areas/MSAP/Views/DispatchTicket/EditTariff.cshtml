@model TariffViewModel

@{
    ViewData["Title"] = "Dispatch Ticket - Edit Tariff";
    ViewData["IsFullWidth"] = true;
    var filterType = ViewBag.FilterType as string;
}

<div class="modern-layout app-ui">
    <form id="myForm" method="post" asp-action="EditTariff" asp-controller="DispatchTicket" asp-area="MSAP">
        <input type="hidden" name="filterType" value="@filterType" />
        <input type="hidden" asp-for="DispatchNumber">
        <input asp-for="DispatchTicketId" id="DispatchTicketId" type="hidden" />
        <input asp-for="CustomerOrderSlipId" type="hidden" />
        <input asp-for="CustomerId" id="CustomerId" type="hidden" />

        <main class="modern-container ui-page">
            <!-- Header -->
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Dispatch Tickets</a></li><li>@Model.DispatchNumber</li><li aria-current="page">Edit Tariff</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title" data-page-header>Edit Tariff: @Model.DispatchNumber</h1>
                </div>
                <div class="flex gap-2 ui-actions" data-tour-step="9">
                    <button type="submit" class="modern-btn-primary" id="submitButton">
                        <span class="material-symbols-outlined">save</span> UPDATE TARIFF
                    </button>
                    @if (Model.CustomerOrderSlipId.HasValue)
                    {
                        <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId.Value" class="modern-btn-secondary">
                            <span class="material-symbols-outlined">arrow_back</span> BACK
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-filterType="@filterType" class="modern-btn-secondary">
                            <span class="material-symbols-outlined">arrow_back</span> BACK
                        </a>
                    }
                </div>
            </div>

            <div class="modern-grid">
                <!-- Left Column: Dispatch Details -->
                <div class="modern-col-4">
                    <div class="modern-card sticky top-24 ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">info</span>
                            <h2 class="modern-headline-md ui-section-title">Dispatch Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body" style="gap: 1.25rem;">
                            <!-- Customer & Vessel -->
                            <div>
                                <p class="modern-label ui-label">Customer</p>
                                <p class="modern-value-lg text-primary" style="font-size: 18px;">@Model.CustomerName</p>

                                <div class="mt-3">
                                    <p class="modern-label ui-label">Vessel</p>
                                    <p class="modern-value-md font-bold uppercase">@Model.VesselName <span class="modern-badge-sm" style="background-color: var(--surface-container-high); text-transform: none; font-weight: 500; margin-left: 4px;">@Model.VesselType</span></p>
                                </div>
                            </div>

                            <!-- Logistics Row -->
                            <div class="modern-grid-compact border-t border-outline-variant pt-3">
                                <div class="modern-col-6">
                                    <p class="modern-label ui-label">COS #</p>
                                    <p class="modern-value-md font-bold">@(Model.COSNumber ?? "-")</p>
                                </div>
                                <div class="modern-col-6">
                                    <p class="modern-label ui-label">Voyage #</p>
                                    <p class="modern-value-md font-bold">@(Model.VoyageNumber ?? "-")</p>
                                </div>
                            </div>

                            <!-- Location -->
                            <div class="border-t border-outline-variant pt-3">
                                <p class="modern-label ui-label">Location</p>
                                <div class="flex items-start gap-2">
                                    <span class="material-symbols-outlined text-primary" style="font-size: 18px; margin-top: 2px;">location_on</span>
                                    <p class="modern-value-md">
                                        <span class="font-bold">@Model.PortName</span><br/>
                                        <span class="text-xs opacity-60">@Model.TerminalName</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Timeline -->
                            <div class="border-t border-outline-variant pt-3">
                                <p class="modern-label mb-3 ui-label">Service Timeline</p>
                                <div class="dispatch-timeline">
                                    <div class="timeline-item">
                                        <div class="timeline-marker start"></div>
                                        <div class="timeline-content">
                                            <p class="text-xs font-bold uppercase opacity-50">Departure</p>
                                            <p class="modern-value-md font-bold">@Model.DateLeft?.ToString("MMM dd, yyyy")</p>
                                            <p class="text-xs opacity-60">@Model.TimeLeft?.ToString("HH:mm")</p>
                                        </div>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="timeline-marker end"></div>
                                        <div class="timeline-content">
                                            <p class="text-xs font-bold uppercase opacity-50">Arrival</p>
                                            <p class="modern-value-md font-bold">@Model.DateArrived?.ToString("MMM dd, yyyy")</p>
                                            <p class="text-xs opacity-60">@Model.TimeArrived?.ToString("HH:mm")</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="timeline-duration">
                                    <div class="duration-box">
                                        <span class="material-symbols-outlined">schedule</span>
                                        <div>
                                            <p class="modern-label ui-label" style="margin-bottom: 0;">Net Duration</p>
                                            <p class="modern-headline-md text-primary ui-section-title" style="font-size: 20px;">@Model.TotalHours?.ToString("N2") <span class="text-xs opacity-60">HRS</span></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Provider -->
                            <div class="border-t border-outline-variant pt-3">
                                <p class="modern-label ui-label">Provider Details</p>
                                <div class="flex items-start gap-2">
                                    <span class="material-symbols-outlined text-primary" style="font-size: 18px; margin-top: 2px;">directions_boat</span>
                                    <div>
                                        <p class="modern-value-md font-bold">@Model.TugboatName</p>
                                        <p class="text-xs italic opacity-60">Master: @Model.TugMasterName</p>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Remarks))
                            {
                                <div class="border-t border-outline-variant pt-3">
                                    <p class="modern-label ui-label">Remarks</p>
                                    <p class="modern-value-md italic opacity-70" style="font-size: 13px;">@Model.Remarks</p>
                                </div>
                            }

                            <!-- Attachments -->
                            <div class="border-t border-outline-variant pt-3">
                                <p class="modern-label mb-2 ui-label">Media Attachments</p>
                                <div class="modern-grid-compact">
                                    @if (!string.IsNullOrEmpty(Model.ImageSignedUrl))
                                    {
                                        <div class="modern-col-12 mb-2">
                                            <div class="modern-card ui-card" style="background-color: var(--surface-container-low); cursor: pointer;" id="viewSidebarImage">
                                                <div class="modern-card-body items-center p-2 ui-card-body" style="gap: 4px;">
                                                    <img src="@Model.ImageSignedUrl" class="rounded" alt="Ticket" style="height: 120px; width: 100%; object-fit: cover;" />
                                                    <span class="text-xs text-primary font-bold">View Image</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.VideoSignedUrl))
                                    {
                                        <div class="modern-col-12">
                                            <div class="modern-card view-video ui-card" style="background-color: var(--surface-container-low); cursor: pointer;" data-videolink="@Model.VideoSignedUrl">
                                                <div class="modern-card-body items-center p-2 ui-card-body" style="gap: 4px;">
                                                    <span class="material-symbols-outlined text-primary" style="font-size: 48px">play_circle</span>
                                                    <span class="text-xs text-primary font-bold">Play Video</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(Model.ImageSignedUrl) && string.IsNullOrEmpty(Model.VideoSignedUrl))
                                    {
                                        <p class="text-sm italic opacity-50 modern-col-12 text-center">No attachments</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Calculation -->
                <div class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">calculate</span>
                            <h2 class="modern-headline-md ui-section-title">Tariff Calculation</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <!-- 1. Dispatch Service -->
                            <div class="mb-3">
                                <h3 class="modern-label font-bold text-xs uppercase opacity-50 border-b border-outline-variant pb-1 mb-2 ui-label">1. Dispatch Service</h3>
                                <div class="modern-grid-compact">
                                    <div class="modern-col-12">
                                        <label class="modern-label mb-1 d-block ui-label">Charge Type</label>
                                        <div class="radio-group" data-tour-step="1">
                                            <input type="radio" class="radio-tab-input" name="chargeType" id="dispatchHour" value="Per hour" @(Model.DispatchChargeType == null || Model.DispatchChargeType == "Per hour" ? "checked" : "")>
                                            <label class="radio-tab-label" for="dispatchHour">Per Hour</label>

                                            <input type="radio" class="radio-tab-input" name="chargeType" id="dispatchMove" value="Per move" @(Model.DispatchChargeType == "Per move" ? "checked" : "")>
                                            <label class="radio-tab-label" for="dispatchMove">Per Move</label>
                                        </div>
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Dispatch Rate</label>
                                        <input asp-for="DispatchRate" id="DispatchRate" step="0.01" type="number" class="modern-input ui-input" placeholder="0.00" value="@Model.DispatchRate?.ToString("0.00")" data-tour-step="2">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Discount (%)</label>
                                        <input asp-for="DispatchDiscount" id="DispatchDiscount" step="0.01" type="number" class="modern-input ui-input" placeholder="0.00" value="@Model.DispatchDiscount?.ToString("0.00")" data-tour-step="3">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Billing Amount</label>
                                        <input asp-for="DispatchBillingAmount" id="DispatchBillingAmount" class="modern-input ui-input" style="background-color: var(--surface-container-low)" readonly placeholder="0.00">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Net Revenue</label>
                                        <input asp-for="DispatchNetRevenue" id="DispatchNetRevenue" class="modern-input font-bold text-success ui-input" style="background-color: var(--surface-container-low)" readonly placeholder="0.00">
                                    </div>
                                </div>
                            </div>

                            <!-- 2. BAF -->
                            <div class="mb-3">
                                <h3 class="modern-label font-bold text-xs uppercase opacity-50 border-b border-outline-variant pb-1 mb-2 ui-label">2. BAF (Bunker Adjustment Factor)</h3>
                                <div class="modern-grid-compact">
                                    <div class="modern-col-12">
                                        <label class="modern-label mb-1 d-block ui-label">Charge Type</label>
                                        <div class="radio-group" data-tour-step="4">
                                            <input type="radio" class="radio-tab-input" name="chargeType2" id="bafHour" value="Per hour" @(Model.BAFChargeType == null || Model.BAFChargeType == "Per hour" ? "checked" : "")>
                                            <label class="radio-tab-label" for="bafHour">Per Hour</label>

                                            <input type="radio" class="radio-tab-input" name="chargeType2" id="bafMove" value="Per move" @(Model.BAFChargeType == "Per move" ? "checked" : "")>
                                            <label class="radio-tab-label" for="bafMove">Per Move</label>
                                        </div>
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">BAF Rate</label>
                                        <input asp-for="BAFRate" id="BAFRate" step="0.01" type="number" class="modern-input ui-input" placeholder="0.00" value="@Model.BAFRate?.ToString("0.00")" data-tour-step="5">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Discount (%)</label>
                                        <input asp-for="BAFDiscount" id="BAFDiscount" step="0.01" type="number" class="modern-input ui-input" placeholder="0.00" value="@Model.BAFDiscount?.ToString("0.00")" data-tour-step="6">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Billing Amount</label>
                                        <input asp-for="BAFBillingAmount" id="BAFBillingAmount" class="modern-input ui-input" style="background-color: var(--surface-container-low)" readonly placeholder="0.00">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label ui-label">Net Revenue</label>
                                        <input asp-for="BAFNetRevenue" id="BAFNetRevenue" class="modern-input font-bold text-success ui-input" style="background-color: var(--surface-container-low)" readonly placeholder="0.00">
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Outsourced -->
                            @if (Model.IsTugboatCompanyOwned == false)
                            {
                                <div class="mb-3">
                                    <h3 class="modern-label font-bold text-xs uppercase text-error border-b border-outline-variant pb-1 mb-2 ui-label">3. Outsourced Tug Details</h3>
                                    <div class="modern-grid-compact">
                                        <div class="modern-col-6">
                                            <label class="modern-label ui-label">Tug Provider</label>
                                            <input class="modern-input ui-input" style="background-color: var(--surface-container-low)" id="TugProvider" value="@Model.TugboatOwnerName" readonly>
                                        </div>
                                        <div class="modern-col-6" data-tour-step="7">
                                            <label class="modern-label ui-label">AP Other Tugs (Expense)</label>
                                            <input asp-for="ApOtherTugs" id="ApOtherTugs" type="number" step="0.01" class="modern-input ui-input" style="border-color: var(--error)" placeholder="0.00" value="@(Model.ApOtherTugs?.ToString("0.00") ?? "0.00")">
                                            <label class="flex items-center gap-2 mt-2">
                                                <input asp-for="ApOtherTugsIncludesVat" type="checkbox">
                                                <span>AP amount includes VAT</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Financial Summary Card -->
                            <div class="financial-summary-card mt-4" data-tour-step="8">
                                <div class="financial-item">
                                    <span class="financial-label">Grand Total Billing</span>
                                    <input asp-for="TotalBilling" id="TotalBilling" class="financial-value primary bg-transparent border-0 w-full p-0 text-center" readonly>
                                </div>
                                <div class="financial-divider"></div>
                                <div class="financial-item">
                                    <span class="financial-label">Net Revenue Realized</span>
                                    <input asp-for="TotalNetRevenue" id="TotalNetRevenue" class="financial-value secondary bg-transparent border-0 w-full p-0 text-center" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { step: 1, title: "Dispatch Charge Type", text: "Choose Per Hour to multiply the dispatch rate by the ticket duration, or Per Move to charge the rate once for the operation. Confirm the charging basis against the agreed tariff.", required: false, autoAdvance: false },
            { step: 2, title: "Dispatch Rate", text: "Enter or review the agreed dispatch rate. A configured customer tariff may supply a default on Set Tariff; check that it applies to this ticket. The billing amount and net revenue are calculated automatically.", required: false, autoAdvance: false },
            { step: 3, title: "Dispatch Discount (%)", text: "Enter the dispatch discount as a percentage, for example 5 for 5%, or use zero when there is no discount. Review the calculated net revenue after applying the discount.", required: false, autoAdvance: false },
            { step: 4, title: "BAF Charge Type", text: "Choose how the Bunker Adjustment Factor is charged. Per Hour uses the ticket duration; Per Move applies the BAF rate once. The BAF charging basis can differ from the dispatch basis.", required: false, autoAdvance: false },
            { step: 5, title: "BAF Rate", text: "Enter or review the agreed BAF rate for this service. Check the calculated BAF billing amount using the selected charging basis; at least one dispatch or BAF rate must be set.", required: false, autoAdvance: false },
            { step: 6, title: "BAF Discount (%)", text: "Enter the BAF discount percentage if applicable, or use zero. This is separate from the dispatch discount; review the BAF net revenue after changing it.", required: false, autoAdvance: false },
            { step: 7, title: "Outsourced Tug Expense", text: "For a tug that is not company-owned, enter the amount payable to its provider in AP Other Tugs. Tick AP amount includes VAT only when the amount you entered already includes VAT; this affects how the expense is reported.", required: false, autoAdvance: false },
            { step: 8, title: "Calculated Totals", text: "Review Grand Total Billing and Net Revenue Realized against the agreed rates, charge types, duration, and discounts. These totals are calculated, so correct the rate or charging basis above if a figure is wrong.", required: false, autoAdvance: false },
            { step: 9, title: "Update Tariff", text: "Review all calculations, then submit and confirm. The ticket is saved as For Approval; tariff entry does not approve the ticket or create its billing statement.", required: false, autoAdvance: false }
        ];
    </script>

    <script>
        const PageConfig = {
            messages: {
                error:   @Json.Serialize(TempData.Peek("error")),
                success: @Json.Serialize(TempData.Peek("success")),
                warning: @Json.Serialize(TempData.Peek("warning"))
            }
        };

        function parseNumber(value) {
            if (!value || value === '') return 0;
            return parseFloat(value.toString().replace(/,/g, '')) || 0;
        }

        function formatNumber(value) {
            return parseFloat(value).toFixed(2);
        }

        $(document).ready(function () {
            const dispatchRateInput = $('#DispatchRate');
            const bafRateInput = $('#BAFRate');
            const dispatchDiscountInput = $('#DispatchDiscount');
            const bafDiscountInput = $('#BAFDiscount');
            const totalHours = Math.round(@(Model.TotalHours ?? 0) * 100) / 100;

            function ValueChange() {
                const dispatchChargeType = $('input[name="chargeType"]:checked').val();
                const bafChargeType = $('input[name="chargeType2"]:checked').val();

                const dispatchRate = parseNumber(dispatchRateInput.val());
                const dispatchDiscountPercent = parseNumber(dispatchDiscountInput.val());
                const dispatchDiscountAmount = dispatchRate * (dispatchDiscountPercent / 100);

                const bafRate = parseNumber(bafRateInput.val());
                const bafDiscountPercent = parseNumber(bafDiscountInput.val());
                const bafDiscountAmount = bafRate * (bafDiscountPercent / 100);

                let dispatchRevenue = 0;
                let dispatchBilling = 0;
                let bafRevenue = 0;
                let bafBilling = 0;

                // Dispatch Calculation
                if (dispatchChargeType === "Per hour") {
                    dispatchBilling = dispatchRate * totalHours;
                    dispatchRevenue = (dispatchRate - dispatchDiscountAmount) * totalHours;
                } else {
                    dispatchBilling = dispatchRate;
                    dispatchRevenue = dispatchRate - dispatchDiscountAmount;
                }

                // BAF Calculation
                if (bafChargeType === "Per hour") {
                    bafBilling = bafRate * totalHours;
                    bafRevenue = (bafRate - bafDiscountAmount) * totalHours;
                } else {
                    bafBilling = bafRate;
                    bafRevenue = bafRate - bafDiscountAmount;
                }

                $('#DispatchBillingAmount').val(formatNumber(dispatchBilling));
                $('#DispatchNetRevenue').val(formatNumber(dispatchRevenue));
                $('#BAFBillingAmount').val(formatNumber(bafBilling));
                $('#BAFNetRevenue').val(formatNumber(bafRevenue));

                const totalBilling = dispatchBilling + bafBilling;
                const totalRevenue = dispatchRevenue + bafRevenue;

                $('#TotalBilling').val(formatNumber(totalBilling));
                $('#TotalNetRevenue').val(formatNumber(totalRevenue));
            }

            // Apply default rates from customer
            function fetchDefaultRates() {
                const customerId = $('#CustomerId').val();
                const dispatchTicketId = $('#DispatchTicketId').val();
                if (!customerId) return;

                $.post('@Url.Action("CheckForTariffRate", "DispatchTicket", new { area = "MSAP" })',
                    {
                        customerId: customerId,
                        dispatchTicketId: dispatchTicketId,
                        __RequestVerificationToken: $('#myForm input[name="__RequestVerificationToken"]').val()
                    },
                    function(result) {
                        if (result.exists) {
                            dispatchRateInput.val(result.dispatch);
                            bafRateInput.val(result.baf);
                            dispatchDiscountInput.val(result.dispatchDiscount);
                            bafDiscountInput.val(result.bafDiscount);

                            ModernAlert.success('Default Rates Applied');
                            ValueChange();
                        }
                    }
                );
            }

            $('input').on('input change', ValueChange);
            ValueChange();
            fetchDefaultRates();

            $('#submitButton').on('click', function (e) {
                e.preventDefault();

                if (!ModernFormValidator.validate('myForm')) return;

                const dispatchRate = parseNumber(dispatchRateInput.val());
                const bafRate = parseNumber(bafRateInput.val());
                if (dispatchRate === 0 && bafRate === 0) {
                    ModernAlert.error("Dispatch or BAF rate must be set.", "Validation Error");
                    return;
                }

                ModernAlert.confirm({
                    title: 'Update Tariff?',
                    text: 'Confirm your changes before updating.',
                    confirmText: 'Yes, Update'
                }).then((result) => {
                    if (result.isConfirmed) {
                        ModernAlert.showLoading("Updating tariff...");
                        document.getElementById("myForm").submit();
                    }
                });
            });

            $('#viewSidebarImage').on('click', function () {
                const src = $(this).find('img').attr('src');
                if (src) ModernAlert.image(src, "Dispatch Ticket");
            });

            // Video Player
            $(document).on("click", ".view-video", function () {
                const videoLink = $(this).data("videolink");
                if (videoLink) ModernAlert.video(videoLink, "Dispatch Ticket Video");
            });
        });
    </script>
}
