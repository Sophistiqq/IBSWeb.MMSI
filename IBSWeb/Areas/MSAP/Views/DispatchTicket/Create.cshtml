@model DispatchTicketViewModel
@inject IBS.Services.MSAP.IRoleService MsapRoleService

@{
    ViewData["Title"] = "Create Dispatch Ticket";
    ViewData["IsFullWidth"] = true;
    var now = DateTimeHelper.GetCurrentPhilippineTime();
    string? userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    string? role = userId is not null ? await MsapRoleService.GetUserRoleAsync(userId) : null;
    bool isAdmin = role is MsapRoles.Admin or MsapRoles.SuperAdmin;
}

<div class="modern-layout app-ui">
    <form id="myForm" method="post" enctype="multipart/form-data">
        <input asp-for="CustomerOrderSlipId" type="hidden">
        <input asp-for="VesselScheduleServiceEntryId" type="hidden">
        <main class="modern-container ui-page">
            <!-- Header -->
            <div class="flex-stack ui-page-toolbar">
                <div>
                    <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li><a asp-action="Index">Dispatch Tickets</a></li><li aria-current="page">New Ticket</li></ol></nav>
                    <h1 class="modern-headline-lg ui-page-title" data-page-header>Create Dispatch Ticket</h1>
                </div>
                <div class="flex gap-2 ui-actions" data-tour-step="16">
                    <button type="submit" class="modern-btn-primary" id="submitButton">
                        <span class="material-symbols-outlined">save</span> SAVE TICKET
                    </button>
                    @if (Model.CustomerOrderSlipId.HasValue)
                    {
                        <a asp-controller="CustomerOrderSlip" asp-action="Details" asp-route-id="@Model.CustomerOrderSlipId.Value" class="modern-btn-secondary" data-ui-back>
                            <span class="material-symbols-outlined">arrow_back</span> Back
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="modern-btn-secondary" data-ui-back>
                            <span class="material-symbols-outlined">arrow_back</span> Back
                        </a>
                    }
                </div>
            </div>

            <div class="modern-grid">
                <!-- Left Column: Reference and Service Info -->
                <div class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <!-- I. Reference Information -->
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">info</span>
                            <h2 class="modern-headline-md ui-section-title">Reference Information</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            <div class="modern-grid-compact">
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">@(Model.VesselScheduleServiceEntryId.HasValue ? "Ticket date" : "Date Today") <span class="text-error">*</span></label>
                                    <input asp-for="Date" type="date" value="@(Model.Date == default ? now.ToString("yyyy-MM-dd") : Model.Date.ToString("yyyy-MM-dd"))" class="modern-input ui-input" data-tour-step="1">
                                    <span asp-validation-for="Date" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Dispatch/Mooring # <span class="text-error">*</span></label>
                                    <input asp-for="DispatchNumber" class="modern-input ui-input" placeholder="Enter Dispatch #" maxlength="20" required data-tour-step="2">
                                    <span asp-validation-for="DispatchNumber" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">COS #</label>
                                    @if (Model.CustomerOrderSlipId.HasValue)
                                    {
                                        <input type="text" class="modern-input ui-input" style="background-color: var(--surface-container-low)" value="@(Model.COSNumber ?? "-")" readonly data-tour-step="3">
                                        <input type="hidden" asp-for="COSNumber" />
                                    }
                                    else
                                    {
                                        <input asp-for="COSNumber" class="modern-input ui-input" placeholder="Optional" maxlength="10" data-tour-step="3">
                                    }
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Voyage #</label>
                                    @if (Model.CustomerOrderSlipId.HasValue)
                                    {
                                        <input type="text" class="modern-input ui-input" style="background-color: var(--surface-container-low)" value="@(Model.VoyageNumber ?? "-")" readonly data-tour-step="4">
                                        <input type="hidden" asp-for="VoyageNumber" />
                                    }
                                    else
                                    {
                                        <input asp-for="VoyageNumber" class="modern-input ui-input" placeholder="Optional" maxlength="20" data-tour-step="4">
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- II. Service Details -->
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header">
                            <span class="material-symbols-outlined">anchor</span>
                            <h2 class="modern-headline-md ui-section-title">Service Details</h2>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div class="mb-2">
                                <label class="modern-label ui-label">Customer <span class="text-error">*</span></label>
                                @if (Model.CustomerOrderSlipId.HasValue)
                                {
                                    <input type="text" class="modern-input ui-input" style="background-color: var(--surface-container-low)" value="@(Model.Customers?.FirstOrDefault(c => c.Value == Model.CustomerId.ToString())?.Text ?? "Selected Customer")" readonly data-tour-step="5">
                                    <input type="hidden" asp-for="CustomerId" />
                                }
                                else
                                {
                                    <div id="CustomerContainer" data-tour-step="5">
                                        <select id="CustomerId" asp-for="CustomerId" asp-items="@Model.Customers" class="js-modern-select" data-placeholder="-- Select Customer --" required>
                                            <option value="">-- Select Customer --</option>
                                        </select>
                                    </div>
                                }
                            </div>
                            <div class="modern-grid-compact mt-2">
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Port <span class="text-error">*</span></label>
                                    @if (Model.CustomerOrderSlipId.HasValue)
                                    {
                                        <input type="text" class="modern-input ui-input" style="background-color: var(--surface-container-low)" value="@(Model.Ports?.FirstOrDefault(p => p.Value == Model.PortId.ToString())?.Text ?? "Selected Port")" readonly data-tour-step="6">
                                        <input type="hidden" asp-for="PortId" />
                                    }
                                    else
                                    {
                                        <div id="PortContainer" data-tour-step="6">
                                            <select asp-for="PortId" id="PortSelect" asp-items="@Model.Ports" class="js-modern-select" data-placeholder="-- Select Port --" required>
                                                <option value="">-- Select Port --</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Terminal <span class="text-error">*</span> <span id="terminalLoading" class="spinner-border spinner-border-sm text-secondary ms-1" style="display:none;" role="status"></span></label>
                                    @if (Model.CustomerOrderSlipId.HasValue)
                                    {
                                        <input type="text" class="modern-input ui-input" style="background-color: var(--surface-container-low)" value="@(Model.Terminals?.FirstOrDefault(t => t.Value == Model.TerminalId.ToString())?.Text ?? "Selected Terminal")" readonly data-tour-step="7">
                                        <input type="hidden" asp-for="TerminalId" />
                                    }
                                    else
                                    {
                                        <div id="TerminalContainer" data-tour-step="7">
                                            <select id="TerminalSelect" asp-items="@Model.Terminals" asp-for="TerminalId" class="js-modern-select" data-placeholder="-- Select Terminal --" required>
                                                <option value="">-- Select Terminal --</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Vessel <span class="text-error">*</span></label>
                                    @if (Model.CustomerOrderSlipId.HasValue)
                                    {
                                        <input type="text" class="modern-input ui-input" style="background-color: var(--surface-container-low)" value="@(Model.Vessels?.FirstOrDefault(v => v.Value == Model.VesselId.ToString())?.Text ?? "Selected Vessel")" readonly data-tour-step="8">
                                        <input type="hidden" asp-for="VesselId" />
                                    }
                                    else
                                    {
                                        <div id="VesselContainer" data-tour-step="8">
                                            <select asp-for="VesselId" asp-items="@Model.Vessels" class="js-modern-select" data-placeholder="-- Select Vessel --" required>
                                                <option value="">-- Select Vessel --</option>
                                            </select>
                                        </div>
                                    }
                                    <input type="hidden" asp-for="VoyageType" id="VoyageType" />
                                    <span id="voyageTypeBadge" class="modern-badge-sm mt-1" style="display:none"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Activity/Service Type <span class="text-error">*</span></label>
                                    <div id="ServiceContainer" data-tour-step="9">
                                        @if (Model.VesselScheduleServiceEntryId.HasValue)
                                        {
                                            <input type="hidden" name="ServiceId" value="@Model.ServiceId" />
                                            <input class="modern-input ui-input" value="@(Model.Services?.FirstOrDefault(item => item.Value == Model.ServiceId.ToString())?.Text)" readonly aria-label="Approved service" />
                                        }
                                        else
                                        {
                                            <select asp-for="ServiceId" asp-items="@Model.Services" class="js-modern-select" data-placeholder="-- Select Service --" required>
                                            <option value="">-- Select Service --</option>
                                        </select>
                                        }
                                    </div>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Tugboat/Service provider <span class="text-error">*</span></label>
                                    <div id="TugboatContainer" data-tour-step="10">
                                        @if (Model.VesselScheduleServiceEntryId.HasValue)
                                        {
                                            <input type="hidden" name="TugBoatId" value="@Model.TugBoatId" />
                                            <input class="modern-input ui-input" value="@(Model.Tugboats?.FirstOrDefault(item => item.Value == Model.TugBoatId.ToString())?.Text)" readonly aria-label="Approved tugboat" />
                                        }
                                        else
                                        {
                                            <select asp-for="TugBoatId" asp-items="@Model.Tugboats" class="js-modern-select" data-placeholder="-- Select Tugboat --" required>
                                            <option value="">-- Select Tugboat --</option>
                                        </select>
                                        }
                                    </div>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label ui-label">Master on Duty <span class="text-error">*</span></label>
                                    <div id="TugMasterContainer" data-tour-step="11">
                                        <select asp-for="TugMasterId" asp-items="@Model.TugMasters" class="js-modern-select" data-placeholder="-- Select Tug Master --" required>
                                            <option value="">-- Select Tug Master --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- IV. Remarks -->
                    <div class="modern-card ui-card" style="flex: 1;">
                        <div class="modern-card-header-info ui-card-header" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">chat</span>
                            <h2 class="modern-headline-md ui-section-title">Remarks</h2>
                        </div>
                        <div class="modern-card-body ui-card-body" style="height: 100%;" data-tour-step="15">
                            <textarea asp-for="Remarks" class="modern-input ui-input" placeholder="Enter remarks (Optional)" style="height: 100%; min-height: 120px;"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Timeline and Media -->
                <div class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                    <!-- Timeline & Duration -->
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header" style="background-color: var(--primary); color: white;">
                            <span class="material-symbols-outlined">schedule</span>
                            <div class="flex justify-content-between w-full gap-2">
                                <h2 class="modern-headline-md ui-section-title" style="color: white">Timeline</h2>
                                <span id="durationBadge" class="modern-badge" style="background: white; color: var(--primary);">0.00 hrs</span>
                            </div>
                        </div>
                        <div class="modern-card-body ui-card-body">
                            <div>
                                <div class="mb-2" data-tour-step="12">
                                    <label class="modern-label font-bold ui-label">Start Date & Time <span class="text-error">*</span></label>
                                    <div class="flex gap-2 mt-1">
                                        <input type="date" asp-for="DateLeft" id="DateLeft" value="@(Model.DateLeft?.ToString("yyyy-MM-dd") ?? now.ToString("yyyy-MM-dd"))" class="modern-input timeline-input ui-input" required>
                                        <input type="time" asp-for="TimeLeft" id="TimeLeft" value="@(Model.TimeLeft?.ToString("HH:mm") ?? now.ToString("HH:mm"))" class="modern-input timeline-input ui-input" required>
                                    </div>
                                </div>
                                <div data-tour-step="13">
                                    <label class="modern-label font-bold ui-label">End Date & Time <span class="text-error">*</span></label>
                                    <div class="flex gap-2 mt-1">
                                        <input type="date" asp-for="DateArrived" id="DateArrived" value="@(Model.DateArrived?.ToString("yyyy-MM-dd") ?? now.ToString("yyyy-MM-dd"))" class="modern-input timeline-input ui-input" required>
                                        <input type="time" asp-for="TimeArrived" id="TimeArrived" value="@(Model.TimeArrived?.ToString("HH:mm") ?? now.ToString("HH:mm"))" class="modern-input timeline-input ui-input" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Media Uploads -->
                    <div class="modern-card ui-card">
                        <div class="modern-card-header-info ui-card-header" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">camera</span>
                            <h2 class="modern-headline-md ui-section-title">Media Attachments</h2>
                        </div>
                        <div class="modern-card-body ui-card-body" data-tour-step="14">
                            <div>
                                <div class="mb-4">
                                    <div class="flex justify-between items-center mb-1">
                                        <label class="modern-label ui-label">
                                            Dispatch Ticket Image
                                            @if (!isAdmin)
                                            {
                                                <span class="text-error" title="Required">*</span>
                                            }
                                        </label>
                                        <button type="button" id="btnPreviewImage" class="modern-btn-text text-xs" style="display:none;">
                                            <span class="material-symbols-outlined text-sm">visibility</span> PREVIEW
                                        </button>
                                    </div>
                                    <input class="modern-input ui-input" id="imageUpload" name="imageFile" type="file" accept="image/*" style="padding: 0.35rem;"
                                           @(isAdmin ? "" : "required")>
                                </div>
                                <div>
                                    <div class="flex justify-between items-center mb-1">
                                        <label class="modern-label ui-label">Operation Video</label>
                                        <button type="button" id="btnPreviewVideo" class="modern-btn-text text-xs" style="display:none;">
                                            <span class="material-symbols-outlined text-sm">visibility</span> PREVIEW
                                        </button>
                                    </div>
                                    <input class="modern-input ui-input" id="videoUpload" name="videoFile" type="file" accept="video/*" style="padding: 0.35rem;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        window.IBS_TOUR_STEPS = [
            { step: 1, title: "Dispatch Date", text: "Set the date this dispatch ticket is recorded under. Check it against the supporting ticket; the actual start and end of service are entered separately in the timeline.", required: false, autoAdvance: false },
            { step: 2, title: "Dispatch/Mooring Number", text: "Enter the number shown on the dispatch or mooring ticket, up to 20 characters. Check the reference carefully so the service can be traced during pricing, billing, and collection.", required: true, autoAdvance: true },
            { step: 3, title: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "COS Reference from COS" : "COS Reference (Optional)"), text: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "This COS reference is prefilled from the COS and is locked on this ticket. Review it against the supporting document. If it needs correction, update the COS. Click Next to continue." : "Enter the COS reference from the supporting document if available, or leave it blank. For a ticket linked to a COS, this reference is inherited and is changed through the COS."), required: false, autoAdvance: false },
            { step: 4, title: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "Voyage Reference from COS" : "Voyage Reference (Optional)"), text: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "This voyage reference is prefilled from the COS and is locked here. It identifies the vessel visit for this service. Correct it through the COS if needed, then click Next." : "Enter the voyage reference for this vessel visit if available. For COS tickets, the voyage reference comes from the COS and is read-only here."), required: false, autoAdvance: false },
            { step: 5, title: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "Customer from COS" : "Customer"), text: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "This customer is prefilled from the COS. You do not need to select it again, and it cannot be changed on this ticket. Review the name, then click Next." : "Select the customer receiving the service. For a COS ticket, the customer is inherited from the order; review the order if that customer needs to change."), required: false, autoAdvance: false },
            { step: 6, title: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "Port from COS" : "Port"), text: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "This port is prefilled from the COS and is locked here. Check that it matches the service location. Change the COS if the location needs correction, then click Next." : "Select the port where the operation took place. Changing the port reloads its terminals, so check the terminal selection again before saving."), required: false, autoAdvance: false },
            { step: 7, title: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "Terminal from COS" : "Terminal"), text: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "This terminal is prefilled from the COS and is locked here. Review it with the port to confirm the service location, then click Next." : "Select the terminal for the operation from the chosen port. Match the location to the supporting ticket; COS tickets use the location recorded on the order."), required: false, autoAdvance: false },
            { step: 8, title: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "Vessel from COS" : "Vessel"), text: @Json.Serialize(Model.CustomerOrderSlipId.HasValue ? "This vessel is prefilled from the COS and is locked here. Confirm the vessel name, then click Next to choose the Activity / Service Type for this ticket." : "Select the vessel that received the service. Check the vessel name against the ticket and voyage reference; COS tickets inherit the vessel from the order."), required: false, autoAdvance: false },
            { step: 9, title: "Activity / Service Type", text: "Choose the activity actually performed, such as the applicable dispatch or mooring service. This identifies the service to be priced, so match the selection to the supporting ticket.", required: true, autoAdvance: true },
            { step: 10, title: "Tugboat / Service Provider", text: "Choose the tugboat that performed this service. Check the exact tug name, especially for outsourced services, because ownership affects the expense information entered during tariff setting.", required: true, autoAdvance: true },
            { step: 11, title: "Master on Duty", text: "Select the tug master responsible for this operation. Use the master recorded on the supporting dispatch ticket rather than the person entering the record.", required: true, autoAdvance: true },
            { step: 12, title: "Actual Start Date & Time", text: "Enter when the operation actually started. Complete both the date and time; these values are used with the end time to calculate the service duration.", required: false, autoAdvance: false },
            { step: 13, title: "Actual End Date & Time", text: "Enter when the operation ended, using a later date for overnight service. Check the duration badge after entering both times; the service uses a minimum chargeable duration of one hour.", required: false, autoAdvance: false },
            { step: 14, title: "Media Attachments", text: "Attach a clear image of the supporting dispatch ticket; the image is required for users outside the Admin role. An operation video is optional. Use Preview to check that the chosen files belong to this service.", required: false, autoAdvance: false },
            { step: 15, title: "Remarks (Optional)", text: "Record operational notes or special circumstances that help explain this service. Leave this blank if there are no additional details.", required: false, autoAdvance: false },
            { step: 16, title: "Save Ticket", text: "Review the references, service, tug, master, timeline, and attachments, then click SAVE TICKET and confirm. The saved ticket starts at For Tariff, where its service charges are entered.", required: false, autoAdvance: false }
        ];
    </script>


    <script>
        $(document).ready(function () {
            // --- Vessel → VoyageType auto-set ---
            function updateVoyageType() {
                const vesselId = $('#VesselId').val();
                if (!vesselId) { $('#voyageTypeBadge').hide(); return; }
                $.get('@Url.Action("GetVesselVoyageType", "DispatchTicket")', { vesselId: vesselId })
                    .done(function (data) {
                        $('#VoyageType').val(data);
                        const $badge = $('#voyageTypeBadge');
                        $badge.text(data).show();
                        $badge.removeClass('bg-warning text-white bg-info text-white')
                              .addClass(data === 'Foreign' ? 'bg-warning text-white' : 'bg-info text-white');
                    });
            }
            $('#VesselId').on('change', updateVoyageType);
            if ($('#VesselId').val()) { updateVoyageType(); }

            // Port/Terminal Cascading Dropdown (only binds if PortSelect exists — absent when JO locks it)
            if ($('#PortSelect').length) {
                $('#PortSelect').on('change', function () {
                    const portId = $(this).val();
                    if (!portId) return;

                    $('#terminalLoading').show();
                    $.get('@Url.Action("ChangeTerminal", "DispatchTicket")', { portId: portId }, function (data) {
                        const $select = $('#TerminalSelect');
                        $select.empty().append('<option value="">-- Select Terminal --</option>');
                        $.each(data, function (i, item) {
                            $select.append($('<option>', { value: item.value, text: item.text }));
                        });

                        if (typeof refreshModernSelect === 'function') {
                            refreshModernSelect($select);
                        }
                    }).always(() => $('#terminalLoading').hide());
                });
            }

            // Duration Calculation
            function calculateDuration() {
                const startD = $('#DateLeft').val();
                const startT = $('#TimeLeft').val();
                const endD = $('#DateArrived').val();
                const endT = $('#TimeArrived').val();

                if (startD && startT && endD && endT) {
                    const start = new Date(`${startD}T${startT}`);
                    const end = new Date(`${endD}T${endT}`);
                    if (!isNaN(start) && !isNaN(end)) {
                        const diff = (end - start) / 3600000;
                        const $badge = $('#durationBadge');
                        if (diff < 0) {
                            $badge.text("Invalid").css({'background': 'var(--error)', 'color': 'white'});
                        } else {
                            $badge.text(diff.toFixed(2) + " hrs").css({'background': 'white', 'color': 'var(--primary)'});
                        }
                    }
                }
            }
            $('.timeline-input').on('change input', calculateDuration);
            calculateDuration();

            // Media Preview Logic
            let imageBlobUrl = null;
            let videoBlobUrl = null;

            $('#imageUpload').on('change', function() {
                const file = this.files[0];
                if (file) {
                    if (imageBlobUrl) URL.revokeObjectURL(imageBlobUrl);
                    imageBlobUrl = URL.createObjectURL(file);
                    $('#btnPreviewImage').show();
                } else {
                    $('#btnPreviewImage').hide();
                }
            });

            $('#videoUpload').on('change', function() {
                const file = this.files[0];
                if (file) {
                    if (videoBlobUrl) URL.revokeObjectURL(videoBlobUrl);
                    videoBlobUrl = URL.createObjectURL(file);
                    $('#btnPreviewVideo').show();
                } else {
                    $('#btnPreviewVideo').hide();
                }
            });

            $('#btnPreviewImage').on('click', function() {
                if (imageBlobUrl) {
                    ModernAlert.image(imageBlobUrl, "Dispatch Ticket Image Preview");
                }
            });

            $('#btnPreviewVideo').on('click', function() {
                if (videoBlobUrl) {
                    ModernAlert.video(videoBlobUrl, "Operation Video Preview");
                }
            });
        });
    </script>
}
