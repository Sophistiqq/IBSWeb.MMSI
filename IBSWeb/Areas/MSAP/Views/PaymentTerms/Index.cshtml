@{
    ViewData["Title"] = "Payment Terms";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout app-ui">
    <main class="modern-container ui-page">
        <div class="flex-stack ui-page-toolbar">
            <div>
                <nav aria-label="Breadcrumb"><ol class="ui-breadcrumb"><li>MSAP</li><li aria-current="page">Payment Terms</li></ol></nav>
                <h1 class="modern-headline-lg ui-page-title">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2 ui-actions">
                <a asp-action="Create" class="modern-btn-primary ui-page-action">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <div class="modern-card ui-card">
            <div class="modern-card-header-action flex justify-between items-center w-full ui-card-header">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">payments</span>
                    <h2 class="modern-headline-md ui-section-title">Terms List</h2>
                </div>
            </div>
            <div class="modern-card-body ui-card-body">
                <table class="modern-table ui-table" id="paginatedTable">
                    <thead>
                        <tr>
                            <th>Terms Code</th>
                            <th>Days</th>
                            <th>Months</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

<form id="deleteForm" method="post" asp-antiforgery="false" hidden>@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "PaymentTerms", new { area = "MSAP" })';
            const deleteUrl = '@Url.Action("Delete", "PaymentTerms", new { area = "MSAP" })';

            $('#paginatedTable').DataTable(ModernTable.config({
                order: [[0, 'asc']],
                ajax: $.extend(ModernTable.ajax("@Url.Action("GetPaymentTerms", "PaymentTerms", new { area = "MSAP" })"), {
                    error: function () {
                        ModernAlert.error('An error occurred while loading the data.');
                    }
                }),
                columns: [
                    {
                        data: "termsCode",
                        render: (data, type) => type === 'display'
                            ? `<span class="font-bold uppercase">${ModernTable.render.text(data)}</span>`
                            : data
                    },
                    { data: "numberOfDays", render: ModernTable.render.text },
                    { data: "numberOfMonths", render: ModernTable.render.text },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => {
                            const encoded = encodeURIComponent(row.termsCode || '');
                            return ModernTable.render.dropdown([
                                { label: 'Edit Term', icon: 'edit', url: `${editUrl}?id=${encoded}` },
                                {
                                    label: 'Delete Term',
                                    icon: 'delete',
                                    isError: true,
                                    onclick: `confirmDelete('${deleteUrl}?id=${encoded}', '${encoded}')`
                                }
                            ]);
                        }
                    }
                ]
            }));
        });

        function confirmDelete(url, encodedCode) {
            const code = decodeURIComponent(encodedCode || '');
            ModernAlert.confirm({
                title: 'Delete Payment Term?',
                text: `Are you sure you want to delete payment term "${code}"?`,
                icon: 'warning',
                confirmText: 'Yes, Delete',
                cancelText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('deleteForm');
                    form.action = url;
                    form.submit();
                }
            });
        }
    </script>
}
